Notebook[{
Cell["xPlorer — Consolidated Beta 13","Title"],
Cell["One abstract theory, several independent geometries","Subtitle"],
Cell["Run from top to bottom in a fresh kernel. xAct must be installed. The notebook uses the source beside this file; if installed as a paclet, replace the first input with Needs[\"xPlorer`\"]. No output cells are precomputed. Cells beginning with check_ evaluate to True when the mathematical or lifecycle assertion passes.","Text"],
Cell["1. Define and register the abstract theory","Section"],
Cell[BoxData["Get[FileNameJoin[{NotebookDirectory[],\"Paclet\",\"xPlorer.wl\"}]];"],"Input",CellTags->"load"],
Cell[BoxData["$XPlorerVersion"],"Input",CellTags->"version"],
Cell[BoxData["DefManifold[MN,4,{a,b,c,d,e,f,i,j}];"],"Input",CellTags->"manifold"],
Cell[BoxData["DefMetric[-1,g[-a,-b],CD];"],"Input",CellTags->"metric"],
Cell[BoxData["DefTensor[phi[],MN]; DefTensor[A[-a],MN]; DefTensor[F[-a,-b],MN,Antisymmetric[{-a,-b}]]; DefMetricPerturbation[g,h,eps];"],"Input",CellTags->"fields"],
Cell[BoxData["DefConstantSymbol[mass]; DefConstantSymbol[Mbh]; DefScalarFunction[scale];"],"Input",CellTags->"parameters"],
Cell[BoxData["DefCovD[DA[-a],{},Torsion->True];"],"Input",CellTags->"connection"],
Cell[BoxData["RegisterTheory[\"Title\",\"Massive scalar field and test tensors\"]; RegisterTheory[\"Metric\",g]; RegisterTheory[\"CovD\",CD]; RegisterTheory[\"Indices\",{a,b,c,d,e,f,i,j}];"],"Input",CellTags->"register_geometry"],
Cell[BoxData["RegisterTheory[\"Fields\",{phi,A,{F,Sector->\"EM\"},h}]; RegisterTheory[\"Parameters\",{mass,Mbh}]; RegisterTheory[\"Connection\",\"Affine\",DA];"],"Input",CellTags->"register_fields"],
Cell[BoxData["Lkin=-CD[-a][phi[]] CD[a][phi[]]/2; Lmass=-mass^2 phi[]^2/2; Lmatter=Lkin+Lmass"],"Input",CellTags->"lagrangian"],
Cell[BoxData["RegisterTheory[\"Lagrangians\",{\"Kinetic\"->Lkin,\"MassTerm\"->Lmass,\"Matter\"->Lmatter}];"],"Input",CellTags->"register_lagrangians"],
Cell[BoxData["kg=ToCanonical[ContractMetric[VarD[phi[],CD][Lmatter]]]"],"Input",CellTags->"kg"],
Cell[BoxData["RegisterTheory[\"Expressions\",\"KG\"->kg];"],"Input",CellTags->"register_kg"],
Cell[BoxData["ShowTheory[]"],"Input",CellTags->"theory"],
Cell["2. Schwarzschild: native coordinate and component syntax","Section"],
Cell["Coordinates are declared as scalar expressions. The actual coordinate heads and copied abstract indices are exposed through suffixed aliases.","Text"],
Cell[BoxData["CreateBackground[\"Schwarzschild\",SymbolSuffix->\"Schw\"];"],"Input",CellTags->"schw_background"],
Cell[BoxData["DefineChart[\"Schwarzschild\",{t[],r[],theta[],varphi[]}];"],"Input",CellTags->"schw_chart"],
Cell[BoxData["rSchw[]===ScalarsOfChart[chartSchw][[2]]"],"Input",CellTags->"check_schw_alias"],
Cell[BoxData["fSchw=1-2 Mbh/rSchw[]; matS=DiagonalMatrix[{-fSchw,1/fSchw,rSchw[]^2,rSchw[]^2 Sin[thetaSchw[]]^2}]; MetricInBasis[gSchw,-chartSchw,matS];"],"Input",CellTags->"schw_metric"],
Cell[BoxData["ComponentValue[phiSchw[],rSchw[]^2]; AllComponentValues[ASchw[{-aSchw,-chartSchw}],{1,2,3,4}];"],"Input",CellTags->"schw_field"],
Cell[BoxData["MetricCompute[gSchw,chartSchw,\"RicciScalar\"[]];"],"Input",CellTags->"schw_native_geometry"],
Cell[BoxData["ToComponents[RicciScalar[CDSchw][]]"],"Input",CellTags->"schw_ricci"],
Cell[BoxData["ToComponents[RicciScalar[CDSchw][]]===0"],"Input",CellTags->"check_schw_ricci"],
Cell[BoxData["ToComponents[kgSchw]"],"Input",CellTags->"schw_kg"],
Cell[BoxData["Simplify[ToComponents[kgSchw]-(6-8 Mbh/rSchw[]-mass^2 rSchw[]^2)]===0"],"Input",CellTags->"check_schw_kg"],
Cell[BoxData["ASchw[-aSchw]//ToCTensor"],"Input",CellTags->"schw_vector"],
Cell[BoxData["(ASchw[-aSchw]//ToCTensor)===CTensor[{1,2,3,4},{-chartSchw}]"],"Input",CellTags->"check_schw_vector"],
Cell["3. FLRW: reuse exactly the same abstract expression","Section"],
Cell[BoxData["CreateBackground[\"FLRW\"]; DefineChart[\"FLRW\",{t[],x[],y[],z[]}];"],"Input",CellTags->"flrw_background"],
Cell[BoxData["MetricInBasis[gFLRW,-chartFLRW,DiagonalMatrix[{-1,scale[tFLRW[]]^2,scale[tFLRW[]]^2,scale[tFLRW[]]^2}]];"],"Input",CellTags->"flrw_metric"],
Cell[BoxData["ComponentValue[phiFLRW[],tFLRW[]^2];"],"Input",CellTags->"flrw_scalar"],
Cell[BoxData["ToComponents[kgFLRW]"],"Input",CellTags->"flrw_kg"],
Cell[BoxData["Simplify[ToComponents[kgFLRW]+2+mass^2 tFLRW[]^2+6 tFLRW[] scale'[tFLRW[]]/scale[tFLRW[]]]===0"],"Input",CellTags->"check_flrw_kg"],
Cell[BoxData["ToComponents[RicciScalar[CDFLRW][]]"],"Input",CellTags->"flrw_curvature"],
Cell[BoxData["Simplify[ToComponents[RicciScalar[CDFLRW][]]-6 (scale'[tFLRW[]]^2+scale[tFLRW[]] scale''[tFLRW[]])/scale[tFLRW[]]^2]===0"],"Input",CellTags->"check_flrw_curvature"],
Cell[BoxData["ToComponents[phiSchw[]]===rSchw[]^2"],"Input",CellTags->"check_schw_isolated"],
Cell["4. Change charts without re-registering the theory","Section"],
Cell["The coordinate map gives the primary coordinates as functions of the new coordinates. xCoba changes tensor slots; xPlorer also substitutes the scalar coordinate map. For a connection, an additional Hessian term is required.","Text"],
Cell[BoxData["DefineChart[\"Schwarzschild\",\"Scaled\",{T[],u[],th[],p[]},Function[{tt,uu,hh,pp},{tt,2 uu,hh,pp}]];"],"Input",CellTags->"scaled_chart"],
Cell[BoxData["ToCTensor[CTensor[{1,2,3,4},{-chartSchw}],{-chartScaledSchw}]"],"Input",CellTags->"scaled_native"],
Cell[BoxData["ToCTensor[CTensor[{1,2,3,4},{-chartSchw}],{-chartScaledSchw}]===CTensor[{1,4,3,4},{-chartScaledSchw}]"],"Input",CellTags->"check_scaled_native"],
Cell[BoxData["ToComponents[\"Schwarzschild\",CD[-a][phi[]],OutputChart->\"Scaled\"]"],"Input",CellTags->"scaled_gradient"],
Cell[BoxData["Simplify[ToComponents[\"Schwarzschild\",CD[-a][phi[]],OutputChart->\"Scaled\"]-{0,8 uScaledSchw[],0,0}]==={0,0,0,0}"],"Input",CellTags->"check_scaled_gradient"],
Cell[BoxData["ToComponents[\"Schwarzschild\",\"KG\",OutputChart->\"Scaled\"]"],"Input",CellTags->"scaled_kg"],
Cell[BoxData["Simplify[ToComponents[\"Schwarzschild\",\"KG\",OutputChart->\"Scaled\"]-(6-4 Mbh/uScaledSchw[]-4 mass^2 uScaledSchw[]^2)]===0"],"Input",CellTags->"check_scaled_kg"],
Cell[BoxData["CreateBackground[\"Flat\"]; DefineChart[\"Flat\",{t[],x[],y[],z[]}]; MetricInBasis[gFlat,-chartFlat,DiagonalMatrix[{-1,1,1,1}]]; DefineChart[\"Flat\",\"Quadratic\",{T[],u[],v[],w[]},Function[{tt,uu,vv,ww},{tt,uu^2,vv,ww}]];"],"Input",CellTags->"nonlinear_chart"],
Cell[BoxData["SetConnectionComponents[\"Flat\",\"Affine\",ConstantArray[0,{4,4,4}]];"],"Input",CellTags->"affine_input"],
Cell[BoxData["ConnectionMatrixOf[\"Flat\",\"Affine\",OutputChart->\"Quadratic\"][[2,2,2]]"],"Input",CellTags->"affine_gamma"],
Cell[BoxData["Simplify[ConnectionMatrixOf[\"Flat\",\"Affine\",OutputChart->\"Quadratic\"][[2,2,2]]-1/uQuadraticFlat[]]===0"],"Input",CellTags->"check_affine_gamma"],
Cell["5. Native partial inputs and named field profiles","Section"],
Cell["Sparse field entries remain unknown until assigned; unassigned components are not assumed to be zero. The primary metric and field inputs are managed, and native edits invalidate mathematical results.","Text"],
Cell[BoxData["ComponentValue[FSchw[{1,-chartSchw},{0,-chartSchw}],3];"],"Input",CellTags->"sparse_f"],
Cell[BoxData["ToValues[FSchw[{0,-chartSchw},{1,-chartSchw}]]===-3"],"Input",CellTags->"check_sparse_antisym"],
Cell[BoxData["RegisterProfile[\"Schwarzschild\",\"Original\"]; RegisterProfile[\"Schwarzschild\",\"Linear\",phi,rSchw[]];"],"Input",CellTags->"profile_register"],
Cell[BoxData["ActivateProfile[\"Schwarzschild\",\"Linear\"];"],"Input",CellTags->"profile_activate"],
Cell[BoxData["Simplify[ToComponents[kgSchw]-(2/rSchw[]-2 Mbh/rSchw[]^2-mass^2 rSchw[])]===0"],"Input",CellTags->"check_profile_kg"],
Cell[BoxData["ActivateProfile[\"Schwarzschild\",\"Original\"];"],"Input",CellTags->"profile_restore"],
Cell[BoxData["ToComponents[phiSchw[]]===rSchw[]^2"],"Input",CellTags->"check_profile_restore"],
Cell["6. Rule groups, invalidation and reconstruction","Section"],
Cell[BoxData["AddRules[\"Schwarzschild\",{Mbh->7}]; SetRuleGroup[\"Schwarzschild\",\"Massless\",{mass->0}]; SetRuleGroup[\"Schwarzschild\",\"Massive\",{mass->2}]; ActivateRuleGroups[\"Schwarzschild\",{\"Massive\",\"Massless\"}];"],"Input",CellTags->"rules"],
Cell[BoxData["ShowRuleGroups[\"Schwarzschild\",\"Status\"]"],"Input",CellTags->"rule_status"],
Cell[BoxData["ShowRules[\"Schwarzschild\"]==={mass->2,mass->0,Mbh->7}"],"Input",CellTags->"check_rules"],
Cell[BoxData["SaveResult[\"Schwarzschild\",\"cached\",ToComponents[kgSchw]]; DeactivateRuleGroups[\"Schwarzschild\",{\"Massive\"}];"],"Input",CellTags->"deactivate"],
Cell[BoxData["FailureQ[ResultOf[\"Schwarzschild\",\"cached\"]]"],"Input",CellTags->"check_invalidation"],
Cell[BoxData["ShowRules[\"Schwarzschild\"]==={mass->0,Mbh->7}"],"Input",CellTags->"check_independent"],
Cell[BoxData["recipe=ReconstructionData[\"Schwarzschild\"]; RecreateBackground[\"Copy\",recipe];"],"Input",CellTags->"recipe"],
Cell[BoxData["ShowRules[\"Copy\"]==={mass->0,Mbh->7} && ToComponents[phiCopy[]]===rCopy[]^2"],"Input",CellTags->"check_recipe"],
Cell[BoxData["ShowBackground[\"Copy\",\"Summary\"]"],"Input",CellTags->"inspect"],
Cell["7. Lifecycle: safe deletion","Section"],
Cell["A managed chart cannot be removed behind the registry. Deleting its chart family or entire background is explicit. External xAct dependents remain protected.","Text"],
Cell[BoxData["FailureQ[UndefChart[chartScaledSchw]]"],"Input",CellTags->"check_chart_guard"],
Cell[BoxData["DeletionPlan[\"Flat\",\"Chart\",Cascade->True]"],"Input",CellTags->"deletion_plan"],
Cell[BoxData["AssociationQ[DeleteBackgroundObject[\"Flat\",\"Chart\",Cascade->True]] && OwnValues[uQuadraticFlat]==={}"],"Input",CellTags->"check_family_delete"],
Cell[BoxData["ChartQ[chartScaledSchw]"],"Input",CellTags->"check_surviving_chart"],
Cell[BoxData["And@@(SameQ[DeleteBackground[#],Null]& /@ {\"Flat\",\"Copy\",\"Schwarzschild\",\"FLRW\"})"],"Input",CellTags->"check_cleanup"],
Cell["The source xAct theory remains available. This notebook is a focused integration example; the full regression suite tests native sparse writes, perturbations, cache invalidation, and external dependencies separately.","Text"]
},WindowTitle->"xPlorer — Consolidated Beta 13",StyleDefinitions->"Default.nb"]

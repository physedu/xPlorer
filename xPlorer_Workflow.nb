(* Wolfram Notebook File - ASCII source *)
Notebook[{
Cell[TextData[{"xPlorer - From an abstract theory to physical spacetimes"}],"Title"],

Cell[TextData[{"A massive scalar field on Minkowski, Schwarzschild and FLRW backgrounds | beta.13"}],"Subtitle"],

Cell[TextData[{"Place this notebook beside xPlorer.wl. With xAct installed, start a fresh kernel and evaluate the input cells in order with Shift+Enter. Standalone recipes are marked \:201cAlternative\:201d and are for reference."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{RowBox[{"NotebookDirectory", "[", "]"}], ",", "\"xPlorer.wl\""}], "}"}], "]"}], "]"}], ";"}]],"Input",CellTags->"load"],

Cell[TextData[{"Set the session preference to display coordinate derivatives as fractions. xPlorer displays contracted indices with short letters. Their internal names are available in InputForm."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"SetXPlorerPreferences", "[", RowBox[{"PartialStyle", "\[Rule]", "\"Fraction\""}], "]"}], ";"}]],"Input",CellTags->"session_notation"],

Cell[CellGroupData[{
Cell[TextData[{"1. Define and register a scalar theory"}],"Section"],

Cell[TextData[{"Define a four-dimensional Lorentzian manifold, its metric g and a real scalar field of mass m with xTensor. CD is the Levi-Civita derivative of g."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"DefManifold", "[", RowBox[{"M", ",", "4", ",", RowBox[{"{", RowBox[{"a", ",", "b", ",", "c", ",", "d", ",", "e", ",", "f", ",", "i", ",", "j"}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"DefMetric", "[", RowBox[{RowBox[{"-", "1"}], ",", RowBox[{"g", "[", RowBox[{RowBox[{"-", "a"}], ",", RowBox[{"-", "b"}]}], "]"}], ",", "CD"}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"DefTensor", "[", RowBox[{RowBox[{"phi", "[", "]"}], ",", "M", ",", RowBox[{"PrintAs", "\[Rule]", "\"\[Phi]\""}]}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"DefConstantSymbol", "[", "m", "]"}], ";"}]],"Input",CellTags->"abstract_objects"],

Cell[TextData[{"Define the kinetic and mass terms separately, then form their sum explicitly. The action integrates \:2112 with the metric volume element. Vary \:03c6 at fixed metric and take its variation to have compact support so the boundary term vanishes. The variable ",StyleBox["lagrangian",FontFamily->"Courier",FontSize->11]," holds \:2112 for the variation."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"Lkin", "=", RowBox[{FractionBox["1", "2"], " ", RowBox[{"(", RowBox[{"-", RowBox[{RowBox[{"CD", "[", RowBox[{"-", "a"}], "]"}], "[", RowBox[{"phi", "[", "]"}], "]"}]}], ")"}], " ", RowBox[{RowBox[{"CD", "[", "a", "]"}], "[", RowBox[{"phi", "[", "]"}], "]"}]}]}], ";", RowBox[{"Lmass", "=", RowBox[{FractionBox["1", "2"], " ", RowBox[{"(", RowBox[{"-", SuperscriptBox["m", "2"]}], ")"}], " ", SuperscriptBox[RowBox[{"phi", "[", "]"}], "2"]}]}], ";", RowBox[{"lagrangian", "=", RowBox[{"Lkin", "+", "Lmass"}]}], ";", TemplateBox[{"\"\[ScriptCapitalL] = \"", "lagrangian"}, "RowDefault"]}]],"Input",CellTags->"lagrangian"],

Cell[BoxData[RowBox[{RowBox[{"assumptions", "=", RowBox[{RowBox[{"m", "\[Element]", TemplateBox[{}, "Reals"]}], "&&", RowBox[{"m", "\[GreaterEqual]", "0"}]}]}], ";"}]],"Input",CellTags->"conditions"],

Cell[TextData[{"Apply xTensor\:2019s ",StyleBox["VarD",FontFamily->"Courier",FontSize->11]," to vary \:2112 with respect to \:03c6. Contract the metric and bring the result to canonical form."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"scalarEq", "=", RowBox[{"ToCanonical", "[", RowBox[{"ContractMetric", "[", RowBox[{RowBox[{"VarD", "[", RowBox[{RowBox[{"phi", "[", "]"}], ",", "CD"}], "]"}], "[", "lagrangian", "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"scalarEq", "\[Equal]", "0"}]}]],"Input",CellTags->"derive_equation"],

Cell[TextData[{"Register the theory"}],"Subsection"],

Cell[TextData[{"The result is the massive Klein\:2013Gordon equation. Register the metric, derivative and index list that xPlorer will use when creating backgrounds."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"ClearTheory", "[", "]"}], ";", "\[IndentingNewLine]", RowBox[{"RegisterTheory", "[", RowBox[{"\"Metric\"", ",", "g"}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"RegisterTheory", "[", RowBox[{"\"CovD\"", ",", "CD"}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"RegisterTheory", "[", RowBox[{"\"Indices\"", ",", RowBox[{"{", RowBox[{"a", ",", "b", ",", "c", ",", "d", ",", "e", ",", "f", ",", "i", ",", "j"}], "}"}]}], "]"}], ";"}]],"Input",CellTags->"register_geometry"],

Cell[TextData[{"Choose a lookup key, a symbol name and a printed label"}],"Subsection"],

Cell[TextData[{"Try the naming options before registering any equations. Name chooses the lookup key and default symbol base; SymbolBase is optional when they differ. Here the temporary example uses suffix Demo, field label P, metric label q, and Greek abstract indices. Indices must contain as many labels as the source index list. These are abstract indices, not coordinates."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"RegisterTheory", "[", RowBox[{"\"Field\"", ",", "phi", ",", RowBox[{"Name", "\[Rule]", "\"Materia\""}], ",", RowBox[{"SymbolBase", "\[Rule]", "\"matter\""}], ",", RowBox[{"PrintAs", "\[Rule]", "\"P\""}]}], "]"}], ";", RowBox[{"CreateBackground", "[", RowBox[{"\"NamingExample\"", ",", RowBox[{"SymbolSuffix", "\[Rule]", "\"Demo\""}], ",", RowBox[{"PrintAs", "\[Rule]", "\"q\""}], ",", RowBox[{"Indices", "\[Rule]", RowBox[{"{", RowBox[{"\[Mu]", ",", "\[Nu]", ",", "\[Rho]", ",", "\[Sigma]", ",", "\[Alpha]", ",", "\[Beta]", ",", "\[Gamma]", ",", "\[Delta]"}], "}"}]}]}], "]"}], ";"}]],"Input",CellTags->"naming_setup"],

Cell[TextData[{"The copied field is matterDemo and the metric is gDemo. The indices muDemo and nuDemo (typed as Greek letters) are printed as Greek indices, not as the original Latin a and b. The same applies to derivative indices. If you only know the registration key, ",StyleBox["BackgroundObject[\"NamingExample\",\"Materia\"]",FontFamily->"Courier",FontSize->11]," retrieves the same head."}],"Text"],

Cell[BoxData[RowBox[{"{", RowBox[{"matterDemo", ",", RowBox[{"matterDemo", "[", "]"}], ",", RowBox[{"gDemo", "[", RowBox[{RowBox[{"-", "\[Mu]Demo"}], ",", RowBox[{"-", "\[Nu]Demo"}]}], "]"}], ",", RowBox[{RowBox[{"CDDemo", "[", RowBox[{"-", "\[Rho]Demo"}], "]"}], "[", RowBox[{"matterDemo", "[", "]"}], "]"}]}], "}"}]],"Input",CellTags->"naming_result"],

Cell[TextData[{"If typing Greek symbols is inconvenient, retrieve the actual owned indices with BackgroundIndices and assign ordinary Latin-letter aliases. These are references to the same abstract indices, not new xAct indices. The following metric and derivative still print with Greek indices."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{RowBox[{"{", RowBox[{"muDemo", ",", "nuDemo", ",", "rhoDemo"}], "}"}], "=", RowBox[{"BackgroundIndices", "[", RowBox[{"\"NamingExample\"", ",", "3"}], "]"}]}], ";", RowBox[{"{", RowBox[{RowBox[{"gDemo", "[", RowBox[{RowBox[{"-", "muDemo"}], ",", RowBox[{"-", "nuDemo"}]}], "]"}], ",", RowBox[{RowBox[{"CDDemo", "[", RowBox[{"-", "rhoDemo"}], "]"}], "[", RowBox[{"matterDemo", "[", "]"}], "]"}]}], "}"}]}]],"Input",CellTags->"naming_index_aliases"],

Cell[TextData[{"Clear the three user-defined aliases, close the example and remove its field key. The source scalar \:03c6 is still defined. We will register it below with its default name and label for the three physical backgrounds."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"Clear","[",RowBox[{"muDemo",",","nuDemo",",","rhoDemo"}],"]"}],";",RowBox[{"DeleteBackground", "[", "\"NamingExample\"", "]"}], ";", RowBox[{"UnregisterTheory", "[", RowBox[{"\"Fields\"", ",", "\"Materia\""}], "]"}], ";", RowBox[{"Keys", "[", RowBox[{"TheoryValue", "[", "\"Fields\"", "]"}], "]"}]}]],"Input",CellTags->"close_naming"],

Cell[TextData[{"Register the scalar and its mass"}],"Subsubsection"],

Cell[TextData[{"For one item use Field, Parameter, Lagrangian or Expression; for a batch use Fields, Parameters, Lagrangians or Expressions. Query collections with their plural names. Pass only the native tensor head ",StyleBox["phi",FontFamily->"Courier",FontSize->11]," when registering the field. xPlorer infers its rank and symmetry. The registration also gives the parameter m the lookup key ",StyleBox["\"Mass\"",FontFamily->"Courier",FontSize->11],"."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"RegisterTheory", "[", RowBox[{"\"Field\"", ",", "phi", ",", RowBox[{"Sector", "\[Rule]", "\"Matter\""}]}], "]"}], ";", RowBox[{"RegisterTheory", "[", RowBox[{"\"Parameter\"", ",", "m", ",", RowBox[{"Name", "\[Rule]", "\"Mass\""}], ",", RowBox[{"Sector", "\[Rule]", "\"Matter\""}]}], "]"}], ";"}]],"Input",CellTags->"register_matter"],

Cell[BoxData[RowBox[{"KeyTake", "[", RowBox[{RowBox[{"TheoryValue", "[", RowBox[{"\"Fields\"", ",", "\"phi\""}], "]"}], ",", RowBox[{"{", RowBox[{"\"Type\"", ",", "\"Head\"", ",", "\"Rank\"", ",", "\"PrintAs\"", ",", "\"Sector\""}], "}"}]}], "]"}]],"Input",CellTags->"inspect_scalar_spec"],

Cell[TextData[{"The scalar entry records the head phi, the type \"Scalar\" and the printed label \:03c6. To override just that label at registration, add ",StyleBox["PrintAs -> \"M1\"",FontFamily->"Courier",FontSize->11],"."}],"Text"],

Cell[TextData[{"For several parameters, pass a list of native constant symbols, as in ",StyleBox["RegisterTheory[\"Parameters\", {m, kappa}]",FontFamily->"Courier",FontSize->11],"."}],"Text"],

Cell[TextData[{"Store the kinetic term, mass term and their explicitly defined total in the Lagrangians collection. xPlorer does not add them automatically. Retrieve the total with ",StyleBox["TheoryValue[\"Lagrangians\", \"Lagrangian\"]",FontFamily->"Courier",FontSize->11],"."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"RegisterTheory", "[", RowBox[{"\"Lagrangians\"", ",", RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{RowBox[{"\"Kinetic\"", "\[Rule]", "Lkin"}], ",", RowBox[{"Sector", "\[Rule]", "\"Matter\""}]}], "}"}], ",", RowBox[{"{", RowBox[{RowBox[{"\"MassTerm\"", "\[Rule]", "Lmass"}], ",", RowBox[{"Sector", "\[Rule]", "\"Matter\""}]}], "}"}], ",", RowBox[{"{", RowBox[{RowBox[{"\"Lagrangian\"", "\[Rule]", "lagrangian"}], ",", RowBox[{"Sector", "\[Rule]", "\"Matter\""}]}], "}"}]}], "}"}]}], "]"}], ";", RowBox[{"TheoryValue", "[", "\"Lagrangians\"", "]"}]}]],"Input",CellTags->"register_lagrangian_only"],

Cell[TextData[{"Expressions and Lagrangians are separate collections, both available on backgrounds. Register the scalar equation under the key ScalarEq. Its original variable name scalarEq determines its suffixed alias. For a formula entered directly, Head specifies the alias base."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"RegisterTheory", "[", RowBox[{"\"Expressions\"", ",", RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{RowBox[{"\"ScalarEq\"", "\[Rule]", "scalarEq"}], ",", RowBox[{"Sector", "\[Rule]", "\"Matter\""}]}], "}"}], ",", RowBox[{"{", RowBox[{RowBox[{"\"Metric\"", "\[Rule]", RowBox[{"g", "[", RowBox[{RowBox[{"-", "a"}], ",", RowBox[{"-", "b"}]}], "]"}]}], ",", RowBox[{"Head", "\[Rule]", "\"metricExpr\""}]}], "}"}]}], "}"}]}], "]"}], ";"}]],"Input",CellTags->"register_expressions"],

Cell[TextData[{"Register the gradient and Hessian together, with explicit Head options for the anonymous formulas. Sector labels group related objects across collections; they do not impose equations or activate rules."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"RegisterTheory", "[", RowBox[{"\"Expressions\"", ",", RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{RowBox[{"\"Gradient\"", "\[Rule]", RowBox[{RowBox[{"CD", "[", RowBox[{"-", "a"}], "]"}], "[", RowBox[{"phi", "[", "]"}], "]"}]}], ",", RowBox[{"Head", "\[Rule]", "\"gradient\""}], ",", RowBox[{"Sector", "\[Rule]", "\"Matter\""}]}], "}"}], ",", RowBox[{"{", RowBox[{RowBox[{"\"Hessian\"", "\[Rule]", RowBox[{RowBox[{"CD", "[", RowBox[{"-", "a"}], "]"}], "[", RowBox[{RowBox[{"CD", "[", RowBox[{"-", "b"}], "]"}], "[", RowBox[{"phi", "[", "]"}], "]"}], "]"}]}], ",", RowBox[{"Head", "\[Rule]", "\"hessian\""}], ",", RowBox[{"Sector", "\[Rule]", "\"Matter\""}]}], "}"}]}], "}"}]}], "]"}], ";"}]],"Input",CellTags->"register_bulk"],

Cell[TextData[{"Define and register a rank-two expression Eab from the Hessian and a mass term. The cell displays the registered formula or a registration Failure; check this before creating backgrounds. Its definition imposes no field equation."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"Eab", "=", RowBox[{RowBox[{RowBox[{"CD", "[", RowBox[{"-", "a"}], "]"}], "[", RowBox[{RowBox[{"CD", "[", RowBox[{"-", "b"}], "]"}], "[", RowBox[{"phi", "[", "]"}], "]"}], "]"}], "+", RowBox[{SuperscriptBox["m", "2"], " ", RowBox[{"g", "[", RowBox[{RowBox[{"-", "a"}], ",", RowBox[{"-", "b"}]}], "]"}], " ", RowBox[{"phi", "[", "]"}]}]}]}], ";", RowBox[{"eabRegistration", "=", RowBox[{"RegisterTheory", "[", RowBox[{"\"Expression\"", ",", RowBox[{"\"Eab\"", "\[Rule]", "Eab"}], ",", RowBox[{"Sector", "\[Rule]", "\"Matter\""}]}], "]"}]}], ";", RowBox[{"If", "[", RowBox[{RowBox[{"FailureQ", "[", "eabRegistration", "]"}], ",", "eabRegistration", ",", RowBox[{"TheoryValue", "[", RowBox[{"\"Expressions\"", ",", "\"Eab\""}], "]"}]}], "]"}]}]],"Input",CellTags->"register_eab"],

Cell[TextData[{"For a named Wolfram expression, give an explicit lookup key. This registers the wave operator under ",StyleBox["\"boxPhi\"",FontFamily->"Courier",FontSize->11],"."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"boxPhi", "=", RowBox[{RowBox[{"CD", "[", "a", "]"}], "[", RowBox[{RowBox[{"CD", "[", RowBox[{"-", "a"}], "]"}], "[", RowBox[{"phi", "[", "]"}], "]"}], "]"}]}], ";", RowBox[{"RegisterTheory", "[", RowBox[{"\"Expression\"", ",", RowBox[{"\"boxPhi\"", "\[Rule]", "boxPhi"}], ",", RowBox[{"Sector", "\[Rule]", "\"Matter\""}]}], "]"}], ";"}]],"Input",CellTags->"register_named_expression"],

Cell[TextData[{"Store the assumptions and variational conditions alongside the theory. These entries document the calculation. Pass assumptions to the operations that use them."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"RegisterTheory", "[", RowBox[{"Association", "[", RowBox[{RowBox[{"\"Assumptions\"", "\[Rule]", "assumptions"}], ",", RowBox[{"\"Conditions\"", "\[Rule]", "\"Fixed metric; compactly supported scalar variations\""}]}], "]"}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"theory", "=", RowBox[{"TheorySnapshot", "[", "]"}]}], ";"}]],"Input",CellTags->"register_metadata"],

Cell[TextData[{StyleBox["TheoryValue",FontFamily->"Courier",FontSize->11]," retrieves a collection or an individual registry entry. Use ",StyleBox["ShowTheoryKeys[]",FontFamily->"Courier",FontSize->11]," for the top-level keys or ",StyleBox["TheorySnapshot[]",FontFamily->"Courier",FontSize->11]," for the full restorable registry. ShowTheory[] displays a concise overview. TheorySector groups objects by their physical sector."}],"Text"],

Cell[BoxData[RowBox[{"ShowTheory","[","]"}]],"Input",CellTags->"theory_overview"],

Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"ShowTheoryKeys", "[", "]"}], ",", RowBox[{"Keys", "/@", RowBox[{"TheorySector", "[", "\"Matter\"", "]"}]}]}], "}"}]],"Input",CellTags->"inspect_registration"],

Cell[BoxData[RowBox[{"ShowTheory","[","\"Lagrangians\"","]"}]],"Input",CellTags->"theory_lagrangian_view"],

Cell[BoxData[RowBox[{"TheoryValue", "[", RowBox[{"\"Lagrangians\"", ",", "\"Lagrangian\""}], "]"}]],"Input",CellTags->"registered_lagrangian"],

Cell[TextData[{StyleBox["ClearTheory[]",FontFamily->"Courier",FontSize->11]," clears the registry. The original xAct objects g, CD and \:03c6 remain defined. Re-register the objects to use them in another theory."}],"Important"]
},Open]],

Cell[CellGroupData[{
Cell[TextData[{"2. Create and inspect independent backgrounds"}],"Section"],

Cell[TextData[{"Create three backgrounds from the registered theory. Each gets its own manifold, metric and fields. The coordinate matrices in section 5 will specify the three geometries."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"CreateBackground", "[", RowBox[{"\"Minkowski\"", ",", RowBox[{"SymbolSuffix", "\[Rule]", "\"M\""}]}], "]"}], ";", RowBox[{"CreateBackground", "[", RowBox[{"\"Schwarzschild\"", ",", RowBox[{"SymbolSuffix", "\[Rule]", "\"Schw\""}]}], "]"}], ";", RowBox[{"CreateBackground", "[", "\"FLRW\"", "]"}], ";"}]],"Input",CellTags->"create_manifolds"],

Cell[TextData[{"Check that Eab is registered in the current theory, is included in the Schwarzschild snapshot and has an installed alias. All three should be True in a fresh kernel. CreateBackground with an existing tag returns the existing snapshot; it does not refresh it. If the second check is False, recreate the study only after preserving any desired data, or restart the kernel and run from the beginning. An alias conflict alone does not remove a registered expression."}],"Text"],

Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"KeyExistsQ", "[", RowBox[{RowBox[{"TheoryValue", "[", "\"Expressions\"", "]"}], ",", "\"Eab\""}], "]"}], ",", RowBox[{"KeyExistsQ", "[", RowBox[{RowBox[{RowBox[{RowBox[{"ShowBackground", "[", "\"Schwarzschild\"", "]"}], "[", "\"Theory\"", "]"}], "[", "\"Formula\"", "]"}], ",", "\"Expressions:Eab\""}], "]"}], ",", RowBox[{"KeyExistsQ", "[", RowBox[{RowBox[{RowBox[{"ShowBackground", "[", "\"Schwarzschild\"", "]"}], "[", "\"ExpressionAliases\"", "]"}], ",", "\"Expressions:Eab\""}], "]"}]}], "}"}]],"Input",CellTags->"snapshot_check"],

Cell[TextData[{"FLRW uses its tag as its suffix. Schwarzschild uses Schw, so you can already type ",StyleBox["phiSchw[]",FontFamily->"Courier",FontSize->11],". To use your own name, retrieve the field by its key and assign it to ",StyleBox["matter1",FontFamily->"Courier",FontSize->11],"."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"matter1", "=", RowBox[{"BackgroundObject", "[", RowBox[{"\"Schwarzschild\"", ",", "\"phi\""}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"{", RowBox[{"matter1", ",", RowBox[{"matter1", "[", "]"}]}], "}"}]}]],"Input",CellTags->"scalar_alias"],

Cell[TextData[{"If you know the background tag but want to look up a head or index, use these accessors. If a notebook name is occupied, xPlorer keeps its existing definition and lists it under ",StyleBox["\"UnavailableObjectAliases\"",FontFamily->"Courier",FontSize->11]," in ",StyleBox["ShowBackground",FontFamily->"Courier",FontSize->11],"."}],"Text"],

Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"BackgroundObject", "[", RowBox[{"\"Schwarzschild\"", ",", "\"Metric\""}], "]"}], ",", RowBox[{"RiemannOf", "[", "\"Schwarzschild\"", "]"}], ",", RowBox[{"BackgroundObject", "[", RowBox[{"\"Schwarzschild\"", ",", "\"phi\""}], "]"}], ",", RowBox[{"First", "[", RowBox[{"BackgroundIndices", "[", RowBox[{"\"Schwarzschild\"", ",", "1"}], "]"}], "]"}]}], "}"}]],"Input",CellTags->"inspect_short_names"],

Cell[TextData[{StyleBox["EabM",FontFamily->"Courier",FontSize->11]," and ",StyleBox["EabSchw",FontFamily->"Courier",FontSize->11]," retrieve the formula on their respective manifolds. If a shortcut name is occupied, use ",StyleBox["BackgroundExpression",FontFamily->"Courier",FontSize->11]," with the original key. The background lists the conflict under ",StyleBox["\"UnavailableAliases\"",FontFamily->"Courier",FontSize->11],"."}],"Text"],

Cell[BoxData[RowBox[{"{", RowBox[{"EabM", ",", "EabSchw", ",", RowBox[{"BackgroundExpression", "[", RowBox[{"\"Schwarzschild\"", ",", "\"Expressions\"", ",", "\"Eab\""}], "]"}], ",", "lagrangianSchw", ",", RowBox[{"BackgroundExpression", "[", RowBox[{"\"Schwarzschild\"", ",", "\"Lagrangians\"", ",", "\"Lagrangian\""}], "]"}]}], "}"}]],"Input",CellTags->"automatic_formulas"],

Cell[TextData[{"Inspect the entries in the Schwarzschild background."}],"Text"],

Cell[BoxData[RowBox[{"Keys", "[", RowBox[{"ShowBackground", "[", "\"Schwarzschild\"", "]"}], "]"}]],"Input",CellTags->"inspect_background"],

Cell[TextData[{"The geometry, fields and indices have their own entries. The ",StyleBox["\"Theory\"",FontFamily->"Courier",FontSize->11]," entry records the theory as it stood at creation. Fields registered later appear in subsequent backgrounds."}],"Text"],

Cell[TextData[{"Several backgrounds can coexist in one kernel. The tag selects the study, and its tensors and indices belong to its manifold."}],"Important"]
},Open]],

Cell[CellGroupData[{
Cell[TextData[{"3. Calculate with the abstract tensors"}],"Section"],

Cell[TextData[{"Retrieve the scalar equation on all three manifolds before choosing coordinates."}],"Text"],

Cell[BoxData[RowBox[{"{", RowBox[{"scalarEqM", ",", "scalarEqSchw", ",", "scalarEqFLRW"}], "}"}]],"Input",CellTags->"formal_equations"],

Cell[TextData[{StyleBox["PortExpression",FontFamily->"Courier",FontSize->11]," takes a formula directly and transfers its heads and indices. Here it returns the abstract gradient on Schwarzschild, with the background rules unapplied."}],"Text"],

Cell[BoxData[RowBox[{"gradPhi", "=", RowBox[{"PortExpression", "[", RowBox[{"\"Schwarzschild\"", ",", RowBox[{RowBox[{"CD", "[", RowBox[{"-", "a"}], "]"}], "[", RowBox[{"phi", "[", "]"}], "]"}]}], "]"}]}]],"Input",CellTags->"transport_gradient"],

Cell[TextData[{StyleBox["UseExpression",FontFamily->"Courier",FontSize->11]," retrieves the gradient registered under ",StyleBox["\"Gradient\"",FontFamily->"Courier",FontSize->11]," and applies the background\:2019s active rules. The rule list is currently empty, so both calls give the same gradient."}],"Text"],

Cell[BoxData[RowBox[{"UseExpression", "[", RowBox[{"\"Schwarzschild\"", ",", "\"Gradient\""}], "]"}]],"Input",CellTags->"saved_gradient"],

Cell[TextData[{"Write the gradient directly with the derivative, index and field names created by ",StyleBox["CreateBackground",FontFamily->"Courier",FontSize->11],"."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"CDSchw", "[", RowBox[{"-", "aSchw"}], "]"}], "[", RowBox[{"phiSchw", "[", "]"}], "]"}]],"Input",CellTags->"direct_gradient"],

Cell[TextData[{"In xAct, ",StyleBox["-aSchw",FontFamily->"Courier",FontSize->11]," denotes a lower index. Contract the gradient with the inverse metric to raise that index."}],"Text"],

Cell[BoxData[RowBox[{"gradPhiUp", "=", RowBox[{"ContractMetric", "[", RowBox[{RowBox[{"gSchw", "[", RowBox[{"aSchw", ",", "bSchw"}], "]"}], " ", RowBox[{RowBox[{"CDSchw", "[", RowBox[{"-", "bSchw"}], "]"}], "[", RowBox[{"phiSchw", "[", "]"}], "]"}]}], "]"}]}]],"Input",CellTags->"raise_gradient"],

Cell[TextData[{"An equivalent calculation is to form the raised gradient on the source manifold and transfer the whole expression. In either calculation the metric, derivative and indices must belong to the same manifold."}],"Text"],

Cell[TextData[{"The copied connection has its own curvature tensors. The Riemann tensor, Ricci tensor and Ricci scalar can be used directly in abstract xAct calculations before choosing coordinates. No vacuum equation has been imposed yet."}],"Text"],

Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"RiemannCDSchw", "[", RowBox[{RowBox[{"-", "aSchw"}], ",", RowBox[{"-", "bSchw"}], ",", RowBox[{"-", "cSchw"}], ",", RowBox[{"-", "dSchw"}]}], "]"}], ",", RowBox[{"RicciCDSchw", "[", RowBox[{RowBox[{"-", "aSchw"}], ",", RowBox[{"-", "bSchw"}]}], "]"}], ",", RowBox[{"RicciScalarCDSchw", "[", "]"}]}], "}"}]],"Input",CellTags->"riemann_tensor"],

Cell[TextData[{"Change the printed labels in Schwarzschild formulas to psi for the scalar, q for the metric and D for the derivative. This changes presentation only. The scalar\:2019s lookup key remains ",StyleBox["\"phi\"",FontFamily->"Courier",FontSize->11],"."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"SetPresentation", "[", RowBox[{"\"Schwarzschild\"", ",", RowBox[{"Association", "[", RowBox[{RowBox[{"\"phi\"", "\[Rule]", "\"\[Psi]\""}], ",", RowBox[{"\"Metric\"", "\[Rule]", "\"q\""}], ",", RowBox[{"\"CovD\"", "\[Rule]", RowBox[{"{", RowBox[{"\"|\"", ",", "\"D\""}], "}"}]}]}], "]"}]}], "]"}], ";", RowBox[{"{", RowBox[{RowBox[{"phiSchw", "[", "]"}], ",", RowBox[{"gSchw", "[", RowBox[{RowBox[{"-", "aSchw"}], ",", RowBox[{"-", "bSchw"}]}], "]"}], ",", RowBox[{RowBox[{"CDSchw", "[", RowBox[{"-", "aSchw"}], "]"}], "[", RowBox[{"phiSchw", "[", "]"}], "]"}]}], "}"}]}]],"Input",CellTags->"custom_presentation"],

Cell[TextData[{StyleBox["PrintAs -> Automatic",FontFamily->"Courier",FontSize->11]," restores the inherited label. For several objects, set ",StyleBox["Presentation",FontFamily->"Courier",FontSize->11]," at creation or register a theory-wide ",StyleBox["\"Presentation\"",FontFamily->"Courier",FontSize->11]," association. Session defaults for future backgrounds can be set with ",StyleBox["SetXPlorerPreferences",FontFamily->"Courier",FontSize->11]," and reset with ",StyleBox["SetXPlorerPreferences[]",FontFamily->"Courier",FontSize->11],"."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"SetPresentation", "[", RowBox[{"\"Schwarzschild\"", ",", RowBox[{"Association", "[", RowBox[{RowBox[{"\"phi\"", "\[Rule]", "Automatic"}], ",", RowBox[{"\"Metric\"", "\[Rule]", "Automatic"}], ",", RowBox[{"\"CovD\"", "\[Rule]", "Automatic"}]}], "]"}]}], "]"}], ";", RowBox[{"{", RowBox[{RowBox[{"phiSchw", "[", "]"}], ",", RowBox[{"gSchw", "[", RowBox[{RowBox[{"-", "aSchw"}], ",", RowBox[{"-", "bSchw"}]}], "]"}], ",", RowBox[{RowBox[{"CDSchw", "[", RowBox[{"-", "aSchw"}], "]"}], "[", RowBox[{"phiSchw", "[", "]"}], "]"}]}], "}"}]}]],"Input",CellTags->"reset_presentation"],

Cell[TextData[{StyleBox["PrettyExp",FontFamily->"Courier",FontSize->11]," compares two genuinely different displays of the same gradient: a prefix covariant derivative and a postfix derivative, with a background label on the second. Normal recovers the original mathematical expression. Continue calculations with ",StyleBox["gradPhi",FontFamily->"Courier",FontSize->11],"."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"prettyGradient", "=", RowBox[{RowBox[{"PrettyExp", "[", RowBox[{RowBox[{"CovariantStyle", "\[Rule]", "\"Postfix\""}], ",", RowBox[{"ShowBackgroundLabel", "\[Rule]", "True"}]}], "]"}], "[", "gradPhi", "]"}]}], ";", RowBox[{"{", RowBox[{RowBox[{RowBox[{"PrettyExp", "[", RowBox[{"CovariantStyle", "\[Rule]", "\"Prefix\""}], "]"}], "[", "gradPhi", "]"}], ",", "prettyGradient"}], "}"}]}]],"Input",CellTags->"pretty_gradient"]
},Open]],

Cell[CellGroupData[{
Cell[TextData[{"4. Specialize a case and return to the general one"}],"Section"],

Cell[TextData[{"Take the massless limit on Schwarzschild. ContractMetric and ToCanonical leave the scalar d'Alembertian of the field; the repeated upper and lower derivative indices are summed. ",StyleBox["AddRules",FontFamily->"Courier",FontSize->11]," stores the replacement locally. ",StyleBox["UseExpression",FontFamily->"Courier",FontSize->11]," evaluates the registered equation with that replacement. The source parameter m and the other backgrounds retain their values."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"AddRules", "[", RowBox[{"\"Schwarzschild\"", ",", RowBox[{"{", RowBox[{"m", "\[Rule]", "0"}], "}"}]}], "]"}], ";", RowBox[{"masslessEq", "=", RowBox[{"ToCanonical", "[", RowBox[{"ContractMetric", "[", RowBox[{"UseExpression", "[", RowBox[{"\"Schwarzschild\"", ",", "\"ScalarEq\""}], "]"}], "]"}], "]"}]}], ";", "masslessEq"}]],"Input",CellTags->"massless_rules"],

Cell[TextData[{"Verify that the result has no free indices and is exactly the transported scalar wave operator. Both checks should return True."}],"Text"],

Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{RowBox[{"FindFreeIndices", "[", "masslessEq", "]"}], "===", RowBox[{"IndexList", "[", "]"}]}], ",", RowBox[{RowBox[{"ToCanonical", "[", RowBox[{"ContractMetric", "[", RowBox[{"masslessEq", "-", RowBox[{"PortExpression", "[", RowBox[{"\"Schwarzschild\"", ",", "boxPhi"}], "]"}]}], "]"}], "]"}], "===", "0"}]}], "}"}]],"Input",CellTags->"massless_contraction"],

Cell[TextData[{"Compare the mass term in the two columns. The shortcut ",StyleBox["EabSchw",FontFamily->"Courier",FontSize->11]," gives the general formula and ",StyleBox["UseExpression",FontFamily->"Courier",FontSize->11]," gives the active massless case."}],"Text"],

Cell[BoxData[RowBox[{"Grid", "[", RowBox[{RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"\"General Eab on Schw\"", ",", "\"Active massless case\""}], "}"}], ",", RowBox[{"{", RowBox[{"EabSchw", ",", RowBox[{"UseExpression", "[", RowBox[{"\"Schwarzschild\"", ",", "\"Eab\""}], "]"}]}], "}"}]}], "}"}], ",", RowBox[{"Alignment", "\[Rule]", "Left"}], ",", RowBox[{"Frame", "\[Rule]", "All"}]}], "]"}]],"Input",CellTags->"compare_mass_terms"],

Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"FreeQ", "[", RowBox[{"EabSchw", ",", "m"}], "]"}], ",", RowBox[{"FreeQ", "[", RowBox[{RowBox[{"UseExpression", "[", RowBox[{"\"Schwarzschild\"", ",", "\"Eab\""}], "]"}], ",", "m"}], "]"}], ",", RowBox[{RowBox[{"ApplyRules", "[", RowBox[{"\"Schwarzschild\"", ",", "EabSchw"}], "]"}], "===", RowBox[{"UseExpression", "[", RowBox[{"\"Schwarzschild\"", ",", "\"Eab\""}], "]"}]}]}], "}"}]],"Input",CellTags->"alias_specialization"],

Cell[TextData[{StyleBox["ShowRules",FontFamily->"Courier",FontSize->11]," lists the active replacements. Use ",StyleBox["ApplyRules",FontFamily->"Courier",FontSize->11]," to apply them to an expression you already have."}],"Text"],

Cell[BoxData[RowBox[{"ShowRules", "[", "\"Schwarzschild\"", "]"}]],"Input",CellTags->"inspect_rules"],

Cell[BoxData[RowBox[{"ApplyRules", "[", RowBox[{"\"Schwarzschild\"", ",", "scalarEqSchw"}], "]"}]],"Input",CellTags->"apply_rules"],

Cell[TextData[{"Clear the active rules and request the equation again to recover the mass term."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"ClearRules", "[", "\"Schwarzschild\"", "]"}], ";", "\[IndentingNewLine]", RowBox[{"UseExpression", "[", RowBox[{"\"Schwarzschild\"", ",", "\"ScalarEq\""}], "]"}]}]],"Input",CellTags->"restore_massive"],

Cell[TextData[{"Save two named mass choices. ",StyleBox["ActivateRuleGroups",FontFamily->"Courier",FontSize->11]," builds the active list in the specified order. A stored group takes effect on activation, and edits to an active group refresh the list."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"SetRuleGroup", "[", RowBox[{"\"Schwarzschild\"", ",", "\"Massless\"", ",", RowBox[{"{", RowBox[{"m", "\[Rule]", "0"}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"SetRuleGroup", "[", RowBox[{"\"Schwarzschild\"", ",", "\"ReferenceMass\"", ",", RowBox[{"{", RowBox[{"m", "\[Rule]", "1"}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"ActivateRuleGroups", "[", RowBox[{"\"Schwarzschild\"", ",", RowBox[{"{", RowBox[{"\"ReferenceMass\"", ",", "\"Massless\""}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"ApplyRules", "[", RowBox[{"\"Schwarzschild\"", ",", "m"}], "]"}]}]],"Input",CellTags->"rule_groups"],

Cell[TextData[{"The preceding call gives 1 because the reference-mass rule comes first. Request the numbered list to see the one-based positions used by ",StyleBox["RemoveRules",FontFamily->"Courier",FontSize->11],"."}],"Text"],

Cell[BoxData[TagBox[RowBox[{"ShowRules", "[", RowBox[{"\"Schwarzschild\"", ",", "\"Numbered\""}], "]"}], Function[BoxForm`e$, TableForm[BoxForm`e$]]]],"Input",CellTags->"numbered_rules"],

Cell[TextData[{"Remove the reference-mass rule by its position."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"RemoveRules", "[", RowBox[{"\"Schwarzschild\"", ",", RowBox[{"{", "1", "}"}]}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"ShowRules", "[", RowBox[{"\"Schwarzschild\"", ",", "\"Numbered\""}], "]"}]}]],"Input",CellTags->"remove_selected_rule"],

Cell[TextData[{"The massless rule now occupies position 1. Clear it to restore the general case."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"ClearRules", "[", "\"Schwarzschild\"", "]"}], ";"}]],"Input",CellTags->"clear_mass_rules"],

Cell[TextData[{StyleBox["SetFlatRules",FontFamily->"Courier",FontSize->11]," lets you impose vanishing curvature in an abstract calculation. Clear those rules after checking the Ricci scalar so the later curvature calculations use the assigned metric."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"SetFlatRules", "[", "\"Minkowski\"", "]"}], ";", "\[IndentingNewLine]", RowBox[{"ApplyRules", "[", RowBox[{"\"Minkowski\"", ",", RowBox[{"PortExpression", "[", RowBox[{"\"Minkowski\"", ",", RowBox[{RowBox[{"RicciScalar", "[", "CD", "]"}], "[", "]"}]}], "]"}]}], "]"}]}]],"Input",CellTags->"flat_rules"],

Cell[BoxData[RowBox[{RowBox[{"ClearRules", "[", "\"Minkowski\"", "]"}], ";"}]],"Input",CellTags->"clear_flat_rules"]
},Open]],

Cell[CellGroupData[{
Cell[TextData[{"5. Choose coordinates and calculate components"}],"Section"],

Cell[TextData[{StyleBox["DefineChart",FontFamily->"Courier",FontSize->11]," calls xCoba\:2019s ",StyleBox["DefChart",FontFamily->"Courier",FontSize->11]," on the selected manifold. Each chart gets its own coordinate scalars, even when two charts use the same labels."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"DefineChart", "[", RowBox[{"\"Minkowski\"", ",", RowBox[{"{", RowBox[{"\"t\"", ",", "\"x\"", ",", "\"y\"", ",", "\"z\""}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"DefineChart", "[", RowBox[{"\"Schwarzschild\"", ",", RowBox[{"{", RowBox[{"\"t\"", ",", "\"r\"", ",", "\"theta\"", ",", "\"varphi\""}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"DefineChart", "[", RowBox[{"\"FLRW\"", ",", RowBox[{"{", RowBox[{"\"t\"", ",", "\"x\"", ",", "\"y\"", ",", "\"z\""}], "}"}]}], "]"}], ";"}]],"Input",CellTags->"charts"],

Cell[TextData[{StyleBox["CoordinatesOf",FontFamily->"Courier",FontSize->11]," returns the coordinate heads. Apply them with ",StyleBox["Through",FontFamily->"Courier",FontSize->11]," as below. The resulting aliases can be differentiated with ",StyleBox["D",FontFamily->"Courier",FontSize->11],"."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{RowBox[{"{", RowBox[{"tM", ",", "xM", ",", "yM", ",", "zM"}], "}"}], "=", RowBox[{"Through", "[", RowBox[{RowBox[{"CoordinatesOf", "[", "\"Minkowski\"", "]"}], "[", "]"}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{RowBox[{"{", RowBox[{"tSchw", ",", "rSchw", ",", "thetaSchw", ",", "varphiSchw"}], "}"}], "=", RowBox[{"Through", "[", RowBox[{RowBox[{"CoordinatesOf", "[", "\"Schwarzschild\"", "]"}], "[", "]"}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{RowBox[{"{", RowBox[{"tF", ",", "xF", ",", "yF", ",", "zF"}], "}"}], "=", RowBox[{"Through", "[", RowBox[{RowBox[{"CoordinatesOf", "[", "\"FLRW\"", "]"}], "[", "]"}], "]"}]}], ";"}]],"Input",CellTags->"coordinate_aliases"],

Cell[TextData[{"For example, ",StyleBox["xM^2",FontFamily->"Courier",FontSize->11]," is a coordinate profile, ",StyleBox["-a",FontFamily->"Courier",FontSize->11]," is a lower abstract index, and component number 1 selects x in the Cartesian order (t,x,y,z)."}],"Text"],

Cell[TextData[{"Minkowski spacetime"}],"Subsection"],

Cell[TextData[{"Supply the constant metric matrix in chart order {t,x,y,z}. ",StyleBox["SetCMetricSystem",FontFamily->"Courier",FontSize->11]," assigns it to the copied metric through xCoba and prepares the inverse and determinant. Further geometry is computed on request."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"SetCMetricSystem", "[", RowBox[{"\"Minkowski\"", ",", RowBox[{"DiagonalMatrix", "[", RowBox[{"{", RowBox[{RowBox[{"-", "1"}], ",", "1", ",", "1", ",", "1"}], "}"}], "]"}], ",", RowBox[{"Assumptions", "\[Rule]", "assumptions"}]}], "]"}], ";"}]],"Input",CellTags->"minkowski_metric"],

Cell[TextData[{"Inspect the metric as an xCoba component tensor"}],"Subsection"],

Cell[TextData[{"xPlorer uses ",StyleBox["MetricInBasis",FontFamily->"Courier",FontSize->11]," for the existing metric. To inspect the same entries as a native xCoba component tensor, pair the matrix with its bases in ",StyleBox["CTensor",FontFamily->"Courier",FontSize->11],". The two negative basis slots give the two lower indices. ",StyleBox["CTensorArray",FontFamily->"Courier",FontSize->11]," retrieves the matrix."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"cartBasis", "=", RowBox[{"BasisOf", "[", "\"Minkowski\"", "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"metricCTensor", "=", RowBox[{"CTensor", "[", RowBox[{RowBox[{"MetricMatrixOf", "[", "\"Minkowski\"", "]"}], ",", RowBox[{"{", RowBox[{RowBox[{"-", "cartBasis"}], ",", RowBox[{"-", "cartBasis"}]}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", TagBox[RowBox[{"CTensorArray", "[", "metricCTensor", "]"}], Function[BoxForm`e$, MatrixForm[BoxForm`e$]]]}]],"Input",CellTags->"native_metric_data"],

Cell[TextData[{"Alternative \:2014 two native xCoba setups"}],"Subsubsection"],

Cell[TextData[{"In these standalone recipes, cart is a chart basis and mat is the metric matrix. If you already defined the abstract metric g, assign the matrix to it with MetricInBasis."}],"Text"],

Cell["MetricInBasis[g, -cart, mat]","Program",Evaluatable->False],

Cell[TextData[{"If you start with a CTensor, designate it as the metric with SetCMetric. The signature counts three positive, one negative and zero null directions."}],"Text"],

Cell["SetCMetric[CTensor[mat, {-cart,-cart}], cart, SignatureOfMetric -> {3,1,0}]","Program",Evaluatable->False],

Cell[TextData[{"Schwarzschild exterior"}],"Subsection"],

Cell[TextData[{"For a coordinate-dependent metric, supply a function whose arguments follow the chart order. In geometric units Mbh is the black-hole mass and m is the field mass. Restrict the chart to the exterior, r > 2 Mbh."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"DefConstantSymbol", "[", "Mbh", "]"}], ";", "\[IndentingNewLine]", RowBox[{"SetCMetricSystem", "[", RowBox[{"\"Schwarzschild\"", ",", RowBox[{"Function", "[", RowBox[{RowBox[{"{", RowBox[{"t", ",", "r", ",", "theta", ",", "varphi"}], "}"}], ",", RowBox[{"DiagonalMatrix", "[", RowBox[{"{", RowBox[{RowBox[{"-", RowBox[{"(", RowBox[{"1", "-", FractionBox[RowBox[{"2", " ", "Mbh"}], "r"]}], ")"}]}], ",", FractionBox["1", RowBox[{"1", "-", FractionBox[RowBox[{"2", " ", "Mbh"}], "r"]}]], ",", SuperscriptBox["r", "2"], ",", RowBox[{SuperscriptBox["r", "2"], " ", SuperscriptBox[RowBox[{"Sin", "[", "theta", "]"}], "2"]}]}], "}"}], "]"}]}], "]"}], ",", RowBox[{"Assumptions", "\[Rule]", RowBox[{"Function", "[", RowBox[{RowBox[{"{", RowBox[{"t", ",", "r", ",", "theta", ",", "varphi"}], "}"}], ",", RowBox[{"assumptions", "&&", RowBox[{"Mbh", ">", "0"}], "&&", RowBox[{"r", ">", RowBox[{"2", " ", "Mbh"}]}], "&&", RowBox[{"0", "<", "theta", "<", "\[Pi]"}]}]}], "]"}]}]}], "]"}], ";"}]],"Input",CellTags->"schwarzschild_metric"],

Cell[TextData[{"Spatially flat FLRW"}],"Subsection"],

Cell[TextData[{"The scale factor s(t) is positive. Its derivative determines whether the universe expands or contracts."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"DefScalarFunction", "[", "s", "]"}], ";", "\[IndentingNewLine]", RowBox[{"SetCMetricSystem", "[", RowBox[{"\"FLRW\"", ",", RowBox[{"Function", "[", RowBox[{RowBox[{"{", RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "}"}], ",", RowBox[{"DiagonalMatrix", "[", RowBox[{"{", RowBox[{RowBox[{"-", "1"}], ",", SuperscriptBox[RowBox[{"s", "[", "t", "]"}], "2"], ",", SuperscriptBox[RowBox[{"s", "[", "t", "]"}], "2"], ",", SuperscriptBox[RowBox[{"s", "[", "t", "]"}], "2"]}], "}"}], "]"}]}], "]"}], ",", RowBox[{"Assumptions", "\[Rule]", RowBox[{"Function", "[", RowBox[{RowBox[{"{", RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "}"}], ",", RowBox[{"assumptions", "&&", RowBox[{RowBox[{"s", "[", "t", "]"}], ">", "0"}]}]}], "]"}]}]}], "]"}], ";"}]],"Input",CellTags->"flrw_metric"],

Cell[BoxData[RowBox[{"{", RowBox[{TagBox[RowBox[{"ToComponents", "[", RowBox[{"\"Minkowski\"", ",", "\"Metric\""}], "]"}], Function[BoxForm`e$, MatrixForm[BoxForm`e$]]], ",", TagBox[RowBox[{"ToComponents", "[", RowBox[{"\"Schwarzschild\"", ",", "\"Metric\""}], "]"}], Function[BoxForm`e$, MatrixForm[BoxForm`e$]]], ",", TagBox[RowBox[{"ToComponents", "[", RowBox[{"\"FLRW\"", ",", "\"Metric\""}], "]"}], Function[BoxForm`e$, MatrixForm[BoxForm`e$]]]}], "}"}]],"Input",CellTags->"metric_matrices"],

Cell[TextData[{"A general scalar field in Minkowski"}],"Subsection"],

Cell[TextData[{"Assign a general scalar profile on Minkowski. The function receives all four chart coordinates and returns ",StyleBox["PhiM[t,x,y,z]",FontFamily->"Courier",FontSize->11],", printed as \:03c6. Field profiles are local to the selected background."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"DefScalarFunction", "[", RowBox[{"PhiM",",",RowBox[{"PrintAs","\[Rule]","\"\[Phi]\""}]}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"SetFieldComponents", "[", RowBox[{"\"Minkowski\"", ",", "phi", ",", RowBox[{"Function", "[", RowBox[{RowBox[{"{", RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "}"}], ",", RowBox[{"PhiM", "[", RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}]}], "]"}]}], "]"}], ";"}]],"Input",CellTags->"minkowski_field"],

Cell[TextData[{StyleBox["ToComponents",FontFamily->"Courier",FontSize->11]," evaluates the registered equation with the chart, metric and field profile, expanding its covariant derivatives with xCoba."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"eqMink", "=", RowBox[{"ToComponents", "[", RowBox[{"\"Minkowski\"", ",", "\"ScalarEq\""}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"eqMink", "\[Equal]", "0"}]}]],"Input",CellTags->"minkowski_equation"],

Cell[TextData[{"Compare the original derivative orders with fraction notation for the same equation. In native multi-index notation, (2,0,0,0) means two time derivatives. In ",StyleBox["PrettyExp",FontFamily->"Courier",FontSize->11],", ",StyleBox["\"MultiIndex\"",FontFamily->"Courier",FontSize->11]," keeps the orders explicit, ",StyleBox["\"Fraction\"",FontFamily->"Courier",FontSize->11]," gives a quotient and ",StyleBox["\"Partial\"",FontFamily->"Courier",FontSize->11]," uses a partial-derivative operator. ",StyleBox["\"Prime\"",FontFamily->"Courier",FontSize->11]," gives primes for functions of one argument and native notation for other arities."}],"Text"],

Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"PrettyExp", "[", RowBox[{RowBox[{"eqMink", "\[Equal]", "0"}], ",", RowBox[{"PartialStyle", "\[Rule]", "\"Native\""}]}], "]"}], ",", RowBox[{"PrettyExp", "[", RowBox[{RowBox[{"eqMink", "\[Equal]", "0"}], ",", RowBox[{"PartialStyle", "\[Rule]", "\"Fraction\""}]}], "]"}]}], "}"}]],"Input",CellTags->"partial_view"],

Cell[BoxData[RowBox[{RowBox[{"Normal", "[", RowBox[{"PrettyExp", "[", RowBox[{"\"Minkowski\"", ",", RowBox[{"eqMink", "\[Equal]", "0"}]}], "]"}], "]"}], "===", RowBox[{"(", RowBox[{"eqMink", "\[Equal]", "0"}], ")"}]}]],"Input",CellTags->"view_identity"],

Cell[TextData[{StyleBox["Normal",FontFamily->"Courier",FontSize->11]," recovers the underlying equation, which is also retained when the display is copied. To use comma notation throughout Minkowski, set it once with ",StyleBox["SetNotation",FontFamily->"Courier",FontSize->11]," and evaluate ",StyleBox["eqMink",FontFamily->"Courier",FontSize->11]," again. The following cell switches back to fractions."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"SetNotation", "[", RowBox[{"\"Minkowski\"", ",", RowBox[{"PartialStyle", "\[Rule]", "\"Comma\""}]}], "]"}], ";", "\[IndentingNewLine]", "eqMink"}]],"Input",CellTags->"automatic_comma"],

Cell[BoxData[RowBox[{RowBox[{"SetNotation", "[", RowBox[{"\"Minkowski\"", ",", RowBox[{"PartialStyle", "\[Rule]", "\"Fraction\""}]}], "]"}], ";"}]],"Input",CellTags->"automatic_fraction"],

Cell[TextData[{"For abstract covariant derivatives, xAct\:2019s ",StyleBox["$CovDFormat",FontFamily->"Courier",FontSize->11]," selects ",StyleBox["\"Prefix\"",FontFamily->"Courier",FontSize->11]," or ",StyleBox["\"Postfix\"",FontFamily->"Courier",FontSize->11],". To choose the style for one displayed expression, pass ",StyleBox["CovariantStyle",FontFamily->"Courier",FontSize->11]," to ",StyleBox["PrettyExp",FontFamily->"Courier",FontSize->11],". This overrides the background setting for that view."}],"Text"],

Cell[BoxData[RowBox[{"PrettyExp", "[", RowBox[{"\"Schwarzschild\"", ",", "gradPhi", ",", RowBox[{"CovariantStyle", "\[Rule]", "\"Postfix\""}], ",", RowBox[{"ShowBackgroundLabel", "\[Rule]", "True"}]}], "]"}]],"Input",CellTags->"covariant_view"],

Cell[TextData[{"With signature (\:2212,+,+,+), the time and spatial second derivatives enter with opposite signs."}],"Text"],

Cell[BoxData[TagBox[FormBox[RowBox[{RowBox[{RowBox[{"-", TagBox[FractionBox[RowBox[{SuperscriptBox["\[PartialD]", "2"], RowBox[{"\[Phi]", "(", RowBox[{"t", ",", "x", ",", "y", ",", "z"}], ")"}]}], RowBox[{"\[PartialD]", SuperscriptBox["t", "2"]}], MultilineFunction -> None], "InactiveDTraditional"]}], "+", TagBox[FractionBox[RowBox[{SuperscriptBox["\[PartialD]", "2"], RowBox[{"\[Phi]", "(", RowBox[{"t", ",", "x", ",", "y", ",", "z"}], ")"}]}], RowBox[{"\[PartialD]", SuperscriptBox["x", "2"]}], MultilineFunction -> None], "InactiveDTraditional"], "+", TagBox[FractionBox[RowBox[{SuperscriptBox["\[PartialD]", "2"], RowBox[{"\[Phi]", "(", RowBox[{"t", ",", "x", ",", "y", ",", "z"}], ")"}]}], RowBox[{"\[PartialD]", SuperscriptBox["y", "2"]}], MultilineFunction -> None], "InactiveDTraditional"], "+", TagBox[FractionBox[RowBox[{SuperscriptBox["\[PartialD]", "2"], RowBox[{"\[Phi]", "(", RowBox[{"t", ",", "x", ",", "y", ",", "z"}], ")"}]}], RowBox[{"\[PartialD]", SuperscriptBox["z", "2"]}], MultilineFunction -> None], "InactiveDTraditional"], "+", RowBox[{SuperscriptBox["m", "2"], " ", RowBox[{"(", RowBox[{"-", RowBox[{"\[Phi]", "(", RowBox[{"t", ",", "x", ",", "y", ",", "z"}], ")"}]}], ")"}]}]}], "\[LongEqual]", "0"}], TraditionalForm], TraditionalForm, Editable -> True]],"DisplayFormula"],

Cell[TextData[{"Evaluate the registered Lagrangian with the same Minkowski profile."}],"Text"],

Cell[BoxData[RowBox[{"lagMink", "=", RowBox[{"ToComponents", "[", RowBox[{"\"Minkowski\"", ",", "\"Lagrangian\""}], "]"}]}]],"Input",CellTags->"minkowski_lagrangian"],

Cell[TextData[{"A static radial field in Schwarzschild"}],"Subsection"],

Cell[TextData[{"Choose a static radial profile \:03c6 = u(r) on Schwarzschild. Substitution into the scalar equation gives the differential equation that u must satisfy."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"DefScalarFunction", "[", "u", "]"}], ";", "\[IndentingNewLine]", RowBox[{"SetFieldComponents", "[", RowBox[{"\"Schwarzschild\"", ",", "phi", ",", RowBox[{"Function", "[", RowBox[{RowBox[{"{", RowBox[{"t", ",", "r", ",", "theta", ",", "varphi"}], "}"}], ",", RowBox[{"u", "[", "r", "]"}]}], "]"}]}], "]"}], ";"}]],"Input",CellTags->"schwarzschild_field"],

Cell[BoxData[RowBox[{RowBox[{"eqSchw", "=", RowBox[{"ToComponents", "[", RowBox[{"\"Schwarzschild\"", ",", "\"ScalarEq\""}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"eqSchw", "\[Equal]", "0"}]}]],"Input",CellTags->"schwarzschild_equation"],

Cell[TextData[{"The radial equation has the following divergence form."}],"Text"],

Cell[BoxData[TagBox[FormBox[RowBox[{RowBox[{FractionBox[TagBox[TagBox[RowBox[{FractionBox["\[PartialD]", RowBox[{"\[PartialD]", "r"}]], RowBox[{"(", RowBox[{SuperscriptBox["r", "2"], " ", RowBox[{"(", RowBox[{"1", "-", FractionBox[RowBox[{"2", " ", "Mbh"}], "r"]}], ")"}], " ", TagBox[FractionBox[RowBox[{"\[PartialD]", RowBox[{"u", "(", "r", ")"}]}], RowBox[{"\[PartialD]", "r"}], MultilineFunction -> None], "InactiveDTraditional"]}], ")"}]}], D], "InactiveDTraditional"], SuperscriptBox["r", "2"]], "-", RowBox[{SuperscriptBox["m", "2"], " ", RowBox[{"u", "(", "r", ")"}]}]}], "\[LongEqual]", "0"}], TraditionalForm], TraditionalForm, Editable -> True]],"DisplayFormula"],

Cell[TextData[{"Differentiate the divergence form with ",StyleBox["D",FontFamily->"Courier",FontSize->11]," and subtract it from the tensor result. The difference should simplify to zero."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"radialEq", "=", RowBox[{FractionBox[RowBox[{SubscriptBox["\[PartialD]", RowBox[{"rSchw"}]], RowBox[{"(", RowBox[{SuperscriptBox["rSchw", "2"], " ", RowBox[{"(", RowBox[{"1", "-", FractionBox[RowBox[{"2", " ", "Mbh"}], "rSchw"]}], ")"}], " ", RowBox[{SuperscriptBox["u", "\[Prime]", MultilineFunction -> None], "[", "rSchw", "]"}]}], ")"}]}], SuperscriptBox["rSchw", "2"]], "-", RowBox[{SuperscriptBox["m", "2"], " ", RowBox[{"u", "[", "rSchw", "]"}]}]}]}], ";", "\[IndentingNewLine]", RowBox[{"radialCheck", "=", RowBox[{"Simplify", "[", RowBox[{"eqSchw", "-", "radialEq"}], "]"}]}]}]],"Input",CellTags->"schwarzschild_check"],

Cell[TextData[{"Export the radial equation and recover an abstract formula"}],"Subsection"],

Cell[TextData[{StyleBox["TeXForm",FontFamily->"Courier",FontSize->11]," gives the radial equation as LaTeX. For the registered tensor Eab, ",StyleBox["ExpressionText",FontFamily->"Courier",FontSize->11]," can return LaTeX or an evaluable command. The equality below checks that the command recovers ",StyleBox["EabSchw",FontFamily->"Courier",FontSize->11]," in the initialized study."}],"Text"],

Cell[BoxData[RowBox[{"ToString", "[", RowBox[{"TeXForm", "[", RowBox[{"eqSchw", "\[Equal]", "0"}], "]"}], "]"}]],"Input",CellTags->"tex_radial"],

Cell[BoxData[RowBox[{RowBox[{"replayEab", "=", RowBox[{"ExpressionText", "[", RowBox[{"\"Schwarzschild\"", ",", "\"Eab\"", ",", "\"InputForm\""}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"{", RowBox[{"replayEab", ",", RowBox[{RowBox[{"ToExpression", "[", "replayEab", "]"}], "===", "EabSchw"}], ",", RowBox[{RowBox[{"StringLength", "[", RowBox[{"ExpressionText", "[", RowBox[{"\"Schwarzschild\"", ",", "\"Eab\"", ",", "\"TeX\""}], "]"}], "]"}], ">", "0"}]}], "}"}]}]],"Input",CellTags->"document_formula"],

Cell[TextData[{"With TexAct installed, choose ",StyleBox["\"TexAct\"",FontFamily->"Courier",FontSize->11]," in ",StyleBox["ExpressionText",FontFamily->"Courier",FontSize->11]," for its tensor-specific LaTeX notation. To reproduce the calculation in another kernel, supply the notebook and its matching package."}],"Text"],

Cell[TextData[{"Curvature of the Schwarzschild exterior"}],"Subsection"],

Cell[TextData[{"In the Schwarzschild exterior the Ricci scalar vanishes, while the Kretschmann invariant is 48 Mbh\:00b2/r\:2076. The latter detects curvature even in vacuum."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"ricciSchw", "=", RowBox[{"ToComponents", "[", RowBox[{"\"Schwarzschild\"", ",", RowBox[{RowBox[{"RicciScalar", "[", "CD", "]"}], "[", "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"kretschmannSchw", "=", RowBox[{"ToComponents", "[", RowBox[{"\"Schwarzschild\"", ",", RowBox[{RowBox[{"Kretschmann", "[", "CD", "]"}], "[", "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"{", RowBox[{"ricciSchw", ",", "kretschmannSchw"}], "}"}]}]],"Input",CellTags->"schwarzschild_curvature"],

Cell[TextData[{"For component values of a specified metric, this calculation uses xCoba. For symbolic identities among curvature scalars, the separate Invar package provides a database of abstract contractions."}],"Tip"],

Cell[TextData[{"A homogeneous scalar in FLRW"}],"Subsection"],

Cell[TextData[{"Choose a homogeneous field \:03c6 = q(t) on FLRW."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"DefScalarFunction", "[", "q", "]"}], ";", "\[IndentingNewLine]", RowBox[{"SetFieldComponents", "[", RowBox[{"\"FLRW\"", ",", "phi", ",", RowBox[{"Function", "[", RowBox[{RowBox[{"{", RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "}"}], ",", RowBox[{"q", "[", "t", "]"}]}], "]"}]}], "]"}], ";"}]],"Input",CellTags->"flrw_field"],

Cell[BoxData[RowBox[{RowBox[{"eqFLRW", "=", RowBox[{"ToComponents", "[", RowBox[{"\"FLRW\"", ",", "\"ScalarEq\""}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"eqFLRW", "\[Equal]", "0"}]}]],"Input",CellTags->"flrw_equation"],

Cell[TextData[{"Multiplying the computed equation by \:22121 gives the usual cosmological form."}],"Text"],

Cell[BoxData[TagBox[FormBox[RowBox[{RowBox[{RowBox[{SuperscriptBox["m", "2"], " ", RowBox[{"q", "(", "t", ")"}]}], "+", RowBox[{SuperscriptBox["q", "\[Prime]\[Prime]", MultilineFunction -> None], "(", "t", ")"}], "+", FractionBox[RowBox[{"3", " ", RowBox[{SuperscriptBox["q", "\[Prime]", MultilineFunction -> None], "(", "t", ")"}], " ", RowBox[{SuperscriptBox["s", "\[Prime]", MultilineFunction -> None], "(", "t", ")"}]}], RowBox[{"s", "(", "t", ")"}]]}], "\[LongEqual]", "0"}], TraditionalForm], TraditionalForm, Editable -> True]],"DisplayFormula"],

Cell[TextData[{"The connection contributes the term proportional to the expansion rate s\:2032/s. Evaluate the homogeneous scalar Lagrangian and the time-time Einstein component. Chart positions start at zero, so ",StyleBox["Components -> {{0,0}}",FontFamily->"Courier",FontSize->11]," selects that single entry."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"einstein00", "=", RowBox[{"First", "[", RowBox[{"ToComponents", "[", RowBox[{"\"FLRW\"", ",", RowBox[{RowBox[{"Einstein", "[", "CD", "]"}], "[", RowBox[{RowBox[{"-", "a"}], ",", RowBox[{"-", "b"}]}], "]"}], ",", RowBox[{"Components", "\[Rule]", RowBox[{"{", RowBox[{"{", RowBox[{"0", ",", "0"}], "}"}], "}"}]}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"lagFLRW", "=", RowBox[{"ToComponents", "[", RowBox[{"\"FLRW\"", ",", "\"Lagrangian\""}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"{", RowBox[{"einstein00", ",", "lagFLRW"}], "}"}]}]],"Input",CellTags->"flrw_geometry"],

Cell[TextData[{"Checking a solution"}],"Subsection"],

Cell[TextData[{"Test a plane wave on Minkowski. Evaluate the scalar equation on the new profile, then use Wolfram\:2019s ",StyleBox["Simplify",FontFamily->"Courier",FontSize->11]," with the dispersion relation \:03c9\:00b2 = k\:00b2 + m\:00b2."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"DefConstantSymbol", "[", "omega", "]"}], ";", "\[IndentingNewLine]", RowBox[{"DefConstantSymbol", "[", "k", "]"}], ";", "\[IndentingNewLine]", RowBox[{"SetFieldComponents", "[", RowBox[{"\"Minkowski\"", ",", "phi", ",", RowBox[{"Function", "[", RowBox[{RowBox[{"{", RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "}"}], ",", RowBox[{"Cos", "[", RowBox[{RowBox[{"omega", " ", "t"}], "-", RowBox[{"k", " ", "z"}]}], "]"}]}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"waveResidual", "=", RowBox[{"ToComponents", "[", RowBox[{"\"Minkowski\"", ",", "\"ScalarEq\""}], "]"}]}], ";", "\[IndentingNewLine]", "waveResidual"}]],"Input",CellTags->"plane_wave"],

Cell[BoxData[RowBox[{"onShell", "=", RowBox[{"Simplify", "[", RowBox[{"waveResidual", ",", RowBox[{"Assumptions", "\[Rule]", RowBox[{"assumptions", "&&", RowBox[{RowBox[{"{", RowBox[{"omega", ",", "k"}], "}"}], "\[Element]", TemplateBox[{}, "Reals"]}], "&&", RowBox[{SuperscriptBox["omega", "2"], "\[Equal]", RowBox[{SuperscriptBox["k", "2"], "+", SuperscriptBox["m", "2"]}]}]}]}]}], "]"}]}]],"Input",CellTags->"dispersion_condition"],

Cell[TextData[{"A zero residual verifies the plane wave for the stated dispersion relation."}],"Text"],

Cell[TextData[{"Named profiles on one geometry"}],"Subsection"],

Cell[TextData[{"RegisterProfile saves field inputs without changing the calculation; repeated calls for one name add field/order entries. ActivateProfile overlays the stored entries on the current field inputs, preserving the others. The geometry is reused. Here the wave profile is saved, a radial profile gives the wave operator 4, and the wave is restored."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"RegisterProfile", "[", RowBox[{"\"Minkowski\"", ",", "\"PlaneWave\""}], "]"}], ";", RowBox[{"RegisterProfile", "[", RowBox[{"\"Minkowski\"", ",", "\"Radial\"", ",", "phi", ",", RowBox[{"Function", "[", RowBox[{RowBox[{"{", RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "}"}], ",", RowBox[{SuperscriptBox["x", "2"], "+", SuperscriptBox["y", "2"]}]}], "]"}]}], "]"}], ";", RowBox[{"ActivateProfile", "[", RowBox[{"\"Minkowski\"", ",", "\"Radial\""}], "]"}], ";", RowBox[{"profileBox", "=", RowBox[{"ToComponents", "[", RowBox[{"\"Minkowski\"", ",", "boxPhi"}], "]"}]}], ";", RowBox[{"ActivateProfile", "[", RowBox[{"\"Minkowski\"", ",", "\"PlaneWave\""}], "]"}], ";", RowBox[{"{", RowBox[{RowBox[{"Keys", "[", RowBox[{"ShowProfiles", "[", "\"Minkowski\"", "]"}], "]"}], ",", "profileBox", ",", RowBox[{RowBox[{"ToComponents", "[", RowBox[{"\"Minkowski\"", ",", RowBox[{"phi", "[", "]"}]}], "]"}], "===", RowBox[{"Cos", "[", RowBox[{RowBox[{"omega", " ", "tM"}], "-", RowBox[{"k", " ", "zM"}]}], "]"}]}]}], "}"}]}]],"Input",CellTags->"named_profiles"],

Cell[TextData[{"One Minkowski metric, two coordinate charts"}],"Subsection"],

Cell[TextData[{"Add cylindrical coordinates to the existing Minkowski background. Supply the primary Cartesian coordinates as functions of the new ones, in the order (t, r cos \:03b8, r sin \:03b8, z). The map applies on r > 0 within one angular patch."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"DefineChart", "[", RowBox[{"\"Minkowski\"", ",", "\"Cylindrical\"", ",", RowBox[{"{", RowBox[{"\"t\"", ",", "\"r\"", ",", "\"theta\"", ",", "\"z\""}], "}"}], ",", RowBox[{"Function", "[", RowBox[{RowBox[{"{", RowBox[{"t", ",", "r", ",", "theta", ",", "z"}], "}"}], ",", RowBox[{"{", RowBox[{"t", ",", RowBox[{"r", " ", RowBox[{"Cos", "[", "theta", "]"}]}], ",", RowBox[{"r", " ", RowBox[{"Sin", "[", "theta", "]"}]}], ",", "z"}], "}"}]}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", RowBox[{RowBox[{"{", RowBox[{"tCyl", ",", "rCyl", ",", "thetaCyl", ",", "zCyl"}], "}"}], "=", RowBox[{"Through", "[", RowBox[{RowBox[{"CoordinatesOf", "[", RowBox[{"\"Minkowski\"", ",", "\"Cylindrical\""}], "]"}], "[", "]"}], "]"}]}], ";"}]],"Input",CellTags->"second_chart"],

Cell[TextData[{"Request both matrices for the same metric. The angular entry in the cylindrical chart is r\:00b2."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"gCyl", "=", RowBox[{"ToComponents", "[", RowBox[{"\"Minkowski\"", ",", RowBox[{"g", "[", RowBox[{RowBox[{"-", "a"}], ",", RowBox[{"-", "b"}]}], "]"}], ",", RowBox[{"OutputChart", "\[Rule]", "\"Cylindrical\""}]}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"{", RowBox[{TagBox[RowBox[{"MetricMatrixOf", "[", "\"Minkowski\"", "]"}], Function[BoxForm`e$, MatrixForm[BoxForm`e$]]], ",", TagBox["gCyl", Function[BoxForm`e$, MatrixForm[BoxForm`e$]]]}], "}"}]}]],"Input",CellTags->"two_metric_charts"],

Cell[TextData[{"The table gives the correspondence between zero-based component numbers and one-based Mathematica list positions."}],"Text"],

Cell[BoxData[RowBox[{"Grid", "[", RowBox[{RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"\"Cylindrical coordinate\"", ",", "\"t\"", ",", "\"r\"", ",", "\"theta\"", ",", "\"z\""}], "}"}], ",", RowBox[{"{", RowBox[{"\"xCoba component number\"", ",", "0", ",", "1", ",", "2", ",", "3"}], "}"}], ",", RowBox[{"{", RowBox[{"\"Mathematica list position\"", ",", "1", ",", "2", ",", "3", ",", "4"}], "}"}]}], "}"}], ",", RowBox[{"Frame", "\[Rule]", "All"}]}], "]"}]],"Input",CellTags->"chart_positions"],

Cell[TextData[{"Read the radial coefficient with lower indices (\:03b8,\:03b8) and the angular coefficient with lower indices (r,\:03b8). The second derivatives of the coordinate map give \:2212r and 1/r, respectively, even in flat spacetime."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"gammaCyl", "=", RowBox[{"ConnectionMatrixOf", "[", RowBox[{"\"Minkowski\"", ",", "CD", ",", RowBox[{"OutputChart", "\[Rule]", "\"Cylindrical\""}]}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"{", RowBox[{RowBox[{"gammaCyl", "\[LeftDoubleBracket]", RowBox[{"2", ",", "3", ",", "3"}], "\[RightDoubleBracket]"}], ",", RowBox[{"gammaCyl", "\[LeftDoubleBracket]", RowBox[{"3", ",", "2", ",", "3"}], "\[RightDoubleBracket]"}]}], "}"}]}]],"Input",CellTags->"cylindrical_connection"],

Cell[TextData[{"Set \:03c6 = x\:00b2 + y\:00b2 in the primary chart. In cylindrical coordinates this is r\:00b2. Its angular Hessian component is 2r\:00b2 because the Levi-Civita connection acts on the gradient."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"SetFieldComponents", "[", RowBox[{"\"Minkowski\"", ",", "phi", ",", RowBox[{SuperscriptBox["xM", "2"], "+", SuperscriptBox["yM", "2"]}]}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"phiCyl", "=", RowBox[{"ToComponents", "[", RowBox[{"\"Minkowski\"", ",", RowBox[{"phi", "[", "]"}], ",", RowBox[{"OutputChart", "\[Rule]", "\"Cylindrical\""}]}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"hessCyl", "=", RowBox[{"ToComponents", "[", RowBox[{"\"Minkowski\"", ",", "\"Hessian\"", ",", RowBox[{"OutputChart", "\[Rule]", "\"Cylindrical\""}], ",", RowBox[{"FreeIndices", "\[Rule]", RowBox[{"{", RowBox[{RowBox[{"-", "a"}], ",", RowBox[{"-", "b"}]}], "}"}]}], ",", RowBox[{"Components", "\[Rule]", RowBox[{"{", RowBox[{"{", RowBox[{"2", ",", "2"}], "}"}], "}"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"{", RowBox[{"phiCyl", ",", "hessCyl"}], "}"}]}]],"Input",CellTags->"two_hessian_charts"],

Cell[TextData[{"Compare the Cartesian wave operator with the trace of the cylindrical Hessian. In cylindrical coordinates the radial and angular terms each contribute 2, giving 4 in either chart."}],"Text"],

Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"ToComponents", "[", RowBox[{"\"Minkowski\"", ",", "boxPhi"}], "]"}], ",", RowBox[{"Simplify", "[", RowBox[{"Tr", "[", RowBox[{TemplateBox[{"gCyl"}, "Inverse", SyntaxForm -> SuperscriptBox], ".", RowBox[{"ToComponents", "[", RowBox[{"\"Minkowski\"", ",", "\"Hessian\"", ",", RowBox[{"OutputChart", "\[Rule]", "\"Cylindrical\""}]}], "]"}]}], "]"}], "]"}]}], "}"}]],"Input",CellTags->"trace_both"],

Cell[TextData[{"With ",StyleBox["ApplySpecialization -> False",FontFamily->"Courier",FontSize->11],", the angular component of Eab includes its mass term even when a massless rule is active. Store the component before restoring the plane-wave profile."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"eabCyl", "=", RowBox[{"ToComponents", "[", RowBox[{"\"Minkowski\"", ",", "EabM", ",", RowBox[{"OutputChart", "\[Rule]", "\"Cylindrical\""}], ",", RowBox[{"FreeIndices", "\[Rule]", RowBox[{"{", RowBox[{RowBox[{"-", "a"}], ",", RowBox[{"-", "b"}]}], "}"}]}], ",", RowBox[{"Components", "\[Rule]", RowBox[{"{", RowBox[{"{", RowBox[{"2", ",", "2"}], "}"}], "}"}]}], ",", RowBox[{"ApplySpecialization", "\[Rule]", "False"}]}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"SetFieldComponents", "[", RowBox[{"\"Minkowski\"", ",", "phi", ",", RowBox[{"Function", "[", RowBox[{RowBox[{"{", RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "}"}], ",", RowBox[{"Cos", "[", RowBox[{RowBox[{"omega", " ", "t"}], "-", RowBox[{"k", " ", "z"}]}], "]"}]}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", "eabCyl"}]],"Input",CellTags->"general_cyl_equation"],

Cell[TextData[{"For the radial profile the angular component is 2r\:00b2 + m\:00b2r\:2074."}],"Text"]
},Open]],

Cell[CellGroupData[{
Cell[TextData[{"6. Extend the theory with vectors, tensors and a connection"}],"Section"],

Cell[TextData[{"Define a covector A, a symmetric tensor S and a two-form F on the source manifold, then register them together. xPlorer obtains their slots and symmetries from the native definitions. These three fields are independent in this example."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"DefTensor", "[", RowBox[{RowBox[{"A", "[", RowBox[{"-", "a"}], "]"}], ",", "M"}], "]"}], ";", RowBox[{"DefTensor", "[", RowBox[{RowBox[{"S", "[", RowBox[{RowBox[{"-", "a"}], ",", RowBox[{"-", "b"}]}], "]"}], ",", "M", ",", RowBox[{"Symmetric", "[", RowBox[{"{", RowBox[{RowBox[{"-", "a"}], ",", RowBox[{"-", "b"}]}], "}"}], "]"}]}], "]"}], ";", RowBox[{"DefTensor", "[", RowBox[{RowBox[{"F", "[", RowBox[{RowBox[{"-", "a"}], ",", RowBox[{"-", "b"}]}], "]"}], ",", "M", ",", RowBox[{"Antisymmetric", "[", RowBox[{"{", RowBox[{RowBox[{"-", "a"}], ",", RowBox[{"-", "b"}]}], "}"}], "]"}]}], "]"}], ";", RowBox[{"RegisterTheory", "[", RowBox[{"\"Fields\"", ",", RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"A", ",", RowBox[{"Sector", "\[Rule]", "\"Vector\""}]}], "}"}], ",", "S", ",", RowBox[{"{", RowBox[{"F", ",", RowBox[{"Sector", "\[Rule]", "\"Vector\""}]}], "}"}]}], "}"}]}], "]"}], ";"}]],"Input",CellTags->"extra_fields"],

Cell[TextData[{"The uppercase S denotes the symmetric tensor. To register it on its own, use ",StyleBox["RegisterTheory[\"Field\", S]",FontFamily->"Courier",FontSize->11],"."}],"Text"],

Cell[TextData[{"Create a new Minkowski study from the extended theory. Compare its field keys with those in the original scalar-only background."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"CreateBackground", "[", "\"MinkowskiFields\"", "]"}], ";", "\[IndentingNewLine]", RowBox[{"DefineChart", "[", RowBox[{"\"MinkowskiFields\"", ",", RowBox[{"{", RowBox[{"\"t\"", ",", "\"x\"", ",", "\"y\"", ",", "\"z\""}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"SetCMetricSystem", "[", RowBox[{"\"MinkowskiFields\"", ",", RowBox[{"DiagonalMatrix", "[", RowBox[{"{", RowBox[{RowBox[{"-", "1"}], ",", "1", ",", "1", ",", "1"}], "}"}], "]"}]}], "]"}], ";"}]],"Input",CellTags->"field_background"],

Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"Keys", "[", RowBox[{RowBox[{"ShowBackground", "[", "\"Minkowski\"", "]"}], "[", "\"Field\"", "]"}], "]"}], ",", RowBox[{"Keys", "[", RowBox[{RowBox[{"ShowBackground", "[", "\"MinkowskiFields\"", "]"}], "[", "\"Field\"", "]"}], "]"}]}], "}"}]],"Input",CellTags->"field_snapshots"],

Cell[TextData[{"Assign the lower components of A in chart order (t,x,y,z) with ",StyleBox["IndexPositions -> {-1}",FontFamily->"Courier",FontSize->11],". Requesting ",StyleBox["A[a]",FontFamily->"Courier",FontSize->11]," raises the index with the Minkowski metric, changing the sign of the time component."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"SetFieldComponents", "[", RowBox[{"\"MinkowskiFields\"", ",", "A", ",", RowBox[{"{", RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "}"}], ",", RowBox[{"IndexPositions", "\[Rule]", RowBox[{"{", RowBox[{"-", "1"}], "}"}]}]}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"Adown", "=", RowBox[{"ToComponents", "[", RowBox[{"\"MinkowskiFields\"", ",", RowBox[{"A", "[", RowBox[{"-", "a"}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"Aup", "=", RowBox[{"ToComponents", "[", RowBox[{"\"MinkowskiFields\"", ",", RowBox[{"A", "[", "a", "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"normA", "=", RowBox[{"ToComponents", "[", RowBox[{"\"MinkowskiFields\"", ",", RowBox[{RowBox[{"A", "[", "a", "]"}], " ", RowBox[{"A", "[", RowBox[{"-", "a"}], "]"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"{", RowBox[{"Adown", ",", "Aup", ",", "normA"}], "}"}]}]],"Input",CellTags->"vector_values"],

Cell[TextData[{"For further native xCoba work, request Output -> \"CTensor\" to retain the basis and the variance of every tensor slot. The ordinary array remains the default. Native DefBasis, SetBasisChange, ToBasis and ToCTensor can be used on the owned xAct objects; see Tests/15_NativeInterop.wl and Examples/NativeXCoba.wl for a separate workflow. Native assignments do not automatically synchronize the managed registry."}],"Text"],

Cell[BoxData[RowBox[{"ctA", "=", RowBox[{"ToComponents", "[", RowBox[{"\"MinkowskiFields\"", ",", RowBox[{"A", "[", "a", "]"}], ",", RowBox[{"Output", "\[Rule]", "\"CTensor\""}]}], "]"}]}]],"Input",CellTags->"ctensor_output"],

Cell[TextData[{"The contraction is \:22121 + 4 + 9 + 16 = 28. To retrieve the same covector with its abstract lower index, use ",StyleBox["PortExpression",FontFamily->"Courier",FontSize->11],"."}],"Text"],

Cell[BoxData[RowBox[{"PortExpression", "[", RowBox[{"\"MinkowskiFields\"", ",", RowBox[{"A", "[", RowBox[{"-", "a"}], "]"}]}], "]"}]],"Input",CellTags->"formal_vector"],

Cell[TextData[{"Assign matrices with the declared rank and symmetry. xPlorer checks both when it stores the components."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"Fmatrix", "=", RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"0", ",", "2", ",", "0", ",", "0"}], "}"}], ",", RowBox[{"{", RowBox[{RowBox[{"-", "2"}], ",", "0", ",", "0", ",", "0"}], "}"}], ",", RowBox[{"{", RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}], ",", RowBox[{"{", RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}]}], "}"}]}], ";", "\[IndentingNewLine]", RowBox[{"SetFieldComponents", "[", RowBox[{"\"MinkowskiFields\"", ",", "S", ",", RowBox[{"DiagonalMatrix", "[", RowBox[{"{", RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"SetFieldComponents", "[", RowBox[{"\"MinkowskiFields\"", ",", "F", ",", "Fmatrix"}], "]"}], ";", "\[IndentingNewLine]", TagBox[RowBox[{"ToComponents", "[", RowBox[{"\"MinkowskiFields\"", ",", RowBox[{"S", "[", RowBox[{RowBox[{"-", "a"}], ",", RowBox[{"-", "b"}]}], "]"}]}], "]"}], Function[BoxForm`e$, MatrixForm[BoxForm`e$]]]}]],"Input",CellTags->"tensor_values"],

Cell[TextData[{StyleBox["FreeIndices",FontFamily->"Courier",FontSize->11]," fixes the order of the array axes. Reversing the free indices transposes the matrix. ",StyleBox["Components",FontFamily->"Courier",FontSize->11]," selects individual entries. In the original order, F has entries 2 at (0,1) and \:22122 at (1,0)."}],"Text"],

Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"ToComponents", "[", RowBox[{"\"MinkowskiFields\"", ",", RowBox[{"F", "[", RowBox[{RowBox[{"-", "a"}], ",", RowBox[{"-", "b"}]}], "]"}], ",", RowBox[{"FreeIndices", "\[Rule]", RowBox[{"{", RowBox[{RowBox[{"-", "b"}], ",", RowBox[{"-", "a"}]}], "}"}]}]}], "]"}], ",", RowBox[{"ToComponents", "[", RowBox[{"\"MinkowskiFields\"", ",", RowBox[{"F", "[", RowBox[{RowBox[{"-", "a"}], ",", RowBox[{"-", "b"}]}], "]"}], ",", RowBox[{"Components", "\[Rule]", RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"0", ",", "1"}], "}"}], ",", RowBox[{"{", RowBox[{"1", ",", "0"}], "}"}]}], "}"}]}]}], "]"}]}], "}"}]],"Input",CellTags->"tensor_selection"],

Cell[TextData[{"An independent covariant derivative"}],"Subsection"],

Cell[TextData[{"Define an independent covariant derivative DA on the source manifold using the source index a. ",StyleBox["Torsion -> True",FontFamily->"Courier",FontSize->11]," allows torsion. Register DA as a connection so that ",StyleBox["CreateBackground",FontFamily->"Courier",FontSize->11]," copies it to the new study."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"DefCovD", "[", RowBox[{RowBox[{"DA", "[", RowBox[{"-", "a"}], "]"}], ",", RowBox[{"{", "}"}], ",", RowBox[{"SymbolOfCovD", "\[Rule]", RowBox[{"{", RowBox[{"\"|\"", ",", "\"D\""}], "}"}]}], ",", RowBox[{"Torsion", "\[Rule]", "True"}]}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"RegisterTheory", "[", RowBox[{"\"Connection\"", ",", "\"Affine\"", ",", "DA"}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"CreateBackground", "[", "\"AffineStudy\"", "]"}], ";", "\[IndentingNewLine]", RowBox[{"ConnectionsOf", "[", "\"AffineStudy\"", "]"}]}]],"Input",CellTags->"register_affine"],

Cell[TextData[{"The default connection is the metric\:2019s Levi-Civita derivative, keyed by ",StyleBox["\"Primary\"",FontFamily->"Courier",FontSize->11],". Select DA explicitly to obtain its derivative and Riemann tensor. Its curvature family also has a Ricci tensor. A native Ricci scalar requires an associated metric, and requesting one for DA returns a Failure."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{RowBox[{"{", RowBox[{"aDA", ",", "bDA", ",", "cDA", ",", "dDA"}], "}"}], "=", RowBox[{"BackgroundIndices", "[", RowBox[{"\"AffineStudy\"", ",", "4"}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"{", RowBox[{RowBox[{RowBox[{RowBox[{"ConnectionOf", "[", RowBox[{"\"AffineStudy\"", ",", "DA"}], "]"}], "[", RowBox[{"-", "aDA"}], "]"}], "[", RowBox[{RowBox[{"BackgroundObject", "[", RowBox[{"\"AffineStudy\"", ",", "\"phi\""}], "]"}], "[", "]"}], "]"}], ",", RowBox[{RowBox[{"RiemannOf", "[", RowBox[{"\"AffineStudy\"", ",", "DA"}], "]"}], "[", RowBox[{RowBox[{"-", "aDA"}], ",", RowBox[{"-", "bDA"}], ",", RowBox[{"-", "cDA"}], ",", "dDA"}], "]"}]}], "}"}]}]],"Input",CellTags->"formal_affine"],

Cell[TextData[{"Supply the independent connection coefficients in the order {upper output, lower derivative, lower input}. The assignment below sets a single coefficient, \:0393 with upper index t and lower indices (x,t), equal to t, in the Cartesian chart. You can also supply the difference from the metric connection using ",StyleBox["ReferenceConnection -> \"Primary\"",FontFamily->"Courier",FontSize->11],"."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"DefineChart", "[", RowBox[{"\"AffineStudy\"", ",", RowBox[{"{", RowBox[{"\"t\"", ",", "\"x\"", ",", "\"y\"", ",", "\"z\""}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"SetCMetricSystem", "[", RowBox[{"\"AffineStudy\"", ",", RowBox[{"DiagonalMatrix", "[", RowBox[{"{", RowBox[{RowBox[{"-", "1"}], ",", "1", ",", "1", ",", "1"}], "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"SetFieldComponents", "[", RowBox[{"\"AffineStudy\"", ",", "A", ",", RowBox[{"{", RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", RowBox[{RowBox[{"{", RowBox[{"tA", ",", "xA", ",", "yA", ",", "zA"}], "}"}], "=", RowBox[{"Through", "[", RowBox[{RowBox[{"CoordinatesOf", "[", "\"AffineStudy\"", "]"}], "[", "]"}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"gammaDA", "=", RowBox[{"ConstantArray", "[", RowBox[{"0", ",", RowBox[{"{", RowBox[{"4", ",", "4", ",", "4"}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{RowBox[{"gammaDA", "\[LeftDoubleBracket]", RowBox[{"1", ",", "2", ",", "1"}], "\[RightDoubleBracket]"}], "=", "tA"}], ";", "\[IndentingNewLine]", RowBox[{"SetConnectionComponents", "[", RowBox[{"\"AffineStudy\"", ",", "\"Affine\"", ",", "gammaDA"}], "]"}], ";"}]],"Input",CellTags->"affine_coordinates"],

Cell[TextData[{"For this constant covector, the coefficient contributes \:2212t to the x derivative of its time component. Compute the derivative matrix and one curvature component. The latter\:2019s sign follows xAct\:2019s ",StyleBox["$RiemannSign",FontFamily->"Courier",FontSize->11]," convention."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"gradA", "=", RowBox[{"ToComponents", "[", RowBox[{"\"AffineStudy\"", ",", RowBox[{RowBox[{"DA", "[", RowBox[{"-", "a"}], "]"}], "[", RowBox[{"A", "[", RowBox[{"-", "b"}], "]"}], "]"}], ",", RowBox[{"FreeIndices", "\[Rule]", RowBox[{"{", RowBox[{RowBox[{"-", "a"}], ",", RowBox[{"-", "b"}]}], "}"}]}], ",", RowBox[{"StrictComponents", "\[Rule]", "True"}]}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"riemannDA", "=", RowBox[{"First", "[", RowBox[{"ToComponents", "[", RowBox[{"\"AffineStudy\"", ",", RowBox[{RowBox[{"Riemann", "[", "DA", "]"}], "[", RowBox[{RowBox[{"-", "a"}], ",", RowBox[{"-", "b"}], ",", RowBox[{"-", "c"}], ",", "d"}], "]"}], ",", RowBox[{"FreeIndices", "\[Rule]", RowBox[{"{", RowBox[{RowBox[{"-", "a"}], ",", RowBox[{"-", "b"}], ",", RowBox[{"-", "c"}], ",", "d"}], "}"}]}], ",", RowBox[{"Components", "\[Rule]", RowBox[{"{", RowBox[{"{", RowBox[{"0", ",", "1", ",", "0", ",", "0"}], "}"}], "}"}]}], ",", RowBox[{"StrictComponents", "\[Rule]", "True"}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"{", RowBox[{TagBox["gradA", Function[BoxForm`e$, MatrixForm[BoxForm`e$]]], ",", "riemannDA"}], "}"}]}]],"Input",CellTags->"affine_results"],

Cell[TextData[{"Compare the same (x,t) entry using CD and DA. The Levi-Civita derivative gives zero for these Cartesian data. ",StyleBox["CheckConnection",FontFamily->"Courier",FontSize->11]," reports the torsion and metric-compatibility residuals for DA."}],"Text"],

Cell[BoxData[RowBox[{"Grid", "[", RowBox[{RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"\"Connection\"", ",", "\"x,t component\""}], "}"}], ",", RowBox[{"{", RowBox[{"\"CD\"", ",", RowBox[{"First", "[", RowBox[{"ToComponents", "[", RowBox[{"\"AffineStudy\"", ",", RowBox[{RowBox[{"CD", "[", RowBox[{"-", "a"}], "]"}], "[", RowBox[{"A", "[", RowBox[{"-", "b"}], "]"}], "]"}], ",", RowBox[{"FreeIndices", "\[Rule]", RowBox[{"{", RowBox[{RowBox[{"-", "a"}], ",", RowBox[{"-", "b"}]}], "}"}]}], ",", RowBox[{"Components", "\[Rule]", RowBox[{"{", RowBox[{"{", RowBox[{"1", ",", "0"}], "}"}], "}"}]}]}], "]"}], "]"}]}], "}"}], ",", RowBox[{"{", RowBox[{"\"DA\"", ",", RowBox[{"First", "[", RowBox[{"ToComponents", "[", RowBox[{"\"AffineStudy\"", ",", RowBox[{RowBox[{"DA", "[", RowBox[{"-", "a"}], "]"}], "[", RowBox[{"A", "[", RowBox[{"-", "b"}], "]"}], "]"}], ",", RowBox[{"FreeIndices", "\[Rule]", RowBox[{"{", RowBox[{RowBox[{"-", "a"}], ",", RowBox[{"-", "b"}]}], "}"}]}], ",", RowBox[{"Components", "\[Rule]", RowBox[{"{", RowBox[{"{", RowBox[{"1", ",", "0"}], "}"}], "}"}]}]}], "]"}], "]"}]}], "}"}]}], "}"}], ",", RowBox[{"Frame", "\[Rule]", "All"}]}], "]"}]],"Input",CellTags->"compare_affine_component"],

Cell[BoxData[RowBox[{"CheckConnection", "[", RowBox[{"\"AffineStudy\"", ",", "\"Affine\""}], "]"}]],"Input",CellTags->"affine_checks"],

Cell[TextData[{StyleBox["ConnectionDifference",FontFamily->"Courier",FontSize->11]," gives the difference tensor for the two connections. Use ",StyleBox["AddConnection",FontFamily->"Courier",FontSize->11]," when the target background already exists."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"diffDA", "=", RowBox[{"ConnectionDifference", "[", RowBox[{"\"AffineStudy\"", ",", "\"Affine\"", ",", "\"Primary\""}], "]"}]}], ";", "\[IndentingNewLine]", "diffDA"}]],"Input",CellTags->"affine_difference"],

Cell[TextData[{"Inspect the manifolds of DA and its copy. In a formula the derivative head selects the connection. ",StyleBox["ComputeGeometry",FontFamily->"Courier",FontSize->11]," calculates the geometry of the metric connection."}],"Text"],

Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"ManifoldOfCovD", "[", "DA", "]"}], ",", RowBox[{"ManifoldOfCovD", "[", RowBox[{"ConnectionOf", "[", RowBox[{"\"AffineStudy\"", ",", "DA"}], "]"}], "]"}], ",", RowBox[{RowBox[{"ConnectionDifference", "[", RowBox[{"\"AffineStudy\"", ",", "DA", ",", "CD"}], "]"}], "===", "diffDA"}]}], "}"}]],"Input",CellTags->"compare_derivatives"],

Cell[TextData[{"Unregister DA to omit it from future backgrounds. Its source definition and the existing affine study remain available."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"UnregisterTheory", "[", "\"Connections\"", "]"}], ";"}]],"Input",CellTags->"unregister_affine"],

Cell[TextData[{"Use ",StyleBox["StrictComponents -> True",FontFamily->"Courier",FontSize->11]," when every requested component must be explicit. An unresolved component then returns a Failure."}],"Tip"]
},Open]],

Cell[CellGroupData[{
Cell[TextData[{"7. Change a calculation and reuse previous work"}],"Section"],

Cell[TextData[{"To change a profile or metric in an existing study, call ",StyleBox["SetFieldComponents",FontFamily->"Courier",FontSize->11]," or ",StyleBox["SetCMetricSystem",FontFamily->"Courier",FontSize->11]," again with the new input."}],"Text"],

Cell[TextData[{"Request the Ricci and Einstein tensors twice. With the same metric and settings, the second call reports both as cached."}],"Text"],

Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"ComputeGeometry", "[", RowBox[{"\"MinkowskiFields\"", ",", RowBox[{"{", RowBox[{"\"Ricci\"", ",", "\"Einstein\""}], "}"}]}], "]"}], ",", RowBox[{"ComputeGeometry", "[", RowBox[{"\"MinkowskiFields\"", ",", RowBox[{"{", RowBox[{"\"Ricci\"", ",", "\"Einstein\""}], "}"}]}], "]"}]}], "}"}]],"Input",CellTags->"geometry_reuse"],

Cell[TextData[{StyleBox["SaveResult",FontFamily->"Courier",FontSize->11]," stores a value under a key and ",StyleBox["ResultOf",FontFamily->"Courier",FontSize->11]," retrieves it. Changing a printed label preserves saved results. Changing a mathematical input invalidates all saved results in that study."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"SaveResult", "[", RowBox[{"\"MinkowskiFields\"", ",", "\"VectorNorm\"", ",", "normA"}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"SetPresentation", "[", RowBox[{"\"MinkowskiFields\"", ",", "A", ",", RowBox[{"PrintAs", "\[Rule]", "\"V\""}]}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"ResultOf", "[", RowBox[{"\"MinkowskiFields\"", ",", "\"VectorNorm\""}], "]"}]}]],"Input",CellTags->"save_result"],

Cell[BoxData[RowBox[{RowBox[{"SetPresentation", "[", RowBox[{"\"MinkowskiFields\"", ",", "A", ",", RowBox[{"PrintAs", "\[Rule]", "Automatic"}]}], "]"}], ";"}]],"Input",CellTags->"reset_vector_label"],

Cell[TextData[{"Change the metric\:2019s time-time entry to \:22124. The covector still has lower time component 1, so raising its index now gives \:22121/4. Changing the metric also invalidates its cached curvature."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"SetCMetricSystem", "[", RowBox[{"\"MinkowskiFields\"", ",", RowBox[{"DiagonalMatrix", "[", RowBox[{"{", RowBox[{RowBox[{"-", "4"}], ",", "1", ",", "1", ",", "1"}], "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"ToComponents", "[", RowBox[{"\"MinkowskiFields\"", ",", RowBox[{"A", "[", "a", "]"}]}], "]"}]}]],"Input",CellTags->"change_metric"],

Cell[TextData[{"The next lookup should return a Failure because the saved norm was computed with the old metric. Recalculate it before saving it again. A value assigned to an ordinary notebook variable retains its old value until you reevaluate the assignment."}],"Text"],

Cell[BoxData[RowBox[{"ResultOf", "[", RowBox[{"\"MinkowskiFields\"", ",", "\"VectorNorm\""}], "]"}]],"Input",CellTags->"invalidated_result"],

Cell[TextData[{"Restore the Minkowski metric."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"SetCMetricSystem", "[", RowBox[{"\"MinkowskiFields\"", ",", RowBox[{"DiagonalMatrix", "[", RowBox[{"{", RowBox[{RowBox[{"-", "1"}], ",", "1", ",", "1", ",", "1"}], "}"}], "]"}]}], "]"}], ";"}]],"Input",CellTags->"restore_metric"],

Cell[TextData[{"A metric perturbation"}],"Subsection"],

Cell[TextData[{"Define the metric perturbation h with xPert, register its head as an ordinary field registration and create a background. xPlorer detects its native metric-perturbation relationship automatically."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"DefMetricPerturbation", "[", RowBox[{"g", ",", "h", ",", "eps"}], "]"}], ";", RowBox[{"RegisterTheory", "[", RowBox[{"\"Field\"", ",", "h", ",", RowBox[{"Sector", "\[Rule]", "\"Perturbations\""}]}], "]"}], ";", RowBox[{"CreateBackground", "[", "\"MinkowskiPerturbed\"", "]"}], ";"}]],"Input",CellTags->"register_perturbation"],

Cell[TextData[{StyleBox["PerturbOn",FontFamily->"Courier",FontSize->11]," returns the abstract metric variation by default."}],"Text"],

Cell[BoxData[RowBox[{"PerturbOn", "[", RowBox[{"\"MinkowskiPerturbed\"", ",", RowBox[{"g", "[", RowBox[{RowBox[{"-", "a"}], ",", RowBox[{"-", "b"}]}], "]"}], ",", "1"}], "]"}]],"Input",CellTags->"abstract_perturbation"],

Cell[TextData[{"Set the first-order xx component of h to t\:00b2 and the second-order metric perturbation to zero. The perturbation order is distinct from the two tensor slots."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"DefineChart", "[", RowBox[{"\"MinkowskiPerturbed\"", ",", RowBox[{"{", RowBox[{"\"t\"", ",", "\"x\"", ",", "\"y\"", ",", "\"z\""}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"SetCMetricSystem", "[", RowBox[{"\"MinkowskiPerturbed\"", ",", RowBox[{"DiagonalMatrix", "[", RowBox[{"{", RowBox[{RowBox[{"-", "1"}], ",", "1", ",", "1", ",", "1"}], "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"SetFieldComponents", "[", RowBox[{"\"MinkowskiPerturbed\"", ",", "h", ",", RowBox[{"Function", "[", RowBox[{RowBox[{"{", RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "}"}], ",", RowBox[{"DiagonalMatrix", "[", RowBox[{"{", RowBox[{"0", ",", SuperscriptBox["t", "2"], ",", "0", ",", "0"}], "}"}], "]"}]}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"SetFieldComponents", "[", RowBox[{"\"MinkowskiPerturbed\"", ",", "h", ",", RowBox[{"ConstantArray", "[", RowBox[{"0", ",", RowBox[{"{", RowBox[{"4", ",", "4"}], "}"}]}], "]"}], ",", RowBox[{"PerturbationOrderLabel", "\[Rule]", "2"}]}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"tP", "=", RowBox[{RowBox[{RowBox[{"CoordinatesOf", "[", "\"MinkowskiPerturbed\"", "]"}], "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "[", "]"}]}], ";"}]],"Input",CellTags->"perturbation_profile"],

Cell[BoxData[RowBox[{RowBox[{"deltaG", "=", RowBox[{"PerturbOn", "[", RowBox[{"\"MinkowskiPerturbed\"", ",", RowBox[{"g", "[", RowBox[{RowBox[{"-", "a"}], ",", RowBox[{"-", "b"}]}], "]"}], ",", "1", ",", RowBox[{"Output", "\[Rule]", "\"Components\""}]}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"delta2G", "=", RowBox[{"PerturbOn", "[", RowBox[{"\"MinkowskiPerturbed\"", ",", RowBox[{"g", "[", RowBox[{"a", ",", "b"}], "]"}], ",", "2", ",", RowBox[{"Output", "\[Rule]", "\"Components\""}]}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"taylor2", "=", RowBox[{"PerturbOn", "[", RowBox[{"\"MinkowskiPerturbed\"", ",", RowBox[{"g", "[", RowBox[{"a", ",", "b"}], "]"}], ",", "2", ",", RowBox[{"Output", "\[Rule]", "\"Components\""}], ",", RowBox[{"PerturbationForm", "\[Rule]", "\"TaylorCoefficient\""}]}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"{", RowBox[{TagBox["deltaG", Function[BoxForm`e$, MatrixForm[BoxForm`e$]]], ",", TagBox["delta2G", Function[BoxForm`e$, MatrixForm[BoxForm`e$]]], ",", TagBox["taylor2", Function[BoxForm`e$, MatrixForm[BoxForm`e$]]]}], "}"}]}]],"Input",CellTags->"perturbation_results"],

Cell[TextData[{"The xx entries are t\:00b2 for the first metric variation and 2t\:2074 for the second inverse-metric variation. The inverse metric contains a term quadratic in the first variation. Dividing the second variation by 2! gives the Taylor coefficient t\:2074."}],"Text"]
},Open]],

Cell[CellGroupData[{
Cell[TextData[{"8. Delete and recreate a study"}],"Section"],

Cell[TextData[{"Keep a reference to the current metric so that you can check its xAct registration after deleting the study."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"oldMetric", "=", RowBox[{"BackgroundObject", "[", RowBox[{"\"MinkowskiFields\"", ",", "\"Metric\""}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"MetricQ", "[", "oldMetric", "]"}]}]],"Input",CellTags->"before_deletion"],

Cell[TextData[{StyleBox["DeletionPlan",FontFamily->"Courier",FontSize->11]," shows owned objects, external blockers and removal order. xPlorer calls the xAct removal functions in dependency order. To reproduce the study, save its declared inputs with ",StyleBox["ReconstructionData",FontFamily->"Courier",FontSize->11]," before deletion. Reconstruction requires the original source definitions. Derived values can be calculated again."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"plan", "=", RowBox[{"DeletionPlan", "[", "\"MinkowskiFields\"", "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"KeyTake", "[", RowBox[{"plan", ",", RowBox[{"{", RowBox[{"\"Key\"", ",", "\"CanDelete\"", ",", "\"Order\"", ",", "\"ExternalBlockers\""}], "}"}]}], "]"}]}]],"Input",CellTags->"deletion_preview"],

Cell[TextData[{"Alternative \:2014 rebuild from a saved recipe"}],"Subsubsection"],

Cell[TextData[{"Use these three lines in place of the manual deletion and recreation below to recover the declared inputs, including the assigned field components."}],"Text"],

Cell["recipe = ReconstructionData[\"MinkowskiFields\"];\nDeleteBackground[\"MinkowskiFields\"];\nRecreateBackground[\"MinkowskiFields\", recipe];","Program",Evaluatable->False],

Cell[TextData[{"Manual recreation"}],"Subsubsection"],

Cell[BoxData[RowBox[{RowBox[{"DeleteBackground", "[", "\"MinkowskiFields\"", "]"}], ";", "\[IndentingNewLine]", RowBox[{"{", RowBox[{RowBox[{"KeyExistsQ", "[", RowBox[{"$BG", ",", "\"MinkowskiFields\""}], "]"}], ",", RowBox[{"MetricQ", "[", "oldMetric", "]"}]}], "}"}]}]],"Input",CellTags->"delete_background"],

Cell[TextData[{"The two False values confirm that xPlorer removed the study and xAct unregistered its old metric. Recreating a background sets up its automatic names again. Refresh any aliases you assigned yourself."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"CreateBackground", "[", "\"MinkowskiFields\"", "]"}], ";", "\[IndentingNewLine]", RowBox[{"DefineChart", "[", RowBox[{"\"MinkowskiFields\"", ",", RowBox[{"{", RowBox[{"\"t\"", ",", "\"x\"", ",", "\"y\"", ",", "\"z\""}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"SetCMetricSystem", "[", RowBox[{"\"MinkowskiFields\"", ",", RowBox[{"DiagonalMatrix", "[", RowBox[{"{", RowBox[{RowBox[{"-", "1"}], ",", "1", ",", "1", ",", "1"}], "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", RowBox[{RowBox[{"ShowBackground", "[", "\"MinkowskiFields\"", "]"}], "[", "\"FieldComponents\"", "]"}]}]],"Input",CellTags->"recreate_background"],

Cell[TextData[{"The recreated background starts with an empty field-component registry. Assign new lower components and inspect the raised vector."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"SetFieldComponents", "[", RowBox[{"\"MinkowskiFields\"", ",", "A", ",", RowBox[{"{", RowBox[{"5", ",", "0", ",", "0", ",", "0"}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"Aup", "=", RowBox[{"ToComponents", "[", RowBox[{"\"MinkowskiFields\"", ",", RowBox[{"A", "[", "a", "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", "Aup"}]],"Input",CellTags->"fresh_vector"],

Cell[TextData[{"The upper time component is \:22125 for the new input. The Minkowski inverse metric supplies the minus sign."}],"Text"],

Cell[TextData[{"To delete one owned tensor, specify its field key. S has no tracked dependents here. If an equation or rule depends on the field, ",StyleBox["Cascade -> True",FontFamily->"Courier",FontSize->11]," permits removing those dependents within this background. External xAct objects are protected."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"DeleteBackgroundObject", "[", RowBox[{"\"MinkowskiFields\"", ",", "\"S\""}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"KeyExistsQ", "[", RowBox[{RowBox[{RowBox[{"ShowBackground", "[", "\"MinkowskiFields\"", "]"}], "[", "\"Field\"", "]"}], ",", "\"S\""}], "]"}]}]],"Input",CellTags->"delete_single_field"],

Cell[TextData[{"The False result confirms that the key S is gone from this study. The source tensor and its other copies are still available. To clear the values of A, use ",StyleBox["ClearFieldComponents",FontFamily->"Courier",FontSize->11],". ",StyleBox["ClearComputedValues",FontFamily->"Courier",FontSize->11]," clears derived geometry and restores declared inputs."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"ClearFieldComponents", "[", RowBox[{"\"MinkowskiFields\"", ",", "A"}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"ClearComputedValues", "[", "\"MinkowskiFields\"", "]"}], ";", "\[IndentingNewLine]", RowBox[{"SetFieldComponents", "[", RowBox[{"\"MinkowskiFields\"", ",", "A", ",", RowBox[{"{", RowBox[{"5", ",", "0", ",", "0", ",", "0"}], "}"}]}], "]"}], ";"}]],"Input",CellTags->"clear_vector_input"],

Cell[TextData[{"Deleting a chart resets the coordinate setup. Removing the metric and its dependent family leaves the abstract manifold. Curvature tensors are removed with their connection, and the primary derivative with its metric. Inspect ",StyleBox["DeletionPlan",FontFamily->"Courier",FontSize->11]," before either operation."}],"Text"],

Cell[TextData[{"Close the affine study. The three scalar backgrounds remain available."}],"Text"],

Cell[BoxData[RowBox[{RowBox[{"DeleteBackground", "[", "\"AffineStudy\"", "]"}], ";"}]],"Input",CellTags->"close_affine_study"],

Cell[TextData[{"The optional ScalarTheory.wl contains the initial scalar definitions for reuse in a separate notebook."}],"Text"]
},Open]]

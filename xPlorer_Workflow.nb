(* Wolfram Notebook File - ASCII source *)
Notebook[{
Cell["xPlorer - From an abstract theory to physical spacetimes","Title"],

Cell["Einstein gravity, matter and metric perturbations | 1.0.0-beta.1","Subtitle"],

Cell[TextData[{"Derive the field equations once, then use them on several independent spacetimes in the same Mathematica kernel.\n\nThis tutorial follows a single calculation from the abstract theory to physical results."}],"Text"],

Cell[CellGroupData[{
Cell["Introduction","Section"],

Cell[TextData[{"We begin with Einstein gravity coupled to a real massive scalar field. We also define vector and two-form test fields and the metric perturbation before creating the backgrounds.\n\nThe tutorial teaches registration, retrieval, specialization and presentation before passing to components. We then compare tensor perturbations on Minkowski and FLRW, and explore changes of profiles and charts.\n\nOpen the numbered sections in order. Their subsections are already open. For the complete reference, see ",StyleBox["xPlorer_API_Examples.nb",FontFamily->"Courier",FontSize->14],"."}],"Text"],

Cell[TextData[{"Start with a fresh kernel and xAct installed. For installation or removal of xPlorer, see ",StyleBox["xPlorer_Install.nb",FontFamily->"Courier",FontSize->14],".\n\nEvaluate only one of the following loading cells."}],"Text"],

Cell[TextData[{"Load an installed paclet:"}],"Text"],

Cell[BoxData["Needs[\"xPlorer`\"];"],"Input",CellTags->"load_existing"],

Cell[TextData[{"Alternatively, load the source without installation:"}],"Text"],

Cell[BoxData["Get[If[FileExistsQ[FileNameJoin[{NotebookDirectory[], \"xPlorer.wl\"}]],\n  FileNameJoin[{NotebookDirectory[], \"xPlorer.wl\"}],\n  FileNameJoin[{NotebookDirectory[], \"Paclet\", \"xPlorer.wl\"}]]];"],"Input",CellTags->"load"],

Cell[BoxData["If[$XPlorerVersion === \"1.0.0-beta.1\", $XPlorerVersion, Print[\"Unexpected xPlorer version. See xPlorer_Install.nb.\"]; Abort[]]"],"Input",CellTags->"workflow_version"]
},Open]],

Cell[TextData[{"These optional xAct switches reduce informational printing while leaving warnings and errors visible."}],"Text"],

Cell[BoxData["$DefInfoQ = False;"],"Input",CellTags->"quiet_def"],

Cell[BoxData["$CVVerbose = False;"],"Input",CellTags->"quiet_cv"],

Cell[TextData[{"Choose the session notation before creating the backgrounds. Object labels identify the owner of tensors and coordinates; fraction notation displays ordinary partial derivatives.\n\nEach call to ",StyleBox["SetXPlorerPreferences",FontFamily->"Courier",FontSize->14]," replaces the previous session preferences. Include any options you want to retain."}],"Text"],

Cell[BoxData["SetXPlorerPreferences[ShowObjectLabels -> True, PartialStyle -> \"Fraction\"];"],"Input",CellTags->"session_notation"],

Cell[CellGroupData[{
Cell["1. Define and register the theory","Section"],

Cell[CellGroupData[{
Cell["The abstract Einstein-scalar theory","Subsection"],

Cell[TextData[{"Define a four-dimensional Lorentzian manifold, its metric and a real scalar field of mass m using native xTensor.\n\nWe use signature (-,+,+,+), with kappa = 8 pi G in units c = 1. The action uses the invariant volume element multiplying the gravitational and matter Lagrangians."}],"Text"],

Cell[BoxData["DefManifold[M, 4, {a,b,c,d,e,f,i,j}];"],"Input",CellTags->"manifold"],

Cell[BoxData["DefMetric[-1, g[-a,-b], CD];"],"Input",CellTags->"metric"],

Cell[BoxData["DefTensor[phi[], M, PrintAs -> \"\\[Phi]\"];"],"Input",CellTags->"scalar"],

Cell[BoxData["DefConstantSymbol[m];"],"Input",CellTags->"mass"],

Cell[BoxData["DefConstantSymbol[kap, PrintAs -> \"\\[Kappa]\"];"],"Input",CellTags->"grav_constant"],

Cell[TextData[{"Define the metric perturbation using native xPert. The tensor h carries an order label LI[n]; eps is the formal expansion parameter."}],"Text"],

Cell[BoxData["DefMetricPerturbation[g,h,eps];"],"Input",CellTags->"def_h"],

Cell[TextData[{"Define a covector and an antisymmetric two-form as independent test fields. They will be used to teach tensor components, not included in the Einstein-scalar source."}],"Text"],

Cell[BoxData["DefTensor[A[-a], M];"],"Input",CellTags->"vector"],

Cell[BoxData["DefTensor[F[-a,-b], M, Antisymmetric[{-a,-b}]];"],"Input",CellTags->"twoform"],

Cell[BoxData["Lkin = -CD[-a][phi[]] CD[a][phi[]]/2;"],"Input",CellTags->"kinetic"],

Cell[BoxData["Lmass = -m^2 phi[]^2/2;"],"Input",CellTags->"mass_lag"],

Cell[BoxData["L = Lkin + Lmass"],"Input",CellTags->"lagrangian"],

Cell[BoxData["Lgrav = RicciScalar[CD][]/(2 kap)"],"Input",CellTags->"grav_lag"],

Cell[BoxData["Ltotal = Lgrav + L"],"Input",CellTags->"total_lag"],

Cell[TextData[{"Vary the scalar at fixed metric, taking the variations to have compact support.\n\n",StyleBox["VarD",FontFamily->"Courier",FontSize->14]," gives the Euler-Lagrange expression. ",StyleBox["ContractMetric",FontFamily->"Courier",FontSize->14]," and ",StyleBox["ToCanonical",FontFamily->"Courier",FontSize->14]," simplify it using the native tensor algebra."}],"Text"],

Cell[BoxData["kg = VarD[phi[], CD][L] // ContractMetric // ToCanonical;"],"Input",CellTags->"kg"],

Cell[BoxData["kg == 0"],"Input",CellTags->"kg_abstract"],

Cell[TextData[{"The scalar energy-momentum tensor follows from metric variation of the matter action. Here we write its known covariant form using native xTensor.\n\n",StyleBox["ReplaceDummies",FontFamily->"Courier",FontSize->14]," prevents collisions between the dummy indices of L and the free indices a and b."}],"Text"],

Cell[BoxData["stress = CD[-a][phi[]] CD[-b][phi[]] + g[-a,-b] ReplaceDummies[L]"],"Input",CellTags->"stress"],

Cell[TextData[{"The Einstein equation is the vanishing of the following rank-two expression. Unlike the scalar equation, it couples the curvature to matter."}],"Text"],

Cell[BoxData["Eab = Einstein[CD][-a,-b] - kap stress"],"Input",CellTags->"eab"],

Cell[BoxData["hessian = CD[-a][CD[-b][phi[]]];"],"Input",CellTags->"hessian"]
},Open]],

Cell[CellGroupData[{
Cell["Register the native objects","Subsection"],

Cell[TextData[{StyleBox["RegisterTheory",FontFamily->"Courier",FontSize->14]," records the native objects that xPlorer should reuse, without redefining them.\n\nBegin with the metric, its covariant derivative and the list of abstract indices."}],"Text"],

Cell[BoxData["RegisterTheory[\"Metric\", g];"],"Input",CellTags->"register_geometry"],

Cell[BoxData["RegisterTheory[\"CovD\", CD];"],"Input",CellTags->"register_covd"],

Cell[BoxData["RegisterTheory[\"Indices\", {a,b,c,d,e,f,i,j}];"],"Input",CellTags->"register_indices"],

Cell[TextData[{"Pass the tensor head ",StyleBox["phi",FontFamily->"Courier",FontSize->14],", rather than ",StyleBox["phi[]",FontFamily->"Courier",FontSize->14],", when registering a field. xPlorer infers its rank and symmetry.\n\nFor the shared parameter m, ",StyleBox["Name",FontFamily->"Courier",FontSize->14]," sets the lookup key. ",StyleBox["Sector",FontFamily->"Courier",FontSize->14]," groups related objects without imposing equations."}],"Text"],

Cell[BoxData["RegisterTheory[\"Field\", phi, Sector -> \"Matter\"];"],"Input",CellTags->"register_field"],

Cell[TextData[{"Register the perturbation tensor h like any other field. xPlorer detects its native metric-perturbation relation and copies it with each geometry.\n\nUse the plural ",StyleBox["Fields",FontFamily->"Courier",FontSize->14]," form to register the two test fields in a named sector."}],"Text"],

Cell[BoxData["RegisterTheory[\"Field\", h, Sector -> \"Perturbations\"];"],"Input",CellTags->"register_h"],

Cell[BoxData["RegisterTheory[\"Fields\", {{A, Sector -> \"TestFields\"}, {F, Sector -> \"TestFields\"}}];"],"Input",CellTags->"fields"],

Cell[BoxData["RegisterTheory[\"Parameter\", m, Name -> \"Mass\", Sector -> \"Matter\"];"],"Input",CellTags->"register_parameter"],

Cell[BoxData["RegisterTheory[\"Parameter\", kap, Name -> \"Coupling\", Sector -> \"Gravity\"];"],"Input",CellTags->"register_kap"],

Cell[TextData[{"Register one Lagrangian with ",StyleBox["Lagrangian",FontFamily->"Courier",FontSize->14],", or several at once with ",StyleBox["Lagrangians",FontFamily->"Courier",FontSize->14],".\n\nBelow we store the kinetic term individually, then the mass term and the total together. These are separate named formulas; xPlorer does not add them automatically."}],"Text"],

Cell[BoxData["RegisterTheory[\"Lagrangian\", \"Kinetic\" -> Lkin, Sector -> \"Matter\"];"],"Input",CellTags->"register_kinetic"],

Cell[BoxData["RegisterTheory[\"Lagrangians\", {{\"MassTerm\" -> Lmass, Sector -> \"Matter\"}, {\"Matter\" -> L, Sector -> \"Matter\"}}];"],"Input",CellTags->"register_lag"],

Cell[BoxData["RegisterTheory[\"Lagrangians\", {{\"EinsteinHilbert\" -> Lgrav, Sector -> \"Gravity\"}, {\"Total\" -> Ltotal, Sector -> \"Gravity\"}}];"],"Input",CellTags->"register_gravity"],

Cell[TextData[{"The ",StyleBox["Expressions",FontFamily->"Courier",FontSize->14]," collection stores the scalar equation, stress tensor, Hessian and Einstein equation separately from the Lagrangians.\n\nTheir lookup keys and their source variable names have different roles: the latter determine the automatically generated aliases."}],"Text"],

Cell[BoxData["RegisterTheory[\"Expressions\", {{\"KG\" -> kg, Sector -> \"Matter\"}, {\"Hessian\" -> hessian, Sector -> \"Matter\"}, {\"Stress\" -> stress, Sector -> \"Matter\"}, {\"Eab\" -> Eab, Sector -> \"Gravity\"}}];"],"Input",CellTags->"register_expr"],

Cell[BoxData["RegisterTheory[\"Title\", \"Einstein gravity with scalar matter\"];"],"Input",CellTags->"register_title"],

Cell[TextData[{StyleBox["ShowTheory",FontFamily->"Courier",FontSize->14]," displays the registered geometry, fields and formulas.\n\nUse ",StyleBox["TheoryValue",FontFamily->"Courier",FontSize->14]," to retrieve a particular formula as a mathematical expression."}],"Text"],

Cell[BoxData["ShowTheory[]"],"Input",CellTags->"show_theory"],

Cell[BoxData["TheoryValue[\"Lagrangians\", \"Matter\"]"],"Input",CellTags->"registry_formula"],

Cell[TextData[{"Retrieve all objects registered in the Gravity sector without searching the other collections."}],"Text"],

Cell[BoxData["TheorySector[\"Gravity\"]"],"Input",CellTags->"gravity_sector"]
},Open]]
},Closed]],

Cell[CellGroupData[{
Cell["2. Reuse abstract equations on independent backgrounds","Section"],

Cell[CellGroupData[{
Cell["Create and recognize the copied tensors","Subsection"],

Cell[TextData[{StyleBox["CreateBackground",FontFamily->"Courier",FontSize->14]," creates an independent native xAct manifold and copies the registered geometry, fields and formulas. Shared parameters such as m are not cloned.\n\n",StyleBox["SymbolSuffix",FontFamily->"Courier",FontSize->14]," controls the names we type, such as ",StyleBox["gSchw",FontFamily->"Courier",FontSize->14]," and ",StyleBox["kgSchw",FontFamily->"Courier",FontSize->14],". ",StyleBox["BackgroundLabel",FontFamily->"Courier",FontSize->14]," sets the short marker printed on the objects.\n\nThe markers are visible because we enabled ",StyleBox["ShowObjectLabels",FontFamily->"Courier",FontSize->14]," in the session preferences."}],"Text"],

Cell[BoxData["CreateBackground[\"Minkowski\", SymbolSuffix -> \"M\", BackgroundLabel -> \"M\"];"],"Input",CellTags->"minkowski"],

Cell[BoxData["CreateBackground[\"Schwarzschild\", SymbolSuffix -> \"Schw\", BackgroundLabel -> \"S\"];"],"Input",CellTags->"schwarzschild"],

Cell[BoxData["CreateBackground[\"FLRW\", BackgroundLabel -> \"F\"];"],"Input",CellTags->"flrw"],

Cell[BoxData["ShowBackground[]"],"Input",CellTags->"open_models"],

Cell[TextData[{"The two Klein-Gordon equations have the same form but belong to different manifolds.\n\nTheir M and S labels identify the copied fields and derivatives even before choosing coordinates."}],"Text"],

Cell[BoxData["kgM == 0"],"Input",CellTags->"kg_m_abstract"],

Cell[BoxData["kgSchw == 0"],"Input",CellTags->"abstract_copies"],

Cell[TextData[{"The source variable ",StyleBox["Eab",FontFamily->"Courier",FontSize->14]," gives the aliases ",StyleBox["EabM",FontFamily->"Courier",FontSize->14]," and ",StyleBox["EabSchw",FontFamily->"Courier",FontSize->14],". These contain the copied curvature and matter tensors.\n\nUse ",StyleBox["BackgroundExpression",FontFamily->"Courier",FontSize->14]," to retrieve a formula by its key, independently of its alias."}],"Text"],

Cell[BoxData["EabM"],"Input",CellTags->"rank_two_m"],

Cell[BoxData["BackgroundExpression[\"Schwarzschild\", \"Expressions\", \"Eab\"]"],"Input",CellTags->"rank_two_s"],

Cell[TextData[{"The copied objects can be used directly in native xAct calculations.\n\nFor example, contract the rank-two expression with the inverse Schwarzschild metric to raise one index."}],"Text"],

Cell[BoxData["gSchw[aSchw,cSchw] EabSchw // ContractMetric // ToCanonical"],"Input",CellTags->"raise_abstract"]
},Open]],

Cell[CellGroupData[{
Cell["Change notation when reading full expressions","Subsection"],

Cell[TextData[{"The Einstein equation combines curvature, the metric and derivatives of matter. Postfix derivative notation can make its longer terms easier to read.\n\n",StyleBox["PrettyExp",FontFamily->"Courier",FontSize->14]," changes only the presentation. ",StyleBox["Normal",FontFamily->"Courier",FontSize->14]," recovers the original mathematical result."}],"Text"],

Cell[BoxData["EabSchw // PrettyExp[CovariantStyle -> \"Postfix\"]"],"Input",CellTags->"postfix_view"],

Cell[TextData[{"When all terms belong to one background, a caption can replace repeated object labels.\n\n",StyleBox["ShowBackgroundLabel",FontFamily->"Courier",FontSize->14]," identifies the result as a whole; ",StyleBox["ShowObjectLabels",FontFamily->"Courier",FontSize->14]," marks individual tensors. The options are independent."}],"Text"],

Cell[BoxData["PrettyExp[\"Schwarzschild\", EabSchw, ShowBackgroundLabel -> True, ShowObjectLabels -> False, CovariantStyle -> \"Postfix\"]"],"Input",CellTags->"caption"],

Cell[TextData[{"Suppose we want to use psi for the field, q for the metric and D for the derivative, as in another notation convention.\n\n",StyleBox["SetPresentation",FontFamily->"Courier",FontSize->14]," changes these printed names throughout Schwarzschild, without changing its typed symbols or mathematical identities. The result is visible in the full expression."}],"Text"],

Cell[BoxData["SetPresentation[\"Schwarzschild\", \"phi\" -> \"\\[Psi]\", \"Metric\" -> \"q\", \"CovD\" -> {\"|\", \"D\"}];"],"Input",CellTags->"rename_objects"],

Cell[BoxData["EabSchw // PrettyExp[CovariantStyle -> \"Prefix\"]"],"Input",CellTags->"rename_view"],

Cell[TextData[{"Use ",StyleBox["Automatic",FontFamily->"Courier",FontSize->14]," to restore the inherited printed names. The other backgrounds are unaffected."}],"Text"],

Cell[BoxData["SetPresentation[\"Schwarzschild\", \"phi\" -> Automatic, \"Metric\" -> Automatic, \"CovD\" -> Automatic];"],"Input",CellTags->"reset_objects"]
},Open]],

Cell[CellGroupData[{
Cell["Specialize a theory without changing the others","Subsection"],

Cell[TextData[{"Take the massless limit only on Schwarzschild using ",StyleBox["AddRules",FontFamily->"Courier",FontSize->14],". This stores a local replacement, rather than assigning a global value to m.\n\n",StyleBox["UseExpression",FontFamily->"Courier",FontSize->14]," retrieves a registered formula with the active rules applied. The original alias remains general, so we can compare the massive and massless forms."}],"Text"],

Cell[BoxData["AddRules[\"Schwarzschild\", {m -> 0}];"],"Input",CellTags->"individual_rules"],

Cell[BoxData["UseExpression[\"Schwarzschild\", \"KG\"] == 0"],"Input",CellTags->"massless_abstract"],

Cell[BoxData["UseExpression[\"Schwarzschild\", \"Lagrangians\", \"Matter\"]"],"Input",CellTags->"formal_lagrangian"],

Cell[BoxData["LSchw"],"Input",CellTags->"general_lagrangian"],

Cell[BoxData["ApplyRules[\"Schwarzschild\", EabSchw]"],"Input",CellTags->"rule_eab"],

Cell[BoxData["kgM == 0"],"Input",CellTags->"other_abstract"],

Cell[BoxData["ShowRules[\"Schwarzschild\"]"],"Input",CellTags->"show_rules"],

Cell[TextData[{"Clear the active replacement before storing the same limit as a reusable named rule group. We will activate it when calculating components."}],"Text"],

Cell[BoxData["ClearRules[\"Schwarzschild\"];"],"Input",CellTags->"clear_individual"],

Cell[BoxData["SetRuleGroup[\"Schwarzschild\", \"Massless\", {m -> 0}];"],"Input",CellTags->"massless"]
},Open]]
},Closed]],

Cell[CellGroupData[{
Cell["3. Choose coordinates and calculate physical equations","Section"],

Cell[TextData[{"To work with components, first define the coordinates with ",StyleBox["DefineChart",FontFamily->"Courier",FontSize->14]," and supply the metric with ",StyleBox["MetricInBasis",FontFamily->"Courier",FontSize->14],". The short metric syntax infers the primary chart.\n\nAssign fields with ",StyleBox["ComponentValue",FontFamily->"Courier",FontSize->14]," or ",StyleBox["AllComponentValues",FontFamily->"Courier",FontSize->14],", then apply ",StyleBox["ToComponents",FontFamily->"Courier",FontSize->14],". xPlorer uses native xCoba without manual basis conversions.\n\nThe scalar profiles in this section are trial fields on prescribed geometries, not asserted to solve the coupled Einstein-scalar system."}],"Text"],

Cell[CellGroupData[{
Cell["Minkowski: a general field and a plane-wave solution","Subsection"],

Cell[BoxData["DefineChart[\"Minkowski\", {t[],x[],y[],z[]}];"],"Input",CellTags->"chart_m"],

Cell[BoxData["MetricInBasis[gM, DiagonalMatrix[{-1,1,1,1}]];"],"Input",CellTags->"metric_m"],

Cell[TextData[{"The chart creates suffixed scalar heads such as ",StyleBox["tM[]",FontFamily->"Courier",FontSize->14],". Supply a general function of the four coordinates.\n\n",StyleBox["ToComponents",FontFamily->"Courier",FontSize->14]," expands the covariant derivatives using the metric and the assigned field."}],"Text"],

Cell[BoxData["DefScalarFunction[v];"],"Input",CellTags->"wavefn"],

Cell[BoxData["ComponentValue[phiM[], v[tM[],xM[],yM[],zM[]]];"],"Input",CellTags->"general_profile"],

Cell[BoxData["eqM = kgM // ToComponents;"],"Input",CellTags->"eq_m"],

Cell[BoxData["eqM == 0"],"Input",CellTags->"eq_m_view"],

Cell[TextData[{"The wave equation contains four second derivatives. Comma notation is a compact alternative to fractions in longer expressions.\n\nApply ",StyleBox["PrettyExp",FontFamily->"Courier",FontSize->14]," to the existing equation; no new component calculation is needed."}],"Text"],

Cell[BoxData["(eqM == 0) // PrettyExp[PartialStyle -> \"Comma\"]"],"Input",CellTags->"partial_compare"],

Cell[TextData[{"Evaluate the registered Lagrangian using the same field profile and geometry."}],"Text"],

Cell[BoxData["LM // ToComponents"],"Input",CellTags->"lag_m_components"],

Cell[TextData[{"Replace the general field profile by a plane wave. The abstract equation remains unchanged.\n\nThe new residual should vanish when the massive dispersion relation is imposed."}],"Text"],

Cell[BoxData["DefConstantSymbol[w, PrintAs -> \"\\[Omega]\"];"],"Input",CellTags->"wave_params"],

Cell[BoxData["DefConstantSymbol[k];"],"Input",CellTags->"wave_k"],

Cell[BoxData["ComponentValue[phiM[], Cos[w tM[] - k zM[]]];"],"Input",CellTags->"wave_profile"],

Cell[BoxData["waveResidual = kgM // ToComponents"],"Input",CellTags->"wave_residual"],

Cell[BoxData["Simplify[waveResidual, w^2 == k^2 + m^2]"],"Input",CellTags->"wave_solution"],

Cell[TextData[{"The same component workflow works for tensors. Supply the covector components in chart order. With lower abstract indices, ",StyleBox["AllComponentValues",FontFamily->"Courier",FontSize->14]," infers the primary chart."}],"Text"],

Cell[BoxData["AllComponentValues[AM[-aM], {tM[],xM[],0,0}];"],"Input",CellTags->"assign_a"],

Cell[BoxData["AM[aM] // ToComponents // MatrixForm"],"Input",CellTags->"raised"],

Cell[BoxData["AM[aM] AM[-aM] // ToComponents"],"Input",CellTags->"norm"],

Cell[TextData[{"For the independent two-form, use symbolic electric and magnetic amplitudes and an antisymmetric component matrix."}],"Text"],

Cell[BoxData["DefConstantSymbol[ef, PrintAs -> \"E\"];"],"Input",CellTags->"electric"],

Cell[BoxData["DefConstantSymbol[bf, PrintAs -> \"B\"];"],"Input",CellTags->"magnetic"],

Cell[BoxData["AllComponentValues[FM[-aM,-bM], {{0,ef,0,0},{-ef,0,0,0},{0,0,0,bf},{0,0,-bf,0}}];"],"Input",CellTags->"full_f"],

Cell[BoxData["FM[aM,bM] // ToComponents // MatrixForm"],"Input",CellTags->"raised_f"],

Cell[BoxData["FM[aM,bM] FM[-aM,-bM] // ToComponents"],"Input",CellTags->"invariant_f"],

Cell[TextData[{"The invariant is 2(B^2-E^2) for our signature. ",StyleBox["ToCTensor",FontFamily->"Courier",FontSize->14]," instead returns a native xCoba snapshot with its basis."}],"Text"],

Cell[BoxData["AM[aM] // ToCTensor"],"Input",CellTags->"ctensor"]
},Open]],

Cell[CellGroupData[{
Cell["Schwarzschild: radial equation and curvature","Subsection"],

Cell[TextData[{"Work in the exterior region r > 2 Mbh.\n\nUse native ",StyleBox["PrintAs",FontFamily->"Courier",FontSize->14]," to display the angular coordinates with Greek letters. ",StyleBox["Evaluate",FontFamily->"Courier",FontSize->14]," resolves the actual coordinate head behind its alias."}],"Text"],

Cell[BoxData["DefineChart[\"Schwarzschild\", {t[],r[],theta[],varphi[]}];"],"Input",CellTags->"chart_s"],

Cell[BoxData["PrintAs[Evaluate[thetaSchw]] ^= \"\\[Theta]\";"],"Input",CellTags->"angles_s"],

Cell[BoxData["PrintAs[Evaluate[varphiSchw]] ^= \"\\[CurlyPhi]\";"],"Input",CellTags->"angle_phi_s"],

Cell[BoxData["DefConstantSymbol[Mbh];"],"Input",CellTags->"bh"],

Cell[BoxData["fSchw = 1 - 2 Mbh/rSchw[];"],"Input",CellTags->"f"],

Cell[BoxData["MetricInBasis[gSchw, DiagonalMatrix[{-fSchw,1/fSchw,rSchw[]^2,rSchw[]^2 Sin[thetaSchw[]]^2}], Assumptions -> Mbh>0 && rSchw[]>2 Mbh && 0<thetaSchw[]<Pi];"],"Input",CellTags->"metric_s"],

Cell[BoxData["gSchw[-aSchw,-bSchw] // ToComponents // MatrixForm"],"Input",CellTags->"metric_s_view"],

Cell[TextData[{"Assign a static radial profile. The same abstract Klein-Gordon equation now reduces to an ordinary differential equation."}],"Text"],

Cell[BoxData["DefScalarFunction[u];"],"Input",CellTags->"radialfn"],

Cell[BoxData["ComponentValue[phiSchw[], u[rSchw[]]];"],"Input",CellTags->"profile_s"],

Cell[BoxData["eqS = kgSchw // ToComponents;"],"Input",CellTags->"eq_s"],

Cell[BoxData["eqS == 0"],"Input",CellTags->"eq_s_view"],

Cell[TextData[{"Only radial derivatives occur in this equation, so prime notation is compact.\n\n",StyleBox["SetNotation",FontFamily->"Courier",FontSize->14]," changes the default for Schwarzschild alone. Evaluate the same equation again to see the new presentation."}],"Text"],

Cell[BoxData["SetNotation[\"Schwarzschild\", PartialStyle -> \"Prime\"];"],"Input",CellTags->"radial_notation"],

Cell[BoxData["eqS == 0"],"Input",CellTags->"prime"],

Cell[TextData[{"Activate the named Massless group defined in section 2. ",StyleBox["ToComponents",FontFamily->"Courier",FontSize->14]," applies the active rules automatically.\n\nAfter inspecting the specialized result, deactivate the group to restore the massive equation."}],"Text"],

Cell[BoxData["ActivateRuleGroups[\"Schwarzschild\", {\"Massless\"}];"],"Input",CellTags->"activate_massless"],

Cell[BoxData["kgSchw // ToComponents"],"Input",CellTags->"eq_massless"],

Cell[BoxData["ShowRuleGroups[\"Schwarzschild\", \"Status\"]"],"Input",CellTags->"rule_view"],

Cell[BoxData["DeactivateRuleGroups[\"Schwarzschild\", {\"Massless\"}];"],"Input",CellTags->"deactivate_massless"],

Cell[BoxData["Simplify[(kgSchw // ToComponents)-eqS]"],"Input",CellTags->"mass_restored"],

Cell[TextData[{"The Ricci scalar vanishes in the Schwarzschild vacuum exterior, whereas the Kretschmann invariant does not.\n\nBoth curvature tensors are obtained from the native copied covariant derivative."}],"Text"],

Cell[BoxData["RicciScalar[CDSchw][] // ToComponents"],"Input",CellTags->"ricci_s"],

Cell[BoxData["Kretschmann[CDSchw][] // ToComponents"],"Input",CellTags->"kretschmann_s"],

Cell[TextData[{StyleBox["ShowBackground",FontFamily->"Courier",FontSize->14]," displays the declared metric, chart, field and rule groups without computing another observable."}],"Text"],

Cell[BoxData["ShowBackground[\"Schwarzschild\"]"],"Input",CellTags->"inspect_s"]
},Open]],

Cell[CellGroupData[{
Cell["FLRW: homogeneous scalar and energy density","Subsection"],

Cell[BoxData["DefineChart[\"FLRW\", {t[],x[],y[],z[]}];"],"Input",CellTags->"chart_f"],

Cell[BoxData["DefScalarFunction[s];"],"Input",CellTags->"scale"],

Cell[BoxData["DefScalarFunction[q];"],"Input",CellTags->"homogeneous_fn"],

Cell[BoxData["MetricInBasis[gFLRW, DiagonalMatrix[{-1,s[tFLRW[]]^2,s[tFLRW[]]^2,s[tFLRW[]]^2}], Assumptions -> s[tFLRW[]]>0];"],"Input",CellTags->"metric_f"],

Cell[BoxData["ComponentValue[phiFLRW[], q[tFLRW[]]];"],"Input",CellTags->"profile_f"],

Cell[BoxData["eqF = kgFLRW // ToComponents;"],"Input",CellTags->"eq_f"],

Cell[BoxData["eqF == 0"],"Input",CellTags->"eq_f_view"],

Cell[TextData[{"The expanding geometry produces the Hubble friction term in the scalar equation.\n\nEvaluate the Einstein tensor on this background. ",StyleBox["MatrixForm",FontFamily->"Courier",FontSize->14]," is used only to display its component array."}],"Text"],

Cell[BoxData["Einstein[CDFLRW][-aFLRW,-bFLRW] // ToComponents // MatrixForm"],"Input",CellTags->"einstein_f"],

Cell[TextData[{"The registered stress tensor already has a FLRW alias. Evaluate the energy density directly from this copied expression."}],"Text"],

Cell[BoxData["stressFLRW"],"Input",CellTags->"stress_f"],

Cell[TextData[{"Use ",StyleBox["Components",FontFamily->"Courier",FontSize->14]," to request only the time-time entry. xCoba numbers the coordinates from zero.\n\nThe result is a list of the requested entries; ",StyleBox["First",FontFamily->"Courier",FontSize->14]," extracts the single scalar energy density."}],"Text"],

Cell[BoxData["rhoFLRW = First[stressFLRW // ToComponents[Components -> {{0,0}}]]"],"Input",CellTags->"rho"],

Cell[TextData[{"The time-time component of the Einstein equation is the Friedmann constraint for a homogeneous scalar. Evaluating it does not solve the background equations automatically."}],"Text"],

Cell[BoxData["First[EabFLRW // ToComponents[FreeIndices -> {-aFLRW,-bFLRW}, Components -> {{0,0}}]] == 0"],"Input",CellTags->"friedmann"],

Cell[TextData[{"For a new observable that was not registered, use ",StyleBox["PortExpression",FontFamily->"Courier",FontSize->14],". Here we transport the scalar trace of the stress tensor and evaluate it on FLRW."}],"Text"],

Cell[BoxData["PortExpression[\"FLRW\", g[a,b] stress] // ToComponents"],"Input",CellTags->"trace_stress"],

Cell[TextData[{"A caption keeps the origin of the energy density clear when reusing it elsewhere in the notebook.\n\n",StyleBox["ExpressionText",FontFamily->"Courier",FontSize->14]," exports the mathematical notation of a result to LaTeX."}],"Text"],

Cell[BoxData["PrettyExp[\"FLRW\", rhoFLRW, ShowBackgroundLabel -> True]"],"Input",CellTags->"density_caption"],

Cell[BoxData["ExpressionText[eqS == 0, \"TeX\"]"],"Input",CellTags->"tex_export"]
},Open]]
},Closed]],

Cell[CellGroupData[{
Cell["4. Metric perturbations across spacetimes","Section"],

Cell[TextData[{"We now compare the same transverse, traceless metric perturbation on Minkowski and spatially flat FLRW. The perturbation tensors were registered before creating the backgrounds.\n\nFor a wave traveling in the z direction, choose the plus polarization: the xx and yy perturbations have opposite signs. On FLRW their covariant components include the square of the scale factor."}],"Text"],

Cell[CellGroupData[{
Cell["First-order tensor waves","Subsection"],

Cell[TextData[{"",StyleBox["PerturbOn[1]",FontFamily->"Courier",FontSize->14]," computes the first variation using native xPert. The expression can be a copied tensor or a registered formula. We use the mixed Einstein tensor because the mixed spatial stress of homogeneous scalar matter has no tensor anisotropic part.\n\nThese are the vacuum tensor equation on Minkowski and the unsourced tensor sector on an on-shell FLRW background; the trial scalar profiles above need not themselves satisfy the background equations."}],"Text"],

Cell[BoxData["dGM = Einstein[CDM][aM,-bM] // PerturbOn[1]"],"Input",CellTags->"wave_abstract_m"],

Cell[BoxData["dGF = Einstein[CDFLRW][aFLRW,-bFLRW] // PerturbOn[1]"],"Input",CellTags->"wave_abstract_f"],

Cell[TextData[{"The expressions have identical abstract structure but use independent metrics, perturbations and derivatives. For this longer expression, use one background caption instead of repeated object labels."}],"Text"],

Cell[BoxData["PrettyExp[\"FLRW\", dGF, CovariantStyle -> \"Native\", ShowObjectLabels -> False, ShowBackgroundLabel -> True]"],"Input",CellTags->"wave_pretty"],

Cell[TextData[{"Assign the tensor profile. ",StyleBox["LI[1]",FontFamily->"Courier",FontSize->14]," labels the first variation, not a component index. The primary metric matrices from section 3 are unchanged."}],"Text"],

Cell[BoxData["DefScalarFunction[gam, PrintAs -> \"\\[Gamma]\"];"],"Input",CellTags->"gamma_fn"],

Cell[BoxData["AllComponentValues[hM[LI[1],-aM,-bM], DiagonalMatrix[{0,gam[tM[],zM[]],-gam[tM[],zM[]],0}]];"],"Input",CellTags->"assign_h1"],

Cell[BoxData["AllComponentValues[hFLRW[LI[1],-aFLRW,-bFLRW], s[tFLRW[]]^2 DiagonalMatrix[{0,gam[tFLRW[],zFLRW[]],-gam[tFLRW[],zFLRW[]],0}]];"],"Input",CellTags->"assign_h1_f"],

Cell[TextData[{"Extract the mixed xx entry, with ",StyleBox["FreeIndices",FontFamily->"Courier",FontSize->14]," fixing the row and column order. Multiply by two to write the standard wave equation. Requesting only the needed component avoids producing an entire array."}],"Text"],

Cell[BoxData["gwM = 2 First[dGM // ToComponents[FreeIndices -> {aM,-bM}, Components -> {{1,1}}]]"],"Input",CellTags->"gw_m"],

Cell[BoxData["gwM == 0"],"Input",CellTags->"gw_m_eq"],

Cell[BoxData["gwF = 2 First[dGF // ToComponents[FreeIndices -> {aFLRW,-bFLRW}, Components -> {{1,1}}]]"],"Input",CellTags->"gw_f"],

Cell[BoxData["gwF == 0"],"Input",CellTags->"gw_f_eq"],

Cell[TextData[{"The FLRW equation contains the expansion term 3 (s'/s) gamma_t and the spatial derivative divided by s^2. The Minkowski equation has neither modification.\n\nBoth were obtained from the same abstract operation, with independent component inputs."}],"Text"]
},Open]],

Cell[CellGroupData[{
Cell["Second order and a quadratic wave source","Subsection"],

Cell[TextData[{"A second variation is not the coefficient of eps^2: the Taylor coefficient is half the second variation.\n\nSet the independent second-order covariant metric perturbation to zero to isolate terms quadratic in the first-order wave. The inverse metric still acquires a second-order correction."}],"Text"],

Cell[BoxData["AllComponentValues[hM[LI[2],-aM,-bM], ConstantArray[0,{4,4}]];"],"Input",CellTags->"assign_h2"],

Cell[BoxData["delta2 = gM[aM,bM] // PerturbOn[2]"],"Input",CellTags->"delta2"],

Cell[BoxData["delta2G = delta2 // ToComponents;"],"Input",CellTags->"d2g"],

Cell[BoxData["delta2G // MatrixForm"],"Input",CellTags->"d2g_view"],

Cell[BoxData["gM[aM,bM] // PerturbOn[2, PerturbationForm -> \"TaylorCoefficient\"] // ToComponents // MatrixForm"],"Input",CellTags->"taylor"],

Cell[TextData[{"In the short-wavelength, transverse-traceless approximation, the effective gravitational-wave stress tensor on a vacuum background is obtained by averaging the derivative bilinear below, with prefactor 1/(4 kappa).\n\nBuild the unaveraged expression from native copied tensors, then extract its energy-density component. This illustrates a quadratic source for backreaction, not the full second-order Einstein equation."}],"Text"],

Cell[BoxData["waveSource = CDM[-aM][hM[LI[1],-cM,-dM]] CDM[-bM][hM[LI[1],cM,dM]]/(4 kap)"],"Input",CellTags->"gw_quadratic"],

Cell[BoxData["gwEnergy = First[waveSource // ToComponents[FreeIndices -> {-aM,-bM}, Components -> {{0,0}}]]"],"Input",CellTags->"gw_energy"],

Cell[TextData[{"For a monochromatic Minkowski wave gamma = amp Cos[w (t-z)], the phase average of Sin^2 is 1/2. Evaluate that average using the already calculated derivative expression."}],"Text"],

Cell[BoxData["DefConstantSymbol[amp];"],"Input",CellTags->"gw_amp"],

Cell[BoxData["gwModeEnergy = gwEnergy /. Derivative[1,0][gam][tM[],zM[]] -> -amp w Sin[w (tM[]-zM[])]"],"Input",CellTags->"gw_energy_mode"],

Cell[BoxData["gwModeEnergy /. Sin[w (tM[]-zM[])]^2 -> 1/2"],"Input",CellTags->"gw_average"],

Cell[TextData[{"The averaged density is amp^2 w^2/(4 kappa). A self-consistent backreaction calculation would also require second-order field equations, gauge choices and appropriate averaging; xPlorer does not impose these automatically."}],"Text"]
},Open]]
},Closed]],

Cell[CellGroupData[{
Cell["5. Reuse the geometry with new inputs and charts","Section"],

Cell[CellGroupData[{
Cell["Switch field profiles","Subsection"],

Cell[TextData[{StyleBox["RegisterProfile",FontFamily->"Courier",FontSize->14]," stores a field input under a name. Save the plane wave and register a quadratic transverse profile.\n\n",StyleBox["ActivateProfile",FontFamily->"Courier",FontSize->14]," changes the field input without rebuilding the geometry."}],"Text"],

Cell[BoxData["RegisterProfile[\"Minkowski\", \"PlaneWave\"];"],"Input",CellTags->"wave_save"],

Cell[BoxData["RegisterProfile[\"Minkowski\", \"Radial\", phi, Function[{tt,xx,yy,zz}, xx^2+yy^2]];"],"Input",CellTags->"radial_save"],

Cell[BoxData["ActivateProfile[\"Minkowski\", \"Radial\"];"],"Input",CellTags->"radial_activate"],

Cell[BoxData["phiM[] // ToComponents"],"Input",CellTags->"radial_value"],

Cell[TextData[{"Evaluate the Klein-Gordon equation with the new profile. Its wave operator equals 4, while the mass term remains."}],"Text"],

Cell[BoxData["kgM // ToComponents"],"Input",CellTags->"profile_equation"],

Cell[BoxData["ShowBackground[\"Minkowski\", \"Profiles\"]"],"Input",CellTags->"profile_list"]
},Open]],

Cell[CellGroupData[{
Cell["The same field in cylindrical coordinates","Subsection"],

Cell[TextData[{"Define a cylindrical chart by giving the primary Cartesian coordinates as functions of the new ones.\n\nThe geometry and original field input remain unchanged. The C marker distinguishes cylindrical coordinates from the Cartesian M coordinates."}],"Text"],

Cell[BoxData["DefineChart[\"Minkowski\", \"Cylindrical\", {t[],r[],theta[],z[]}, Function[{tt,rr,th,zz},{tt,rr Cos[th],rr Sin[th],zz}], BackgroundLabel -> \"C\"];"],"Input",CellTags->"cyl"],

Cell[BoxData["PrintAs[Evaluate[thetaCylindricalM]] ^= \"\\[Theta]\";"],"Input",CellTags->"angle_c"],

Cell[BoxData["gM[-aM,-bM] // ToComponents[OutputChart -> \"Cylindrical\"] // MatrixForm"],"Input",CellTags->"metric_c"],

Cell[BoxData["phiM[] // ToComponents[OutputChart -> \"Cylindrical\"]"],"Input",CellTags->"profile_c"],

Cell[TextData[{"The two coordinate formulas describe the same scalar field.\n\n",StyleBox["OutputChart",FontFamily->"Courier",FontSize->14]," also transforms tensor slots. For instance, the angular component of the Hessian is nonzero even though the cylindrical scalar is simply r^2."}],"Text"],

Cell[BoxData["hessianM // ToComponents[OutputChart -> \"Cylindrical\", FreeIndices -> {-aM,-bM}] // MatrixForm"],"Input",CellTags->"hess_c"],

Cell[TextData[{StyleBox["FreeIndices",FontFamily->"Courier",FontSize->14]," fixes the order of the array axes.\n\nRestore the saved plane-wave profile and verify that the original residual is recovered."}],"Text"],

Cell[BoxData["ActivateProfile[\"Minkowski\", \"PlaneWave\"];"],"Input",CellTags->"restore_wave"],

Cell[BoxData["Simplify[(kgM // ToComponents)-waveResidual]"],"Input",CellTags->"wave_again"],

Cell[TextData[{"The three independent geometries, their field values and perturbation tensors remain available in the same kernel."}],"Text"],

Cell[BoxData["ShowBackground[]"],"Input",CellTags->"models_final"],

Cell[TextData[{"For independent affine connections, additional presentation options, sparse tensor assignments and lifecycle operations, see the API Examples notebook."}],"Text"]
},Open]]
},Closed]]
},PageWidth->WindowWidth,WindowTitle->"xPlorer - Research workflow",StyleDefinitions->Notebook[{
 Cell[StyleData[StyleDefinitions -> "Default.nb"]],
 Cell[StyleData["Code"], FontSize -> 13, FontWeight -> "Plain"],
 Cell[StyleData["Subsubsection"], FontSize -> 18, FontWeight -> "Bold"],
 Cell[StyleData["Title"], FontSize -> 28, FontWeight -> "Bold"],
 Cell[StyleData["Subtitle"], FontSize -> 14, FontSlant -> "Italic"],
 Cell[StyleData["Section"], FontSize -> 22, FontWeight -> "Bold"],
 Cell[StyleData["Subsection"], FontSize -> 18, FontWeight -> "Bold"],
 Cell[StyleData["Text"], FontSize -> 14, LineSpacing -> {1.25,2}, CellMargins -> {{40,24},{6,6}}, PageWidth -> WindowWidth],
 Cell[StyleData["Input"], FontSize -> 14, PageWidth -> WindowWidth, CellFrame -> {{1,0},{0,0}}, CellFrameMargins -> {{10,8},{6,6}}],
 Cell[StyleData["Output"], FontSize -> 14, PageWidth -> WindowWidth, FormatType -> StandardForm],
 Cell[StyleData["DisplayFormula"], FontSize -> 17],
 Cell[StyleData["Important"], FontSize -> 15, FontWeight -> "Bold", LineSpacing -> {1.2,0}, CellMargins -> {{66,10},{8,8}}, CellFrame -> {{2,0},{0,0}}, CellFrameMargins -> {{10,8},{7,7}}],
 Cell[StyleData["Tip"], FontSize -> 15, FontSlant -> "Italic", LineSpacing -> {1.2,0}, CellMargins -> {{78,10},{8,8}}, CellFrameMargins -> {{10,8},{6,6}}],
 Cell[StyleData["Program"], FontSize -> 13, FontFamily -> "Courier", FontWeight -> "Plain", LineSpacing -> {1.1,2}, CellFrame -> {{0.5,0},{0,0}}, CellFrameMargins -> {{8,8},{4,4}}, PageWidth -> WindowWidth]
},Visible->False,StyleDefinitions->"PrivateStylesheetFormatting.nb"],Saveable->True]

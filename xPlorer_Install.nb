(* Content-type: application/vnd.wolfram.mathematica *)
Notebook[{
Cell["xPlorer — Paclet installation","Title"],

Cell["This notebook builds, installs, verifies and uninstalls xPlorer. Keep it beside the Paclet and Tools directories. Install xAct separately first. Evaluate individual input cells with Shift+Enter; do not evaluate the whole notebook, since the final section uninstalls xPlorer.","Text"],

Cell["1. Build the paclet","Section"],

Cell["Evaluate this cell to create the distributable archive in the build directory. The builder archives the already prepared Paclet directory using CreatePacletArchive; development files are outside it.","Text"],

Cell[BoxData[RowBox[{"build", "=", RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{RowBox[{"NotebookDirectory", "[", "]"}], ",", "\"Tools\"", ",", "\"BuildPaclet.wl\""}], "}"}], "]"}], "]"}]}]],"Input",CellTags->"install_4"],

Cell[BoxData[RowBox[{"If", "[", RowBox[{RowBox[{"MatchQ", "[", RowBox[{"build", ",", "_Success"}], "]"}], ",", RowBox[{"{", RowBox[{RowBox[{"build", "[", "\"PacletArchive\"", "]"}], ",", RowBox[{"FileExistsQ", "[", RowBox[{"build", "[", "\"PacletArchive\"", "]"}], "]"}]}], "}"}], ",", "build"}], "]"}]],"Input",CellTags->"install_5"],

Cell["2. Install","Section"],

Cell["Use a fresh kernel. Avoid a conflicting traditional installation under Applications. This installs the archive from step 1. If xPlorer is already loaded, restart the kernel before using the newly installed version.","Text"],

Cell[BoxData[RowBox[{"If", "[", RowBox[{RowBox[{RowBox[{"MatchQ", "[", RowBox[{"build", ",", "_Success"}], "]"}], "&&", RowBox[{"FileExistsQ", "[", RowBox[{"build", "[", "\"PacletArchive\"", "]"}], "]"}]}], ",", RowBox[{"PacletInstall", "[", RowBox[{"build", "[", "\"PacletArchive\"", "]"}], "]"}], ",", RowBox[{"Failure", "[", RowBox[{"\"NoArchive\"", ",", RowBox[{"Association", "[", RowBox[{"\"MessageTemplate\"", "\[Rule]", "\"Build the paclet in step 1 first.\""}], "]"}]}], "]"}]}], "]"}]],"Input",CellTags->"install_8"],

Cell["Alternatively, if you already have a paclet archive, select it directly using this cell instead of building it.","Text"],

Cell[BoxData[RowBox[{RowBox[{"archive", "=", RowBox[{"SystemDialogInput", "[", "\"FileOpen\"", "]"}]}], ";", RowBox[{"If", "[", RowBox[{RowBox[{RowBox[{"StringQ", "[", "archive", "]"}], "&&", RowBox[{"FileExistsQ", "[", "archive", "]"}], "&&", RowBox[{RowBox[{"FileExtension", "[", "archive", "]"}], "===", "\"paclet\""}]}], ",", RowBox[{"PacletInstall", "[", "archive", "]"}], ",", "\"No paclet selected.\""}], "]"}]}]],"Input",CellTags->"install_10"],

Cell["3. Verify in a fresh kernel","Section"],

Cell["Restart the kernel using Evaluation > Quit Kernel > Local, then evaluate the following cells. The package should load from the installed paclet rather than an old Applications copy.","Text"],

Cell[BoxData[RowBox[{"PacletFind", "[", "\"xPlorer\"", "]"}]],"Input",CellTags->"install_13"],

Cell[BoxData[RowBox[{"Needs", "[", "\"xPlorer`\"", "]"}]],"Input",CellTags->"install_14"],

Cell[BoxData[RowBox[{"{", RowBox[{"xPlorer`$XPlorerVersion", ",", RowBox[{"FindFile", "[", "\"xPlorer`\"", "]"}], ",", RowBox[{RowBox[{"(", RowBox[{RowBox[{"#1", "[", "\"Location\"", "]"}], "&"}], ")"}], "/@", RowBox[{"PacletFind", "[", "\"xPlorer\"", "]"}]}]}], "}"}]],"Input",CellTags->"install_15"],

Cell["4. Uninstall (optional)","Section"],

Cell["WARNING: evaluate the next cell only to remove installed xPlorer paclets. A confirmation dialog protects against accidental uninstallation. It removes all installed xPlorer paclet versions, not the source directory, built archive, or xAct. A traditional Applications installation is not removed. Restart the kernel afterward.","Text"],

Cell[BoxData[RowBox[{"If", "[", RowBox[{RowBox[{"TrueQ", "[", RowBox[{"ChoiceDialog", "[", "\"Uninstall all installed xPlorer paclet versions?\"", "]"}], "]"}], ",", RowBox[{"PacletUninstall", "/@", RowBox[{"PacletFind", "[", "\"xPlorer\"", "]"}]}], ",", "\"Uninstallation cancelled.\""}], "]"}]],"Input",CellTags->"install_18"],

Cell[BoxData[RowBox[{"PacletFind", "[", "\"xPlorer\"", "]"}]],"Input",CellTags->"install_19"]
}, WindowTitle->"xPlorer - Paclet installation", StyleDefinitions->"Default.nb"]

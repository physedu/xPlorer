 "Sector parameters" -> SameQ[Keys[sector["Parameters"]],{"Mass"}],
 "Sector lagrangians" -> SameQ[Keys[sector["Lagrangians"]],{"Kinetic","MassTerm","Lagrangian"}],
 "Sector expressions" -> SameQ[Keys[sector["Expressions"]],{"ScalarEq","Gradient","Hessian","Eab","boxPhi"}],
 "Scalar variation" -> TrueQ[ToCanonical[ContractMetric[scalarEq-(CD[a][CD[-a][phi[]]]-m^2 phi[])]]==0],

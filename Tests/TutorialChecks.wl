 "Taylor factor" -> SameQ[delta2G,2taylor2],
 "Old metric registered" -> SameQ[o["before_deletion"],True],
 "Owned background deleted" -> SameQ[o["delete_background"],{False,False}],
 "Recreation starts empty" -> SameQ[o["recreate_background"],<||>],
 "Fresh vector" -> SameQ[o["fresh_vector"],{-5,0,0,0}],
 "Single field removed" -> SameQ[o["delete_single_field"],False],
 "Other profiles retained" -> SameQ[{ToComponents["Schwarzschild",phi[]],ToComponents["FLRW",phi[]]},{u[rSchw],q[tF]}],
 "Source definitions retained" -> And[ManifoldQ[M],MetricQ[g],xTensorQ[phi],xTensorQ[S],xTensorQ[A]],

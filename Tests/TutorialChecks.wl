 "Existing background snapshot" -> SameQ[Keys[ShowBackground["Minkowski"]["Field"]],{"phi"}],
 "Vector variance and contraction" -> SameQ[o["vector_values"],{{1,2,3,4},{-1,2,3,4},28}],

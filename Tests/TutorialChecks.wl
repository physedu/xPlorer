 "Mass restored" -> !FreeQ[o["restore_massive"],m] && ShowRules["Schwarzschild"]==={},
 "Flat curvature rule" -> SameQ[o["flat_rules"],0] && ShowRules["Minkowski"]==={},
 "Minkowski equation" -> TrueQ[Simplify[eqMink-(-D[PhiM[tM,xM,yM,zM],{tM,2}]+D[PhiM[tM,xM,yM,zM],{xM,2}]+D[PhiM[tM,xM,yM,zM],{yM,2}]+D[PhiM[tM,xM,yM,zM],{zM,2}]-m^2 PhiM[tM,xM,yM,zM])]==0],
 "View identity" -> SameQ[o["view_identity"],True],
 "Schwarzschild radial equation" -> SameQ[radialCheck,0],
 "Schwarzschild Ricci scalar" -> SameQ[ricciSchw,0],
 "Schwarzschild Kretschmann" -> TrueQ[Simplify[kretschmannSchw-48 Mbh^2/rSchw^6]==0],
 "Formula export replay" -> MatchQ[o["document_formula"],{_String,True,True}],
 "FLRW equation" -> TrueQ[Simplify[eqFLRW-(-q''[tF]-3 s'[tF]/s[tF] q'[tF]-m^2 q[tF])]==0],

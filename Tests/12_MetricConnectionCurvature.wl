DefCovD[DM[-a],{},FromMetric->g,Torsion->True];RegisterTheory["Connection","MetricAffine",DM];
CreateBackground["MetricAffineValues"];DefineChart["MetricAffineValues",{"t","x","y","z"}];
SetCMetricSystem["MetricAffineValues",Function[{tt,xx,yy,zz},DiagonalMatrix[{-1,Exp[2tt],Exp[2tt],Exp[2tt]}]]];
SetConnectionComponents["MetricAffineValues","MetricAffine",ConstantArray[0,{4,4,4}],ReferenceConnection->"Primary"];
assert["extra-metric-einstein",ToComponents["MetricAffineValues",Einstein[DM][-a,-b],Components->{{0,0}},StrictComponents->True],{3}];
assert["extra-metric-weyl",ToComponents["MetricAffineValues",Weyl[DM][-a,-b,-c,-d],Components->{{0,1,0,1}},StrictComponents->True],{0}];
assert["extra-metric-kretschmann",ToComponents["MetricAffineValues",Kretschmann[DM][],StrictComponents->True],24];
DeleteBackground["MetricAffineValues"];UnregisterTheory["Connections"];UndefCovD[DM];
DefCovD[DN[-a],{},FromMetric->g,Torsion->True];RegisterTheory["Connection","MetricAffine",DN];
CreateBackground["MetricAffineScalar"];DefineChart["MetricAffineScalar",{"t","x","y","z"}];
SetCMetricSystem["MetricAffineScalar",Function[{tt,xx,yy,zz},DiagonalMatrix[{-1,Exp[2tt],Exp[2tt],Exp[2tt]}]]];
SetConnectionComponents["MetricAffineScalar","MetricAffine",ConstantArray[0,{4,4,4}],ReferenceConnection->"Primary"];
assert["extra-metric-ricci-scalar",ToComponents["MetricAffineScalar",RicciScalar[DN][],StrictComponents->True],12];
assert["extra-metric-tracefree-ricci",ToComponents["MetricAffineScalar",TFRicci[DN][-a,-b],Components->{{0,0}},StrictComponents->True],{0}];
SetCMetricSystem["MetricAffineScalar",DiagonalMatrix[{-1,1,1,1}]];
co=Through[CoordinatesOf["MetricAffineScalar"][]];contorsion=ConstantArray[0,{4,4,4}];contorsion[[2,2,3]]=co[[1]];contorsion[[3,2,2]]=-co[[1]];
SetConnectionComponents["MetricAffineScalar","MetricAffine",contorsion];
assert["extra-metric-torsion-kretschmann",ToComponents["MetricAffineScalar",Kretschmann[DN][],StrictComponents->True],-4];
DeleteBackground["MetricAffineScalar"];UnregisterTheory["Connections"];UndefCovD[DN];

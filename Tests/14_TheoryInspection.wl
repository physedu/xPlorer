(* Run after loading xPlorer in a fresh kernel. *)
ClearTheory[];
checks=<||>;
SetAttributes[verify,HoldAll];
verify[id_,expr_]:=AssociateTo[checks,id->TrueQ[expr]];
verify["empty-overview",Head[ShowTheory[]]===Column];
verify["empty-fields",Head[ShowTheory["Fields"]]===Grid];
verify["empty-snapshot",TheorySnapshot[]===<||>];
verify["unknown-section",FailureQ[ShowTheory["Unknown"]]];
DefManifold[viewM,4,{va,vb,vc,vd}];
DefMetric[-1,vg[-va,-vb],vcd];
DefTensor[vphi[],viewM];
DefConstantSymbol[vmass];
RegisterTheory["Metric",vg];
RegisterTheory["CovD",vcd];
RegisterTheory["Indices",{va,vb,vc,vd}];
RegisterTheory["Field",vphi,Sector->"Matter"];
RegisterTheory["Parameters",vmass,Sector->"Matter"];
Lview=-vmass^2 vphi[]^2/2;
RegisterTheory["Lagrangians","MassTerm"->Lview,Sector->"Matter"];
RegisterTheory["Expressions","Gradient"->vcd[-va][vphi[]],Head->"gradView",Sector->"Matter"];
saved=TheorySnapshot[];
verify["overview",Head[ShowTheory[]]===Column];
verify["all-details",AllTrue[{"Geometry","Fields","Parameters","Lagrangians","Expressions","Connections","Sectors","Metadata"},Head[ShowTheory[#]]===Grid&]];
verify["geometry",TheoryValue["Geometry"]["Dimension"]===4&&TheoryValue["Geometry"]["Manifold"]===viewM];
verify["sector-list",TheoryValue["Sectors"]==={"Matter"}];
verify["sector-records",Keys[TheorySector["Matter"]["Fields"]]==={"vphi"}];
verify["keys",MemberQ[ShowTheoryKeys[],"Lagrangians"]];
verify["formula-display-value",!FreeQ[ShowTheory["Lagrangians"],Lview]];
verify["view-no-mutation",TheorySnapshot[]===saved];
ClearTheory[];
With[{snapshot=saved},RegisterTheory[snapshot]];
verify["restore",TheorySnapshot[]===saved];
verify["create",!FailureQ[CreateBackground["ViewStudy",SymbolSuffix->"View"]]];
verify["field-object",BackgroundObject["ViewStudy","vphi"]===vphiView];
verify["formula-value",BackgroundExpression["ViewStudy","Lagrangians","MassTerm"]===LviewView];
verify["unknown-unregister",FailureQ[UnregisterTheory["Unknown"]]];
verify["view-retains-background",KeyExistsQ[$BG,"ViewStudy"]];
<|"Version"->$XPlorerVersion,"Passed"->Count[Values[checks],True],"Total"->Length[checks],"Failures"->Keys@Select[checks,#=!=True&]|>

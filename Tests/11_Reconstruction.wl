CreateBackground["RecipeCase"];DefineChart["RecipeCase",{"t","x","y","z"}];SetCMetricSystem["RecipeCase",DiagonalMatrix[{-1,1,1,1}]];
SetFieldComponents["RecipeCase",phi,Function[{tt,xx,yy,zz},tt^2+xx]];SetFieldComponents["RecipeCase",A,{1,2,3,4}];
SetPresentation["RecipeCase",<|"A"->"V"|>];SetRuleGroup["RecipeCase","Massless",{mass->0}];ActivateRuleGroups["RecipeCase",{"Massless"}];
recipe=ReconstructionData["RecipeCase"];DeleteBackground["RecipeCase"];
assert["recipe-recreation",AssociationQ[RecreateBackground["RecipeCase",recipe]],True];
coordsRecipe=Through[CoordinatesOf["RecipeCase"][]];
assert["recipe-coordinate-profile",ToComponents["RecipeCase",phi[]],coordsRecipe[[1]]^2+coordsRecipe[[2]]];
assert["recipe-vector-input",ToComponents["RecipeCase",A[a]],{-1,2,3,4}];
assert["recipe-rules",ApplyRules["RecipeCase",mass],0];
assert["recipe-presentation",With[{vv=BackgroundObject["RecipeCase","A"]},PrintAs[vv]],"V"];
assert["recipe-protect-existing",FailureQ[RecreateBackground["RecipeCase",recipe]],True];
DeleteBackground["RecipeCase"];
DefCovD[DR[-a],{},Torsion->True];RegisterTheory["Connection","Affine",DR];
CreateBackground["RecipeAffine"];DefineChart["RecipeAffine",{"t","x","y","z"}];SetCMetricSystem["RecipeAffine",DiagonalMatrix[{-1,1,1,1}]];
ccRecipe=Through[CoordinatesOf["RecipeAffine"][]];ggRecipe=ConstantArray[0,{4,4,4}];ggRecipe[[1,2,1]]=ccRecipe[[1]];
SetConnectionComponents["RecipeAffine","Affine",ggRecipe];SaveResult["RecipeAffine","old",1];
affineRecipe=ReconstructionData["RecipeAffine"];DeleteBackground["RecipeAffine"];
assert["recipe-affine-recreation",AssociationQ[RecreateBackground["RecipeAffineNew",affineRecipe]],True];
newCoordsRecipe=Through[CoordinatesOf["RecipeAffineNew"][]];
assert["recipe-affine-input",ConnectionMatrixOf["RecipeAffineNew","Affine"][[1,2,1]],newCoordsRecipe[[1]]];
assert["recipe-no-stale-result",FailureQ[ResultOf["RecipeAffineNew","old"]],True];
DeleteBackground["RecipeAffineNew"];UnregisterTheory["Connections"];UndefCovD[DR];

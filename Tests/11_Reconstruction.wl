CreateBackground["RecipeCase"];DefineChart["RecipeCase",{"t","x","y","z"}];SetCMetricSystem["RecipeCase",DiagonalMatrix[{-1,1,1,1}]];
SetFieldComponents["RecipeCase",phi,Function[{tt,xx,yy,zz},tt^2+xx]];SetFieldComponents["RecipeCase",A,{1,2,3,4}];
SetPresentation["RecipeCase",<|"A"->"V"|>];SetRuleGroup["RecipeCase","Massless",{mass->0}];ActivateRuleGroups["RecipeCase",{"Massless"}];
recipe=ReconstructionData["RecipeCase"];DeleteBackground["RecipeCase"];
assert["recipe-recreation",AssociationQ[RecreateBackground["RecipeCase",recipe]],True];
coordsRecipe=Through[CoordinatesOf["RecipeCase"][]];
assert["recipe-coordinate-profile",ToComponents["RecipeCase",phi[]],coordsRecipe[[1]]^2+coordsRecipe[[2]]];
assert["recipe-vector-input",ToComponents["RecipeCase",A[a]],{-1,2,3,4}];
assert["recipe-rules",ApplyRules["RecipeCase",mass],0];
assert["recipe-presentation",With[{vv=BackgroundObject["RecipeCase","A"]},PrintAs[vv]],"V"];
assert["recipe-protect-existing",FailureQ[RecreateBackground["RecipeCase",recipe]],True];
DeleteBackground["RecipeCase"];
DefCovD[DR[-a],{},Torsion->True];RegisterTheory["Connection","Affine",DR];
CreateBackground["RecipeAffine"];DefineChart["RecipeAffine",{"t","x","y","z"}];SetCMetricSystem["RecipeAffine",DiagonalMatrix[{-1,1,1,1}]];
ccRecipe=Through[CoordinatesOf["RecipeAffine"][]];ggRecipe=ConstantArray[0,{4,4,4}];ggRecipe[[1,2,1]]=ccRecipe[[1]];
SetConnectionComponents["RecipeAffine","Affine",ggRecipe];SaveResult["RecipeAffine","old",1];
affineRecipe=ReconstructionData["RecipeAffine"];DeleteBackground["RecipeAffine"];
assert["recipe-affine-recreation",AssociationQ[RecreateBackground["RecipeAffineNew",affineRecipe]],True];
newCoordsRecipe=Through[CoordinatesOf["RecipeAffineNew"][]];
assert["recipe-affine-input",ConnectionMatrixOf["RecipeAffineNew","Affine"][[1,2,1]],newCoordsRecipe[[1]]];
assert["recipe-no-stale-result",FailureQ[ResultOf["RecipeAffineNew","old"]],True];
DeleteBackground["RecipeAffineNew"];UnregisterTheory["Connections"];UndefCovD[DR];

(* Recreate customized abstract indices and remap secondary-chart references. *)
customRecipeIndices={\[Alpha],\[Beta],\[Gamma],\[Delta],\[Mu],\[Nu],\[Rho],\[Sigma]};
CreateBackground["ChartRecipe",Indices->customRecipeIndices];
DefineChart["ChartRecipe",{"t","x","y","z"}];
SetCMetricSystem["ChartRecipe",DiagonalMatrix[{-1,1,1,1}]];
DefineChart["ChartRecipe","Scaled",{"T","X","Y","Z"},Function[{tt,xx,yy,zz},{tt,2 xx,yy,zz}]];
oldRecipeCoordinates=CoordinatesOf["ChartRecipe","Scaled"];
oldRecipeX=oldRecipeCoordinates[[2]][];
oldRecipeChart=ChartOf["ChartRecipe","Scaled"];
SetRuleGroup["ChartRecipe","Point",{oldRecipeX->3}];
ActivateRuleGroups["ChartRecipe",{"Point"}];
oldRecipeLabels=PrintAs /@ BackgroundIndices["ChartRecipe",8];
chartRecipe=ReconstructionData["ChartRecipe"];
assert["recipe-chart-copy",AssociationQ[RecreateBackground["ChartRecipeCopy",chartRecipe]],True];
newRecipeX=CoordinatesOf["ChartRecipeCopy","Scaled"][[2]][];
assert["recipe-display-indices",PrintAs /@ BackgroundIndices["ChartRecipeCopy",8],oldRecipeLabels];
assert["recipe-secondary-coordinate-rule",ApplyRules["ChartRecipeCopy",newRecipeX],3];
assert["recipe-secondary-rule-no-old-coordinate",FreeQ[ShowRules["ChartRecipeCopy"],oldRecipeCoordinates[[2]]],True];
assert["recipe-secondary-chart-metric",ToComponents["ChartRecipeCopy",g[-a,-b],OutputChart->"Scaled"],DiagonalMatrix[{-1,4,1,1}]];
assert["recipe-original-rule-isolated",ApplyRules["ChartRecipe",oldRecipeX],3];
ClearRules["ChartRecipeCopy"];
ActivateRuleGroups["ChartRecipeCopy",{"Point"}];
assert["recipe-secondary-rule-group",ApplyRules["ChartRecipeCopy",newRecipeX],3];
DeleteBackground["ChartRecipeCopy"];
assert["recipe-chart-delete-original",FailureQ[DeleteBackground["ChartRecipe"]],False];
assert["recipe-chart-recreate-same-tag",AssociationQ[RecreateBackground["ChartRecipe",chartRecipe]],True];
assert["recipe-secondary-same-tag",ApplyRules["ChartRecipe",CoordinatesOf["ChartRecipe","Scaled"][[2]][]],3];
assert["recipe-same-tag-display",PrintAs /@ BackgroundIndices["ChartRecipe",8],oldRecipeLabels];
DeleteBackground["ChartRecipe"];

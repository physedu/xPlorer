(* Run in a fresh kernel after loading xPlorer. *)
Get[FileNameJoin[{DirectoryName[$InputFileName],"Fixture.wl"}]];
makeBackground["Profiles",{"t","x","y","z"},DiagonalMatrix[{-1,1,1,1}]];
SetFieldComponents["Profiles",phi,Function[{t,x,y,z},x^2]];
SetFieldComponents["Profiles",A,{1,2,3,4},IndexPositions->{-1}];
SetFieldComponents["Profiles",S,IdentityMatrix[4]];
RegisterProfile["Profiles","Original"];
SaveResult["Profiles","Before",42];
runs=ShowBackground["Profiles"]["GeometryRuns"];
RegisterProfile["Profiles","Alternative",phi,Function[{t,x,y,z},x^3]];
RegisterProfile["Profiles","Alternative",A,{1,2,3,4},IndexPositions->{1}];
assert["registration-does-not-activate",ToComponents["Profiles",A[a]],{-1,2,3,4}];
assert["registration-retains-results",ResultOf["Profiles","Before"],42];
assert["invalid-profile-shape",FailureQ[RegisterProfile["Profiles","Invalid",A,{1,2}]],True];
assert["invalid-profile-no-record",KeyExistsQ[ShowProfiles["Profiles"],"Invalid"],False];
assert["invalid-profile-symmetry",FailureQ[RegisterProfile["Profiles","Invalid",F,IdentityMatrix[4]]],True];
assert["unknown-profile",FailureQ[ActivateProfile["Profiles","Unknown"]],True];
assert["profile-names",Keys[ShowProfiles["Profiles"]],{"Original","Alternative"}];
ActivateProfile["Profiles","Alternative"];
xx=Through[CoordinatesOf["Profiles"][]][[2]];
assert["profile-scalar",ToComponents["Profiles",phi[]],xx^3];
assert["profile-contravariant",ToComponents["Profiles",A[a]],{1,2,3,4}];
assert["profile-covariant",ToComponents["Profiles",A[-a]],{-1,2,3,4}];
assert["profile-other-field-retained",ToComponents["Profiles",S[-a,-b]],IdentityMatrix[4]];
assert["profile-cache-reused",ShowBackground["Profiles"]["GeometryRuns"],runs];
assert["profile-results-invalidated",FailureQ[ResultOf["Profiles","Before"]],True];
ActivateProfile["Profiles","Original"];
assert["profile-restored",ToComponents["Profiles",A[-a]],{1,2,3,4}];
assert["profile-restored-scalar",ToComponents["Profiles",phi[]],xx^2];
ch=ChartOf["Profiles"];
assert["ctensor-down",ToComponents["Profiles",A[-a],Output->"CTensor"],CTensor[{1,2,3,4},{-ch}]];
assert["ctensor-up",ToComponents["Profiles",A[a],Output->"CTensor"],CTensor[{-1,2,3,4},{ch}]];
assert["ctensor-mixed",ToComponents["Profiles",A[a] A[-b],FreeIndices->{a,-b},Output->"CTensor"],CTensor[Outer[Times,{-1,2,3,4},{1,2,3,4}],{ch,-ch}]];
assert["ctensor-selection-rejected",FailureQ[ToComponents["Profiles",A[-a],Output->"CTensor",Components->{{0}}]],True];
assert["ctensor-scalar-rejected",FailureQ[ToComponents["Profiles",phi[],Output->"CTensor"]],True];
assert["ctensor-unknown-output",FailureQ[ToComponents["Profiles",A[-a],Output->"bad"]],True];
assert["ctensor-unassigned-rejected",FailureQ[ToComponents["Profiles",F[-a,-b],Output->"CTensor"]],True];
DefineChart["Profiles","Scaled",{"t","X","Y","Z"},Function[{t,X,Y,Z},{t,2 X,Y,Z}]];
newch=ChartOf["Profiles","Scaled"];
assert["ctensor-output-chart",ToComponents["Profiles",g[-a,-b],OutputChart->"Scaled",Output->"CTensor"],CTensor[DiagonalMatrix[{-1,4,1,1}],{-newch,-newch}]];
recipe=ReconstructionData["Profiles"];
RecreateBackground["ProfilesCopy",recipe];
assert["profile-reconstructed-names",Keys[ShowProfiles["ProfilesCopy"]],{"Original","Alternative"}];
ActivateProfile["ProfilesCopy","Alternative"];
xxcopy=Through[CoordinatesOf["ProfilesCopy"][]][[2]];
assert["profile-reconstructed-scalar",ToComponents["ProfilesCopy",phi[]],xxcopy^3];
assert["profile-reconstructed-variance",ToComponents["ProfilesCopy",A[a]],{1,2,3,4}];
ClearFieldComponents["Profiles",A];
ActivateProfile["Profiles","Original"];
assert["profile-restores-cleared-input",ToComponents["Profiles",A[-a]],{1,2,3,4}];
RemoveProfile["Profiles","Original"];
assert["profile-remove-no-mutation",ToComponents["Profiles",A[-a]],{1,2,3,4}];
assert["profile-remove-name",Keys[ShowProfiles["Profiles"]],{"Alternative"}];
assert["profile-remove-unknown",FailureQ[RemoveProfile["Profiles","Unknown"]],True];
(* On a separate abstract/managed chart, deletion cannot retain stale coordinate references. *)
makeBackground["ProfileDelete",{"t","x","y","z"},DiagonalMatrix[{-1,1,1,1}]];
RegisterProfile["ProfileDelete","Radial",phi,Function[{t,x,y,z},x^2]];
assert["profile-delete-chart",FailureQ[DeleteBackgroundObject["ProfileDelete","Chart",Cascade->True]],False];
assert["profile-chart-clears-records",ShowProfiles["ProfileDelete"],<||>];
assert["profile-no-chart",FailureQ[RegisterProfile["ProfileDelete","New",phi,1]],True];
<|"Version"->$XPlorerVersion,"Total"->Length[testResults],"Passed"->Count[Lookup[testResults,"Passed"],True],"Failures"->Select[testResults,!TrueQ[#["Passed"]]&]|>

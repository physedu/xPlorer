(* The managed metric input contract and the geometry assumption cache policy. *)
DefManifold[PolicyM,4,{aa,bb,cc,dd,ee,ff,ii,jj}];
DefMetric[-1,gg[-aa,-bb],CDa];DefConstantSymbol[ka];DefScalarFunction[scale];
DefTensor[phia[],PolicyM];DefTensor[VA[-aa],PolicyM];
RegisterTheory["Metric",gg];RegisterTheory["CovD",CDa];RegisterTheory["Indices",{aa,bb,cc,dd,ee,ff,ii,jj}];
RegisterTheory["Fields",{phia,VA}];RegisterTheory["Parameter",ka];
CreateBackground["One",SymbolSuffix->"O"];CreateBackground["Two",SymbolSuffix->"T"];
DefineChart["One",{tt[],xx[],yy[],zz[]}];DefineChart["Two",{tt[],xx[],yy[],zz[]}];
ch=ChartOf["One"];SetFieldComponents["One",phia,ttO[]^3];
bad=DiagonalMatrix[{-1,phiaO[]^2,phiaO[]^2,phiaO[]^2}];
checks=<||>;SetAttributes[check,HoldRest];
check[key_,actual_,expected_]:=Module[{x=actual,y=expected},checks[key]=<|"Passed"->SameQ[x,y],"Actual"->ToString[x,InputForm],"Expected"->ToString[y,InputForm]|>];
blockedQ[x_]:=MatchQ[x,Failure["UnresolvedMetricTensor",_Association]];
check["Reject unresolved field in first metric",blockedQ[SetCMetricSystem["One",bad,ComputeOnSet->None]],True];
check["No metric installed by rejection",KeyExistsQ[BackgroundValue["One"],"MetricMatrix"],False];
MetricInBasis[ggO,DiagonalMatrix[{-1,ttO[]^6,ttO[]^6,ttO[]^6}]];
check["Explicit coordinate profile curvature",ToComponents["One",RicciScalarCDa[],StrictComponents->True],90/ttO[]^2];
old=BackgroundValue["One"];
check["Managed shorthand rejected",blockedQ[MetricInBasis[ggO,bad]],True];
check["Native explicit primary matrix rejected",blockedQ[MetricInBasis[ggO,-ch,bad]],True];
check["Native component edit rejected",blockedQ[ComponentValue[ggO[{1,-ch},{1,-ch}],phiaO[]^2]],True];
check["Held metric component edit rejected",blockedQ[With[{metric=ggO,chart=ch},HeldComponentValue[metric[{1,-chart},{1,-chart}],phiaO[]^2]]],True];
check["Rejected edits preserve record",SameQ[old,BackgroundValue["One"]],True];
check["Ordinary scalar function accepted",AssociationQ[SetCMetricSystem["One",DiagonalMatrix[{-1,scale[ttO[]]^2,scale[ttO[]]^2,scale[ttO[]]^2}],ComputeOnSet->None]],True];
mat=DiagonalMatrix[{-1,(1+Abs[ka] ttO[])^2,(1+Abs[ka] ttO[])^2,(1+Abs[ka] ttO[])^2}];
SetCMetricSystem["One",mat,ComputeOnSet->None];SetCMetricSystem["Two",DiagonalMatrix[{-1,ttT[]^4,ttT[]^4,ttT[]^4}]];
AllComponentValues[VAO[-aaO],{0,1,0,0}];
rs=RicciScalar[CovDOfMetric[ggO]];
pos=Block[{$Assumptions=ka>0},ToComponents["One",RicciScalarCDa[],CVSimplify->Simplify,StrictComponents->True]];
nr=BackgroundValue["One"]["GeometryRuns"];
neg=Block[{$Assumptions=ka<0},ToComponents["One",RicciScalarCDa[],CVSimplify->Simplify,StrictComponents->True]];
check["Ambient sign does not poison persistent curvature",{pos,neg}/.{ka->-2,ttO[]->1},{8/3,8/3}];
check["Same explicit policy reuses cache",BackgroundValue["One"]["GeometryRuns"],nr];
check["Ambient assumption restored",Block[{$Assumptions=ka<0},ToComponents["One",RicciScalarCDa[],CVSimplify->Simplify];$Assumptions],ka<0];
ClearComputedValues["One"];
nativePos=Block[{$Assumptions=ka>0},MetricCompute[ggO,ch,"RicciScalar"[],CVSimplify->Simplify];ToValues[rs[]]];
nativeNeg=Block[{$Assumptions=ka<0},ToValues[rs[]]];
check["Native compute and reads use stable domain",{nativePos,nativeNeg}/.{ka->-2,ttO[]->1},{8/3,8/3}];
expPos=ToComponents["One",RicciScalarCDa[],CVSimplify->Simplify,Assumptions->ka>0,StrictComponents->True];
nr=BackgroundValue["One"]["GeometryRuns"];
expNeg=ToComponents["One",RicciScalarCDa[],CVSimplify->Simplify,Assumptions->ka<0,StrictComponents->True];
check["Explicit positive and negative domains",{expPos/.{ka->2,ttO[]->1},expNeg/.{ka->-2,ttO[]->1}},{8/3,8/3}];
check["Explicit policy change recomputes",BackgroundValue["One"]["GeometryRuns"]>nr,True];
check["Explicit policy tracked",BackgroundValue["One"]["GeometryPolicy"],{Simplify,ka<0}];
reset=ToComponents["One",RicciScalarCDa[],CVSimplify->Simplify,StrictComponents->True];
check["Automatic restores background domain",reset/.{ka->-2,ttO[]->1},8/3];
upPos=Block[{$Assumptions=ka>0},ToComponents["One",VA[aa],CVSimplify->Simplify,StrictComponents->True]];
upNeg=Block[{$Assumptions=ka<0},ToComponents["One",VA[aa],CVSimplify->Simplify,StrictComponents->True]];
check["Raised field independent of ambient branch",{upPos,upNeg}/.{ka->-2,ttO[]->1},{{0,1/9,0,0},{0,1/9,0,0}}];
(* Reproduce the explicit native inverse-assignment variant on a new metric. *)
CreateBackground["NativeInverse",SymbolSuffix->"I"];DefineChart["NativeInverse",{tt[],xx[],yy[],zz[]}];
chi=ChartOf["NativeInverse"];
mi=DiagonalMatrix[{-1,(1+Abs[ka] ttI[])^2,(1+Abs[ka] ttI[])^2,(1+Abs[ka] ttI[])^2}];
Block[{$Assumptions=ka>0},MetricInBasis[ggI,-chi,mi,Inverse->True,CVSimplify->Simplify]];
check["Explicit native inverse is not poisoned by ambient assumptions",ToValues[ggI[{1,chi},{1,chi}]]/.{ka->-2,ttI[]->1},1/9];
check["Native inverse assignment does not poison curvature",ToComponents["NativeInverse",RicciScalarCDa[],StrictComponents->True]/.{ka->-2,ttI[]->1},8/3];
check["Other background unchanged",ToComponents["Two",RicciScalarCDa[],StrictComponents->True],36/ttT[]^2];
<|"Total"->Length[checks],"Passed"->Count[Lookup[Values[checks],"Passed"],True],"Failed"->Count[Lookup[Values[checks],"Passed"],False],"Failures"->Select[checks,!TrueQ[#["Passed"]]&]|>

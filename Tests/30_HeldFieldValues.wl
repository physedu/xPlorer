(* Held native field reads and writes in primary chart, literal owned heads, rule state. *)
DefManifold[MN,4,{a,b,c,d,e,f}];DefMetric[-1,g[-a,-b],CD];
DefTensor[A[-a],MN];DefTensor[B[-a],MN];DefTensor[S[-a,-b],MN,Antisymmetric[{-a,-b}]];DefTensor[phi[],MN];DefMetricPerturbation[g,h,ep];DefTensor[unowned[-a],MN];
RegisterTheory["Metric",g];RegisterTheory["CovD",CD];RegisterTheory["Indices",{a,b,c,d,e,f}];RegisterTheory["Fields",{A,B,S,phi,h}];
nativeBefore=DownValues[HeldComponentValue];attributesBefore=Attributes[HeldComponentValue];
CreateBackground["N"];DefineChart["N",{"t","x","y","z"}];ch=ChartOf["N"];x=CoordinatesOf["N"][[2]][];
MetricInBasis[gN,{-1,1,1,1}];aa=BackgroundObject["N","A"];bb=BackgroundObject["N","B"];ss=BackgroundObject["N","S"];pp=BackgroundObject["N","phi"];hh=BackgroundObject["N","h"];
rec[head_]:=First[Select[Values[BackgroundValue["N"]["FieldComponents"]],#["Head"]===head&]];
ComponentValue[AN[{0,-ch}]->1];ComponentValue[{AN[{1,-ch}]->2,AN[{2,-ch}]->3}];ComponentValue[{AN[{0,-ch}],AN[{3,-ch}]},{4,5}];
checks=<|"Native rule and list writes already managed"->(rec[aa]["Values"]==={{0}->4,{1}->2,{2}->3,{3}->5})|>;
r=With[{head=aa,chart=ch},HeldComponentValue[head[{0,-chart}],7]];
checks["Held write returns native rule and updates record"]=MatchQ[r,_Rule]&&ToValues[AN[{0,-ch}]]===7&&rec[aa]["Values"]==={{0}->7,{1}->2,{2}->3,{3}->5};
r=With[{head=aa,chart=ch},HeldComponentValue[head[{0,chart}]]];
checks["Held read prepares only requested raised component"]=Last[r]===-7&&Length[Last[TensorValues[AN,{{ch}}]]]===1;
rev=BackgroundValue["N"]["DataRevision"];Block[{$CVReplace=False},With[{head=aa,chart=ch},HeldComponentValue[head[{0,-chart}],99]]];
checks["Held CVReplace false preserves input and revision"]=ToValues[AN[{0,-ch}]]===7&&BackgroundValue["N"]["DataRevision"]===rev;
Block[{$CVSimplify=Function[v,v+100]},With[{head=ss,chart=ch},HeldComponentValue[head[{1,-chart},{0,-chart}],3]]];
checks["Held write bypasses CVSimplify and native antisymmetry"]=ToValues[SN[{0,-ch},{1,-ch}]]===-3&&ToValues[SN[{1,-ch},{0,-ch}]]===3&&rec[ss]["Values"]==={{0,1}->-3};
Block[{$CVSimplify=Function[v,v+100]},With[{head=pp},HeldComponentValue[head[],x^2]]];
checks["Held scalar bypasses CVSimplify"]=ToValues[phiN[]]===x^2&&rec[pp]["Values"]===x^2;
With[{head=hh,chart=ch},HeldComponentValue[head[LI[2],{1,-chart},{0,-chart}],5]];
With[{head=hh,chart=ch},HeldComponentValue[head[LI[1],{0,-chart},{0,-chart}],6]];
checks["Held perturbation orders and symmetry"]=Last[With[{head=hh,chart=ch},HeldComponentValue[head[LI[2],{0,-chart},{1,-chart}]]]]===5&&Last[With[{head=hh,chart=ch},HeldComponentValue[head[LI[1],{0,chart},{0,chart}]]]]===6;
AllComponentValues[BN[-aN],{1,2,3,4}];Block[{$CVSimplify=Function[v,v+100]},With[{head=bb,chart=ch},HeldComponentValue[head[{0,-chart}],8]]];
checks["Held complete field records exact actual values"]=rec[bb]["Values"]==={8,2,3,4}&&ToValues[BN[{0,-ch}]]===8&&TrueQ[rec[bb]["ExactNativeValues"]];
rev=BackgroundValue["N"]["DataRevision"];With[{head=bb,chart=ch},HeldComponentValue[head[{0,-chart}],8]];
checks["Identical held complete edit is a no-op"]=BackgroundValue["N"]["DataRevision"]===rev;
Block[{xPlorer`Private`$insideManagedCalculation=True},ComponentValue[BN[{0,-ch}],77]];
With[{head=bb,chart=ch},HeldComponentValue[head[{0,-chart}],8]];
checks["Held repeated declared input repairs externally altered native source"]=ToValues[BN[{0,-ch}]]===8&&rec[bb]["Values"]==={8,2,3,4};
rev=BackgroundValue["N"]["DataRevision"];
bad=With[{head=bb,chart=ch},HeldComponentValue[head[{0,-chart}],head[{0,-chart}]+1]];
checks["Rejected self-referential dense edit leaves native source intact"]=FailureQ[bad]&&ToValues[BN[{0,-ch}]]===8&&BackgroundValue["N"]["DataRevision"]===rev;
With[{head=aa,chart=ch},HeldComponentValue[head[{3,-chart}],Null]];
checks["Held sparse component removal leaves symbolic slot"]=ToValues[AN[{3,-ch}]]===AN[{3,-ch}]&&rec[aa]["Values"]==={{0}->7,{1}->2,{2}->3};
With[{head=aa,chart=ch},HeldComponentValue[head[{0,-chart}],Function[v,100]]];
checks["Held existing Function semantics"]=ToValues[AN[{0,-ch}]]===7;
Block[{$CVSimplify=Function[v,v+100]},xPlorer`Private`replayFields["N"]];
checks["Replay does not resimplify held values"]=ToValues[phiN[]]===x^2&&ToValues[SN[{0,-ch},{1,-ch}]]===-3&&ToValues[BN[{0,-ch}]]===8;
ClearComputedValues["N"];
checks["Clear replay preserves held values"]=ToValues[AN[{0,-ch}]]===7&&ToValues[BN[{0,-ch}]]===8&&ToValues[phiN[]]===x^2&&ToValues[SN[{0,-ch},{1,-ch}]]===-3;
recipe=ReconstructionData["N"];copy=RecreateBackground["Copy",recipe];cc=ChartOf["Copy"];xc=CoordinatesOf["Copy"][[2]][];
checks["Reconstruction remaps held exact values"]=AssociationQ[copy]&&ToValues[ACopy[{0,-cc}]]===7&&ToValues[BCopy[{0,-cc}]]===8&&ToValues[phiCopy[]]===xc^2&&ToValues[SCopy[{0,-cc},{1,-cc}]]===-3;
checks["Literal scope excludes unevaluated arguments"]=With[{head=aa,chart=ch},!xPlorer`Private`heldManagedLiteralQ["N",head[{i,-chart}]]&&!xPlorer`Private`heldManagedLiteralQ["N",head[{0,-ch}]]];
RuleToSet[BN];checks["Set state explicitly left native"]=With[{head=bb,chart=ch},!xPlorer`Private`heldManagedLiteralQ["N",head[{0,-chart}]]];SetToRule[BN];
checks["Native Held attributes and downvalues unchanged"]=attributesBefore===Attributes[HeldComponentValue]&&nativeBefore===DownValues[HeldComponentValue];
checks["Cleanup"]=And@@(SameQ[DeleteBackground[#],Null]& /@ {"Copy","N"});
<|"Total"->Length[checks],"Passed"->Count[Values[checks],True],"Failures"->Keys@Select[checks,#=!=True&]|>

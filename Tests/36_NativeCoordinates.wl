(* Load after Fixture.wl in an isolated test context. *)
CreateBackground["NativeA",SymbolSuffix->"NA"];
assert["native-chart",FailureQ[DefineChart["NativeA",{t[],r[],theta[],varphi[]}]],False];
assert["native-chart-alias",chartNA,ChartOf["NativeA"]];
assert["native-coordinate-alias",rNA[],ScalarsOfChart[chartNA][[2]]];
assert["native-coordinate-print",With[{head=Head[rNA[]]},PrintAs[head]],"r"];
SetCMetricSystem["NativeA",DiagonalMatrix[{-1,1,1,1}]];
DefScalarFunction[profileF];
RegisterProfile["NativeA","Direct",phi,profileF[rNA[]]];
ActivateProfile["NativeA","Direct"];
assert["native-direct-profile",ToComponents["NativeA",phi[]],profileF[rNA[]]];
assert["native-primary-ricci",ToComponents["NativeA",RicciScalarCD[]],0];
CreateBackground["NativeB",SymbolSuffix->"NB"];
DefineChart["NativeB",{t[],r[],theta[],varphi[]}];
SetCMetricSystem["NativeB",DiagonalMatrix[{-1,1,Exp[4 rNB[]],1}]];
assert["native-second-ricci",ToComponents["NativeB",RicciScalarCD[]],-8];
SetCMetricSystem["NativeA",DiagonalMatrix[{-1,1,Exp[2 rNA[]],1}]];
assert["selective-recompute",ToComponents["NativeA",RicciScalarCD[]],-2];
assert["other-geometry-preserved",ToComponents["NativeB",RicciScalarCD[]],-8];
assert["native-metric-read",MetricMatrixOf["NativeA"],DiagonalMatrix[{-1,1,Exp[2 rNA[]],1}]];
DefineChart["NativeA","Scaled",{T[],u[],v[],w[]},Function[{T,u,v,w},{T,2 u,v,w}]];
assert["secondary-chart-alias",chartScaledNA,ChartOf["NativeA","Scaled"]];
assert["secondary-coordinate-alias",uScaledNA[],ScalarsOfChart[chartScaledNA][[2]]];
assert["native-explicit-basis-change",ToCTensor[CTensor[{1,2,3,4},{-chartNA}],{-chartScaledNA}],CTensor[{1,4,3,4},{-chartScaledNA}]];
assert["native-unary-ctensor",gNA[-aNA,-bNA]//ToCTensor,ToComponents["NativeA",g[-a,-b],Output->"CTensor"]];
assert["native-explicit-ctensor",FixedPoint[ToValues,ToCTensor[gNA,{-chartNA,-chartNA}],12],CTensor[MetricMatrixOf["NativeA"],{-chartNA,-chartNA}]];
assert["foreign-ctensor-unchanged",Head[ToCTensor[A[-a]]],ToCTensor];
assert["background-inspection",BackgroundValue["NativeA","Summary"]["Charts"],{"Primary","Scaled"}];
assert["background-connection-lookup",BackgroundObject["NativeA","Ricci","Primary"],Ricci[CDNA]];
assert["secondary-metric",ToComponents["NativeA",g[-a,-b],OutputChart->"Scaled"],DiagonalMatrix[{-1,4,Exp[4 uScaledNA[]],1}]];
recipeNative=ReconstructionData["NativeA"];
assert["native-reconstruction",FailureQ[RecreateBackground["NativeCopy",recipeNative]],False];
assert["native-copy-coordinates",rNativeCopy[],ScalarsOfChart[chartNativeCopy][[2]]];
assert["native-copy-profile",ToComponents["NativeCopy",phi[]],profileF[rNativeCopy[]]];
CreateBackground["Collision",SymbolSuffix->"COL"];
assert["coordinate-field-collision",FailureQ[DefineChart["Collision",{t[],r[],theta[],phi[]}]],True];
assert["collision-preserves-field",phiCOL,BackgroundObject["Collision","phi"]];
assert["collision-no-chart",FailureQ[ChartOf["Collision"]],True];
assert["collision-retry",FailureQ[DefineChart["Collision",{t[],r[],theta[],varphi[]}]],False];
assert["delete-native-chart",FailureQ[DeleteBackgroundObject["Collision","Chart",Cascade->True]],False];
assert["delete-releases-alias",OwnValues[rCOL],{}];
DeleteBackground["Collision"];
oldBasisName=ToString[chartNA,InputForm];newBasisName=ToString[chartScaledNA,InputForm];
assert["native-delete-A",DeleteBackground["NativeA"],Null];
assert["native-basis-values-removed",FreeQ[ToString[TensorValIDs[Basis],InputForm],_String?(StringContainsQ[#,newBasisName]&) ],True];
assert["native-delete-B",DeleteBackground["NativeB"],Null];
assert["native-delete-copy",DeleteBackground["NativeCopy"],Null];
UndefScalarFunction[profileF];

(* Consolidation acceptance tests. Run in a fresh kernel with xAct installed. *)
DefManifold[MN,4,{a,b,c,d,e,f,i,j}];DefMetric[-1,g[-a,-b],CD];
DefTensor[phi[],MN];DefTensor[A[-a],MN];DefTensor[F[-a,-b],MN,Antisymmetric[{-a,-b}]];
DefConstantSymbol[mass];DefConstantSymbol[Mbh];DefScalarFunction[scale];DefCovD[DA[-a],{},Torsion->True];
RegisterTheory["Metric",g];RegisterTheory["CovD",CD];RegisterTheory["Indices",{a,b,c,d,e,f,i,j}];
RegisterTheory["Fields",{phi,A,F}];RegisterTheory["Parameters",{mass,Mbh}];RegisterTheory["Connection","Affine",DA];
Lmatter=-CD[-a][phi[]] CD[a][phi[]]/2-mass^2 phi[]^2/2;
RegisterTheory["Lagrangians","Matter"->Lmatter];
kg=ToCanonical[ContractMetric[VarD[phi[],CD][Lmatter]]];
RegisterTheory["Expressions","KG"->kg];
checks=<||>;SetAttributes[check,HoldRest];check[name_,actual_,expected_]:=Module[{x=actual,y=expected},checks[name]=<|"Passed"->SameQ[x,y],"Actual"->ToString[x,InputForm],"Expected"->ToString[y,InputForm]|>];
CreateBackground["Schwarzschild",SymbolSuffix->"Schw"];
DefineChart["Schwarzschild",{t[],r[],theta[],varphi[]}];
check["Native coordinate alias",rSchw[],ScalarsOfChart[chartSchw][[2]]];
fSchw=1-2 Mbh/rSchw[];
matS=DiagonalMatrix[{-fSchw,1/fSchw,rSchw[]^2,rSchw[]^2 Sin[thetaSchw[]]^2}];
MetricInBasis[gSchw,-chartSchw,matS];
ComponentValue[phiSchw[],rSchw[]^2];
AllComponentValues[ASchw[{-aSchw,-chartSchw}],{1,2,3,4}];
check["Schwarzschild metric",MetricMatrixOf["Schwarzschild"],matS];
check["Schwarzschild vacuum scalar",ToComponents["Schwarzschild",RicciScalar[CD][]],0];
check["Schwarzschild KG",Simplify[ToComponents["Schwarzschild","KG"]-(6-8 Mbh/rSchw[]-mass^2 rSchw[]^2)],0];
check["Unary native CTensor",ASchw[-aSchw]//ToCTensor,CTensor[{1,2,3,4},{-chartSchw}]];
DefineChart["Schwarzschild","Quadratic",{T[],u[],th[],p[]},Function[{tt,uu,hh,pp},{tt,uu^2,hh,pp}]];
check["Nonlinear Schwarzschild KG",Simplify[ToComponents["Schwarzschild","KG",OutputChart->"Quadratic"]-(6-8 Mbh/uQuadraticSchw[]^2-mass^2 uQuadraticSchw[]^4)],0];
check["Nonlinear Schwarzschild gradient",Simplify[ToComponents["Schwarzschild",CD[-a][phi[]],OutputChart->"Quadratic"]-{0,4 uQuadraticSchw[]^3,0,0}],{0,0,0,0}];
CreateBackground["FLRW"];DefineChart["FLRW",{t[],x[],y[],z[]}];
MetricInBasis[gFLRW,-chartFLRW,DiagonalMatrix[{-1,scale[tFLRW[]]^2,scale[tFLRW[]]^2,scale[tFLRW[]]^2}]];
ComponentValue[phiFLRW[],tFLRW[]^2];
check["FLRW KG",Simplify[ToComponents["FLRW","KG"]+2+mass^2 tFLRW[]^2+6 tFLRW[] scale'[tFLRW[]]/scale[tFLRW[]]],0];
check["FLRW curvature",Simplify[ToComponents["FLRW",RicciScalar[CD][]]-6 (scale'[tFLRW[]]^2+scale[tFLRW[]] scale''[tFLRW[]])/scale[tFLRW[]]^2],0];
check["Schwarzschild remains isolated",ToComponents["Schwarzschild",phi[]],rSchw[]^2];
CreateBackground["Flat"];DefineChart["Flat",{t[],x[],y[],z[]}];
MetricInBasis[gFlat,-chartFlat,DiagonalMatrix[{-1,1,1,1}]];
AllComponentValues[AFlat[{-aFlat,-chartFlat}],{1,2,3,4}];
DefineChart["Flat","Shear",{T[],u[],v[],w[]},Function[{tt,uu,vv,ww},{tt,uu+2 vv,3 uu+vv,ww}]];
check["Nonsymmetric Jacobian covector",ToComponents["Flat",A[-a],OutputChart->"Shear"],{1,11,7,4}];
check["Nonsymmetric Jacobian vector",ToComponents["Flat",A[a],OutputChart->"Shear"],{-1,4/5,3/5,4}];
check["Nonsymmetric Jacobian metric",ToComponents["Flat",g[-a,-b],OutputChart->"Shear"],{{-1,0,0,0},{0,10,5,0},{0,5,5,0},{0,0,0,1}}];
check["Native nonsymmetric basis conversion",ToCTensor[CTensor[{1,2,3,4},{-chartFlat}],{-chartShearFlat}],CTensor[{1,11,7,4},{-chartShearFlat}]];
check["Reject direct managed basis replacement",MatchQ[SetBasisChange[CTensor[2 IdentityMatrix[4],{-chartShearFlat,chartFlat}]],Failure["ManagedBasisPair",_Association]],True];
check["Original map unchanged after rejected native edit",ToComponents["Flat",A[-a],OutputChart->"Shear"],{1,11,7,4}];
DefineChart["Flat","Quadratic",{T[],u[],v[],w[]},Function[{tt,uu,vv,ww},{tt,uu^2,vv,ww}]];
SetConnectionComponents["Flat","Affine",ConstantArray[0,{4,4,4}]];
check["Affine Hessian term",Simplify[ConnectionMatrixOf["Flat","Affine",OutputChart->"Quadratic"][[2,2,2]]-1/uQuadraticFlat[]],0];
AddRules["Schwarzschild",{Mbh->7}];SetRuleGroup["Schwarzschild","Massless",{mass->0}];SetRuleGroup["Schwarzschild","Massive",{mass->2}];
ActivateRuleGroups["Schwarzschild",{"Massive","Massless"}];
check["Independent rules retained",ShowRules["Schwarzschild"],{mass->2,mass->0,Mbh->7}];
check["Exact LHS conflict",Length[ShowRuleGroups["Schwarzschild","Status"]["Conflicts"]],1];
SaveResult["Schwarzschild","cached",1];DeactivateRuleGroups["Schwarzschild",{"Massive"}];
check["Independent rule after deactivation",ShowRules["Schwarzschild"],{mass->0,Mbh->7}];
check["Rule change invalidates result",FailureQ[ResultOf["Schwarzschild","cached"]],True];
SaveResult["Schwarzschild","cached",1];ActivateRuleGroups["Schwarzschild",{"Massless"}];
check["Repeated activation is a no-op",ResultOf["Schwarzschild","cached"],1];
recipe=ReconstructionData["Schwarzschild"];RecreateBackground["Copy",recipe];
check["Recipe retains independent and active rules",ShowRules["Copy"],{mass->0,Mbh->7}];
check["Recipe native chart aliases",rCopy[],ScalarsOfChart[chartCopy][[2]]];
check["Recipe scalar input",ToComponents["Copy",phi[]],rCopy[]^2];
check["Chart guard retained",FailureQ[UndefChart[chartQuadraticSchw]],True];
check["Delete native chart family",AssociationQ[DeleteBackgroundObject["Flat","Chart",Cascade->True]],True];
check["Chart family releases aliases",OwnValues[uShearFlat],{}];
check["Other chart survives deletion",ChartQ[chartQuadraticSchw],True];
check["Delete complete backgrounds",And@@(SameQ[DeleteBackground[#],Null]& /@ {"Flat","Copy","Schwarzschild","FLRW"}),True];
<|"Total"->Length[checks],"Passed"->Count[Lookup[Values[checks],"Passed"],True],"Failures"->Select[checks,!TrueQ[#["Passed"]]&]|>

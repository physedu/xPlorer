(* Run in a fresh kernel with xAct installed, leaving native Print unchanged. *)
If[!MemberQ[$Packages,"xPlorer`"],Get[FileNameJoin[{DirectoryName[DirectoryName[$InputFileName]],"Paclet","xPlorer.wl"}]]];
Block[{xAct`xPerm`$xpermQ=False,xAct`xTensor`$DefInfoQ=False,xAct`xCoba`$CVVerbose=False},
 Begin["ObjectLabelTests`"];
 DefManifold[M,4,{a,b,c,d,e,f,i,j}]; DefMetric[-1,g[-a,-b],CD]; DefTensor[phi[],M]; DefTensor[A[-a],M]; DefConstantSymbol[m];
 RegisterTheory["Metric",g]; RegisterTheory["CovD",CD]; RegisterTheory["Indices",{a,b,c,d,e,f,i,j}]; RegisterTheory["Fields",{phi,A}]; RegisterTheory["Parameter",m];
 snap=TheorySnapshot[]; ClearTheory[]; RegisterTheory[snap];
 checks=<||>; checks["direct snapshot"]=SameQ[TheorySnapshot[],snap];
 boxes[ex_]:=With[{ee=ex},MakeBoxes[ee,StandardForm]];
 display[ex_]:=boxes[ex]//.InterpretationBox[d_,___]:>d;
 label[ex_,s_]:=!FreeQ[display[ex],s];
 roundtrip[ex_]:=ToExpression[boxes[ex],StandardForm,HoldComplete]===With[{v=Normal[ex]},HoldComplete[v]];
 auto[ex_]:=xPlorer`Private`notebookPrint[ex];
 CreateBackground["One",SymbolSuffix->"O",BackgroundLabel->"ONE",ShowObjectLabels->True];
 CreateBackground["Two",SymbolSuffix->"T"];
 DefineChart["One",{t[],x[],y[],z[]}]; DefineChart["Two",{t[],x[],y[],z[]}];
 DefineChart["One","Scaled",{T[],u[],v[],w[]},Function[{tt,xx,yy,zz},{tt,2 xx,yy,zz}]];
 MetricInBasis[gO,-chartO,DiagonalMatrix[{-1,1,1,1}]]; ComponentValue[phiO[],xO[]^2];
 ex=CDO[-aO][phiO[]]; math=ToComponents[CDO[aO][CDO[-aO][phiO[]]]]; SaveResult["One","math",math];
 originalPrint=With[{h=BackgroundObject["One","phi"]},PrintAs[h]]; originalCD=SymbolOfCovD[CDO];
 checks["scalar"]=label[auto[phiO[]],"ONE"];
 checks["metric"]=label[auto[gO[-aO,-bO]],"ONE"];
 checks["curvature"]=label[auto[RiemannCDO[-aO,-bO,-cO,-dO]],"ONE"];
 checks["coordinate"]=label[auto[xO[]],"ONE"];
 checks["coordinate other off"]=!label[auto[xT[]],"T"];
 checks["secondary coordinate"]=label[auto[uScaledO[]],"ONE:Scaled"];
 checks["derivative prefix"]=label[PrettyExp[ex,CovariantStyle->"Prefix"],"ONE"];
 checks["derivative postfix"]=label[PrettyExp[ex,CovariantStyle->"Postfix"],"ONE"];
 checks["native derivative"]=label[PrettyExp[ex,CovariantStyle->"Native"],"ONE"];
 checks["copy"]=roundtrip[PrettyExp[ex,ShowObjectLabels->True]];
 checks["matrix"]=label[auto[MatrixForm[{{xO[],1},{0,xO[]}}]],"ONE"];
 checks["shared constant"]=!label[PrettyExp[m,ShowObjectLabels->True],"ONE"];
 checks["no external tensor"]=!label[PrettyExp[phi[],ShowObjectLabels->True],"ONE"];
 DefScalarFunction[q];
 partial=Derivative[2][q][xO[]];
 Do[checks["partial "<>style]=label[PrettyExp[partial,PartialStyle->style],"ONE"]&&roundtrip[PrettyExp[partial,PartialStyle->style]],{style,{"Native","Fraction","Comma","MultiIndex","Partial","Prime"}}];
 checks["TeX"]=StringContainsQ[ExpressionText[partial,"TeX"],"ONE"]&&StringFreeQ[ExpressionText[partial,"TeX"],"Backgrounds`"];
 checks["one view off"]=!label[PrettyExp[ex,ShowObjectLabels->False],"ONE"];
 SetPresentation["One",phi,ShowObjectLabels->False];
 checks["individual off"]=!label[auto[phiO[]],"ONE"]&&label[auto[gO[-aO,-bO]],"ONE"];
 checks["view wins"]=label[PrettyExp[phiO[],ShowObjectLabels->True],"ONE"];
 SetPresentation["One",phi,ShowObjectLabels->Automatic];
 checks["individual inherits"]=label[auto[phiO[]],"ONE"];
 SetPresentation["One",xO,ShowObjectLabels->False];
 checks["coordinate individual off"]=!label[auto[xO[]],"ONE"];
 SetXPlorerPreferences[ShowObjectLabels->True];
 checks["global existing"]=label[auto[phiT[]],"T"];
 checks["mixed owners"]=label[PrettyExp[phiO[]+phiT[]],"ONE"]&&label[PrettyExp[phiO[]+phiT[]],"T"];
 SetNotation["Two",ShowObjectLabels->False]; checks["local wins"]=!label[auto[phiT[]],"T"];
 SetNotation["Two",ShowObjectLabels->Automatic]; checks["local inherits"]=label[auto[phiT[]],"T"];
 checks["native formatting unchanged"]=SameQ[With[{h=BackgroundObject["One","phi"]},PrintAs[h]],originalPrint]&&SameQ[SymbolOfCovD[CDO],originalCD];
 checks["math unaffected"]=SameQ[ResultOf["One","math"],math]&&SameQ[ToComponents[CDO[aO][CDO[-aO][phiO[]]]],math];
 rec=ReconstructionData["One"]; DeleteBackground["One"]; RecreateBackground["One",rec];
 checks["reconstruction"]=label[auto[phiO[]],"ONE"]&&!label[auto[xO[]],"ONE"]&&label[auto[uScaledO[]],"ONE:Scaled"];
 checks["registration rejects label option"]=FailureQ[RegisterTheory["Field",phi,ShowObjectLabels->True]];
 result=<|"Version"->$XPlorerVersion,"Passed"->Count[Values[checks],True],"Total"->Length[checks],"Failures"->Keys@Select[checks,!TrueQ[#]&],"Examples"-><|"Scalar"->display[auto[phiO[]]],"Coordinate"->display[auto[uScaledO[]]],"Derivative"->display[PrettyExp[CDO[-aO][phiO[]],CovariantStyle->"Prefix"]]|>|>;
 End[]; result
]

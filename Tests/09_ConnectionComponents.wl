DefCovD[DA[-a],{},Torsion->True];RegisterTheory["Connection","Affine",DA];
CreateBackground["ConnectionValues"];DefineChart["ConnectionValues",{"t","x","y","z"}];SetCMetricSystem["ConnectionValues",DiagonalMatrix[{-1,1,1,1}]];
SetFieldComponents["ConnectionValues",A,{1,2,3,4}];
assert["independent-missing-values",FailureQ[ToComponents["ConnectionValues",DA[-a][A[-b]],StrictComponents->True]],True];
zeroGamma=ConstantArray[0,{4,4,4}];
SetConnectionComponents["ConnectionValues","Affine",zeroGamma];
assert["independent-zero-derivative",ToComponents["ConnectionValues",DA[-a][A[-b]],StrictComponents->True],ConstantArray[0,{4,4}]];
coord=Through[CoordinatesOf["ConnectionValues"][]];
gamma=zeroGamma;gamma[[1,2,1]]=coord[[1]];
SetConnectionComponents["ConnectionValues","Affine",gamma];
expected=ConstantArray[0,{4,4}];expected[[2,1]]=-coord[[1]];
assert["independent-vector-derivative",ToComponents["ConnectionValues",DA[-a][A[-b]],FreeIndices->{-a,-b},StrictComponents->True],expected];
assert["independent-nonmetric-check",CheckConnection["ConnectionValues","Affine"]["MetricCompatible"]["Status"],"Inconclusive"];
riem=ToComponents["ConnectionValues",Riemann[DA][-a,-b,-c,d],FreeIndices->{-a,-b,-c,d},StrictComponents->True];
assert["independent-curvature-component",riem[[1,2,1,1]],-$RiemannSign];
assert["independent-curvature-antisymmetry",Simplify[riem+Transpose[riem,{2,1,3,4}]],ConstantArray[0,{4,4,4,4}]];
SetConnectionComponents["ConnectionValues","Affine",zeroGamma,ReferenceConnection->"Primary"];
assert["difference-connection",ToComponents["ConnectionValues",DA[-a][A[-b]],StrictComponents->True],ConstantArray[0,{4,4}]];
SaveResult["ConnectionValues","A",ToComponents["ConnectionValues",A[a]]];SetPresentation["ConnectionValues",<|"A"->"V"|>];
assert["display-preserves-result",ResultOf["ConnectionValues","A"],{-1,2,3,4}];
SetFieldComponents["ConnectionValues",A,{2,2,3,4}];
assert["field-change-invalidates",FailureQ[ResultOf["ConnectionValues","A"]],True];
DeleteBackground["ConnectionValues"];UnregisterTheory["Connections"];UndefCovD[DA];
DefCovD[DF[-a],{},Torsion->False,Curvature->False];RegisterTheory["Connection","Flat",DF];
CreateBackground["FlatValues"];DefineChart["FlatValues",{"t","x","y","z"}];SetCMetricSystem["FlatValues",DiagonalMatrix[{-1,1,1,1}]];
xx=Through[CoordinatesOf["FlatValues"][]];bad=ConstantArray[0,{4,4,4}];bad[[1,2,1]]=xx[[1]];
assert["torsion-declaration-protected",FailureQ[SetConnectionComponents["FlatValues","Flat",bad]],True];
bad[[1,1,2]]=xx[[1]];
assert["flat-declaration-protected",FailureQ[SetConnectionComponents["FlatValues","Flat",bad]],True];
DeleteBackground["FlatValues"];UnregisterTheory["Connections"];UndefCovD[DF];
DefCovD[DG[-a],{},Torsion->True];RegisterTheory["Connection","General",DG];
CreateBackground["CurvedDifference"];DefineChart["CurvedDifference",{"t","x","y","z"}];
SetCMetricSystem["CurvedDifference",Function[{tt,xx,yy,zz},DiagonalMatrix[{-1,Exp[2 tt],Exp[2 tt],Exp[2 tt]}]]];
SetFieldComponents["CurvedDifference",A,{1,2,3,4}];SetConnectionComponents["CurvedDifference","General",ConstantArray[0,{4,4,4}],ReferenceConnection->"Primary"];
assert["curved-connection-difference",Simplify[ToComponents["CurvedDifference",DG[-a][A[-b]]]-ToComponents["CurvedDifference",CD[-a][A[-b]]]],ConstantArray[0,{4,4}]];
SaveResult["CurvedDifference","old",1];SetCMetricSystem["CurvedDifference",DiagonalMatrix[{-1,1,1,1}]];
assert["metric-invalidates-saved-result",FailureQ[ResultOf["CurvedDifference","old"]],True];
assert["difference-replayed-after-metric",ToComponents["CurvedDifference",DG[-a][A[-b]],StrictComponents->True],ConstantArray[0,{4,4}]];
DeleteBackground["CurvedDifference"];UnregisterTheory["Connections"];UndefCovD[DG];
